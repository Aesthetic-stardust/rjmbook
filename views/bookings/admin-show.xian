{{> head }}
<body class="font-body">
<div class="flex h-screen overflow-hidden" style="background:#f1f5f9;">

  <!-- ── Sidebar ── -->
  <aside id="admin-sidebar"
         class="flex-shrink-0 w-64 flex flex-col fixed md:relative top-0 left-0 h-screen z-40 transition-transform duration-300"
         style="background: linear-gradient(180deg,#0f172a 0%,#134e4a 100%); box-shadow: 4px 0 24px rgba(0,0,0,.18);">
    <div class="px-6 py-6 border-b" style="border-color: rgba(255,255,255,.08);">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0"
             style="background: linear-gradient(135deg,#0d9488,#0891b2);">
        </div>
        <div>
          <h1 class="text-lg font-bold text-white font-display leading-none">RJMBook</h1>
          <p class="text-xs mt-0.5" style="color: rgba(255,255,255,.4);">RJM Beach Resort</p>
        </div>
      </div>
    </div>
    <nav class="flex-1 px-3 py-5 space-y-0.5 overflow-y-auto">
      <p class="text-xs font-semibold uppercase tracking-widest px-3 mb-3" style="color: rgba(255,255,255,.3);">Management</p>
      <a href="/admin"              class="sidebar-link"><i class="fa-solid fa-gauge w-4 text-center flex-shrink-0"></i><span>Dashboard</span></a>
      <a href="/admin/reservations" class="sidebar-link active"><i class="fa-solid fa-calendar-days w-4 text-center flex-shrink-0"></i><span>Reservations</span></a>
      <a href="/admin/book"         class="sidebar-link"><i class="fa-solid fa-calendar-plus w-4 text-center flex-shrink-0"></i><span>Walk-in Booking</span></a>
      <a href="/admin/reservation-calendar" class="sidebar-link"><i class="fa-solid fa-calendar w-4 text-center flex-shrink-0"></i><span>Reservation Calendar</span></a>
      <a href="/admin/room-availability" class="sidebar-link"><i class="fa-solid fa-door-open w-4 text-center flex-shrink-0"></i><span>Room Availability</span></a>
      <a href="/admin/rooms"        class="sidebar-link"><i class="fa-solid fa-bed w-4 text-center flex-shrink-0"></i><span>Rooms</span></a>
      <a href="/admin/cottages"     class="sidebar-link"><i class="fa-solid fa-umbrella-beach w-4 text-center flex-shrink-0"></i><span>Cottages</span></a>
      <a href="/guests"             class="sidebar-link"><i class="fa-solid fa-users w-4 text-center flex-shrink-0"></i><span>Guests</span></a>
      <div class="my-3 border-t" style="border-color: rgba(255,255,255,.07);"></div>
      <p class="text-xs font-semibold uppercase tracking-widest px-3 mb-3" style="color: rgba(255,255,255,.3);">Analytics</p>
      <a href="/dashboard"                class="sidebar-link"><i class="fa-solid fa-chart-pie w-4 text-center flex-shrink-0"></i><span>Analytics</span></a>
      <a href="/admin/reports"            class="sidebar-link"><i class="fa-solid fa-file-chart-column w-4 text-center flex-shrink-0"></i><span>Reports</span></a>
      <a href="/admin/sentiment-analysis" class="sidebar-link"><i class="fa-solid fa-brain w-4 text-center flex-shrink-0"></i><span>Sentiment Analysis</span></a>
      <div class="my-3 border-t" style="border-color: rgba(255,255,255,.07);"></div>
      <p class="text-xs font-semibold uppercase tracking-widest px-3 mb-3" style="color: rgba(255,255,255,.3);">Account</p>
      <a href="/admin/payment-settings" class="sidebar-link"><i class="fa-solid fa-peso-sign w-4 text-center flex-shrink-0"></i><span>Payment Settings</span></a>
      <a href="/admin/staff"        class="sidebar-link"><i class="fa-solid fa-user-tie w-4 text-center flex-shrink-0"></i><span>Manage Staff</span></a>
      <a href="/account" class="sidebar-link"><i class="fa-solid fa-user-gear w-4 text-center flex-shrink-0"></i><span>Account Settings</span></a>
    </nav>
    <div class="px-3 py-4 border-t" style="border-color: rgba(255,255,255,.08);">
      <div class="flex items-center gap-3 px-3 py-3 rounded-xl mb-3" style="background: rgba(255,255,255,.06);">
        <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold text-white flex-shrink-0"
             style="background: linear-gradient(135deg,#0d9488,#0891b2);">
          {{#if sessionUserName}}{{sessionUserName.[0]}}{{else}}A{{/if}}
        </div>
        <div class="min-w-0">
          <p class="text-xs text-white font-semibold truncate">{{sessionUserName}}</p>
          <p class="text-xs" style="color: rgba(255,255,255,.4);">Administrator</p>
        </div>
      </div>
      <button id="adminLogoutBtn"
              class="w-full flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl text-sm font-semibold text-white transition-all cursor-pointer border-none"
              style="background: rgba(220,38,38,.2); border: 1px solid rgba(220,38,38,.3);"
>
        <i class="fa-solid fa-right-from-bracket text-red-400"></i>
        <span class="text-red-300">Sign Out</span>
      </button>
    </div>
  </aside>

  <!-- ── Main ── -->
  <main class="flex-1 flex flex-col overflow-hidden">

    <!-- Top bar -->
    <header class="flex-shrink-0 flex items-center justify-between px-6 py-4 bg-white border-b border-gray-200"
            style="box-shadow: 0 1px 8px rgba(0,0,0,.06);">
      <div class="flex items-center gap-4">
        <button id="sidebar-toggle" class="md:hidden p-2 rounded-lg text-gray-500 hover:bg-gray-100 transition-colors">
          <i class="fa-solid fa-bars"></i>
        </button>
        <div>
          <h2 class="text-xl font-bold text-gray-800">Booking #{{booking.id}}</h2>
          <p class="text-xs text-gray-500 mt-0.5">Reservation details and information</p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <a href="/admin/reservations"
           class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-sm font-semibold text-teal-700 bg-teal-50 hover:bg-teal-100 transition-colors">
          <i class="fa-solid fa-arrow-left text-xs"></i> Back to Reservations
        </a>
        <div class="w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold text-white"
             style="background: linear-gradient(135deg,#0d9488,#0891b2);">
          {{#if sessionUserName}}{{sessionUserName.[0]}}{{else}}A{{/if}}
        </div>
      </div>
    </header>

    <!-- Content -->
    <div class="flex-1 overflow-auto p-6" style="background:#f8fafc;">
      <div class="max-w-4xl mx-auto">

        <!-- Mobile back link -->
        <a href="/admin/reservations"
           class="sm:hidden inline-flex items-center gap-2 text-teal-700 font-semibold text-sm mb-5 hover:text-teal-900 transition-colors">
          <i class="fa-solid fa-arrow-left text-xs"></i> Back to Reservations
        </a>

        <!-- Status banner -->
        <div class="card p-5 mb-5 flex items-center justify-between animate-fade-in-up">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center flex-shrink-0"
                 style="background: linear-gradient(135deg,#0d9488,#0891b2);">
              <i class="fa-solid fa-calendar-check text-white text-lg"></i>
            </div>
            <div>
              <p class="text-xs text-gray-500 font-medium uppercase tracking-wider">Booking Reference</p>
              <p class="text-2xl font-bold text-gray-800 font-display">#{{booking.id}}</p>
            </div>
          </div>
          <span class="badge text-sm px-4 py-2
            {{#if (eq booking.status 'pending')}}badge-warning
            {{else if (eq booking.status 'confirmed')}}badge-success
            {{else if (eq booking.status 'checked_in')}}badge-info
            {{else if (eq booking.status 'checked_out')}}badge-neutral
            {{else if (eq booking.status 'cancelled')}}badge-danger
            {{else}}badge-neutral{{/if}}">
            <i class="fa-solid
              {{#if (eq booking.status 'pending')}}fa-clock
              {{else if (eq booking.status 'confirmed')}}fa-circle-check
              {{else if (eq booking.status 'checked_in')}}fa-door-open
              {{else if (eq booking.status 'checked_out')}}fa-door-closed
              {{else if (eq booking.status 'cancelled')}}fa-circle-xmark
              {{else}}fa-circle{{/if}} mr-1.5"></i>
            {{booking.status}}
          </span>
        </div>

        <!-- Main grid -->
        <div class="grid md:grid-cols-2 gap-5">

          <!-- Booking Details -->
          <div class="card p-6 animate-fade-in-up">
            <h3 class="text-sm font-bold text-gray-500 uppercase tracking-widest mb-4 flex items-center gap-2">
              <i class="fa-solid fa-clipboard-list text-teal-500"></i> Booking Details
            </h3>
            <div class="space-y-4">

              <div class="flex items-start justify-between py-3 border-b border-gray-50">
                <div class="flex items-center gap-2 text-gray-500 text-sm">
                  <i class="fa-regular fa-calendar-check text-teal-500 w-4 text-center"></i> Check-in
                </div>
                <p class="font-semibold text-gray-800 text-sm">{{booking.checkIn}}</p>
              </div>

              <div class="flex items-start justify-between py-3 border-b border-gray-50">
                <div class="flex items-center gap-2 text-gray-500 text-sm">
                  <i class="fa-regular fa-calendar-xmark text-teal-500 w-4 text-center"></i> Check-out
                </div>
                <p class="font-semibold text-gray-800 text-sm">{{booking.checkOut}}</p>
              </div>

              <div class="flex items-start justify-between py-3 border-b border-gray-50">
                <div class="flex items-center gap-2 text-gray-500 text-sm">
                  <i class="fa-solid fa-users text-teal-500 w-4 text-center"></i> Guests
                </div>
                <p class="font-semibold text-gray-800 text-sm">
                  {{booking.adults}} Adult(s){{#if booking.children}}, {{booking.children}} Child(ren){{/if}}
                </p>
              </div>

              <div class="flex items-start justify-between py-3 border-b border-gray-50">
                <div class="flex items-center gap-2 text-gray-500 text-sm">
                  <i class="fa-solid fa-peso-sign text-teal-500 w-4 text-center"></i> Total Amount
                </div>
                <p class="text-xl font-bold text-teal-700">₱{{booking.totalAmount}}</p>
              </div>

              <!-- Payment status row -->
              <div class="flex items-start justify-between py-3 border-b border-gray-50">
                <div class="flex items-center gap-2 text-gray-500 text-sm">
                  <i class="fa-solid fa-credit-card text-teal-500 w-4 text-center"></i> Payment Status
                </div>
                <span class="text-sm font-bold
                  {{#if (eq booking.paymentStatus 'paid')}}text-green-600
                  {{else if (eq booking.paymentStatus 'failed')}}text-red-600
                  {{else if (eq booking.paymentStatus 'refunded')}}text-purple-600
                  {{else}}text-amber-600{{/if}}">
                  <i class="fa-solid
                    {{#if (eq booking.paymentStatus 'paid')}}fa-circle-check
                    {{else if (eq booking.paymentStatus 'failed')}}fa-circle-xmark
                    {{else if (eq booking.paymentStatus 'refunded')}}fa-rotate-left
                    {{else}}fa-clock{{/if}} mr-1"></i>
                  {{booking.paymentStatus}}
                </span>
              </div>

              {{#if (gt booking.downPaymentPercent -1)}}
              {{! downPaymentPercent is set (0, 50, or 100) }}
              <!-- Down payment breakdown -->
              <div class="flex items-start justify-between py-3 border-b border-gray-50">
                <div class="flex items-center gap-2 text-gray-500 text-sm">
                  <i class="fa-solid fa-percent text-amber-500 w-4 text-center"></i> Down Payment
                </div>
                <span class="text-sm font-semibold text-amber-700">{{booking.downPaymentPercent}}% — ₱{{booking.downPaymentAmount}}</span>
              </div>
              <div class="flex items-start justify-between py-3">
                <div class="flex items-center gap-2 text-gray-500 text-sm">
                  <i class="fa-solid fa-scale-balanced text-gray-400 w-4 text-center"></i> Balance Due
                </div>
                <span class="text-sm font-bold {{#if (eq booking.downPaymentPercent 100)}}text-green-600{{else}}text-red-600{{/if}}">
                  {{#if (eq booking.downPaymentPercent 100)}}Fully paid{{else if (eq booking.downPaymentPercent 0)}}Full balance due at check-in{{else}}₱{{booking.balanceDue}}{{/if}}
                </span>
              </div>
              {{else}}
              <div class="flex items-start justify-between py-3">
                <div class="flex items-center gap-2 text-gray-500 text-sm">
                  <i class="fa-solid fa-percent text-gray-400 w-4 text-center"></i> Down Payment
                </div>
                <span class="text-xs text-gray-400 italic">Not set</span>
              </div>
              {{/if}}

              {{#if booking.cancellationReason}}
              <div class="mt-2 p-4 rounded-xl" style="background:#fef2f2; border-left: 3px solid #ef4444;">
                <p class="text-xs font-bold text-red-600 uppercase tracking-wider mb-1">
                  <i class="fa-solid fa-circle-xmark mr-1"></i> Cancellation Reason
                </p>
                <p class="text-sm text-red-800">{{booking.cancellationReason}}</p>
              </div>
              {{/if}}
            </div>
          </div>

          <!-- Room + Guest -->
          <div class="space-y-5">

            {{#if booking.Room}}
            <div class="card p-6 animate-fade-in-up">
              <h3 class="text-sm font-bold text-gray-500 uppercase tracking-widest mb-4 flex items-center gap-2">
                <i class="fa-solid fa-bed text-teal-500"></i> Room / Cottage
              </h3>
              <div class="space-y-3">
                <div class="flex justify-between items-center py-2 border-b border-gray-50">
                  <span class="text-sm text-gray-500">Number</span>
                  <span class="font-bold text-gray-800">{{booking.Room.roomNumber}}</span>
                </div>
                <div class="flex justify-between items-center py-2">
                  <span class="text-sm text-gray-500">Type</span>
                  <span class="badge badge-teal text-xs">{{booking.Room.RoomType.name}}</span>
                </div>
              </div>
            </div>
            {{/if}}

            {{#if booking.roomNotes}}
            <div class="card p-6 animate-fade-in-up" style="border-left: 3px solid #3b82f6;">
              <h3 class="text-sm font-bold text-blue-600 uppercase tracking-widest mb-3 flex items-center gap-2">
                <i class="fa-solid fa-circle-info"></i> Room Notes
              </h3>
              <p class="text-sm text-gray-700 leading-relaxed whitespace-pre-line">{{booking.roomNotes}}</p>
            </div>
            {{/if}}

            {{#if booking.Guest}}
            <div class="card p-6 animate-fade-in-up">
              <h3 class="text-sm font-bold text-gray-500 uppercase tracking-widest mb-4 flex items-center gap-2">
                <i class="fa-solid fa-user text-teal-500"></i> Guest Information
              </h3>
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold text-white flex-shrink-0"
                     style="background: linear-gradient(135deg,#0d9488,#0891b2);">
                  {{booking.Guest.firstName.[0]}}
                </div>
                <div>
                  <p class="font-bold text-gray-800">{{booking.Guest.firstName}} {{booking.Guest.lastName}}</p>
                  <p class="text-xs text-gray-400">Guest #{{booking.Guest.id}}</p>
                </div>
              </div>
              <div class="space-y-2">
                <div class="flex items-center gap-2 text-sm text-gray-600">
                  <i class="fa-solid fa-envelope text-teal-400 w-4 text-center"></i>
                  {{booking.Guest.email}}
                </div>
                {{#if booking.Guest.phone}}
                <div class="flex items-center gap-2 text-sm text-gray-600">
                  <i class="fa-solid fa-phone text-teal-400 w-4 text-center"></i>
                  {{booking.Guest.phone}}
                </div>
                {{/if}}
              </div>
            </div>
            {{/if}}

          </div>
        </div>

        <!-- Special Requests -->
        {{#if booking.specialRequests}}
        <div class="card p-6 mt-5 animate-fade-in-up">
          <h3 class="text-sm font-bold text-gray-500 uppercase tracking-widest mb-3 flex items-center gap-2">
            <i class="fa-solid fa-note-sticky text-amber-500"></i> Special Requests
          </h3>
          <p class="text-sm text-gray-700 leading-relaxed">{{booking.specialRequests}}</p>
        </div>
        {{/if}}

      </div>
    </div>
  </main>
</div>

<script>
(function () {
  const toggle  = document.getElementById('sidebar-toggle');
  const sidebar = document.getElementById('admin-sidebar');
  if (toggle && sidebar) {
    toggle.addEventListener('click', () => sidebar.classList.toggle('-translate-x-full'));
    document.addEventListener('click', (e) => {
      if (window.innerWidth < 768 && !sidebar.contains(e.target) && !toggle.contains(e.target))
        sidebar.classList.add('-translate-x-full');
    });
  }
  // confirmAdminLogout is defined in footer.xian
})();
</script>
</body>
