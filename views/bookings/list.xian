{{> head }}
<body class="bg-gray-100 min-h-screen font-body">
  <div class="flex h-screen">
    <!-- Sidebar -->
    <aside class="w-64 bg-white shadow-lg flex flex-col">
      <!-- Logo / Brand -->
      <div class="px-6 py-8 border-b border-gray-200">
        <h1 class="text-2xl font-bold text-teal-700">RJMBook</h1>
        <p class="text-xs text-gray-500 mt-1">Booking System</p>
      </div>

      <!-- Navigation Menu -->
      <nav class="flex-1 px-4 py-8 space-y-2 overflow-y-auto">
        <a href="/" class="flex items-center gap-3 px-4 py-3 text-gray-700 hover:bg-teal-50 hover:text-teal-700 rounded-lg transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-3m0 0l7-4 7 4M5 9v10a1 1 0 001 1h12a1 1 0 001-1V9m-9 11l4-2m-9-2l4 2m0-5l7-4m-7 4L5 7m12 0l4-2" />
          </svg>
          <span class="font-medium">Home</span>
        </a>

        <a href="/bookings" class="flex items-center gap-3 px-4 py-3 text-white bg-teal-700 rounded-lg transition-colors font-medium">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>My Bookings</span>
        </a>

        <a href="/rooms" class="flex items-center gap-3 px-4 py-3 text-gray-700 hover:bg-teal-50 hover:text-teal-700 rounded-lg transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v1h1a1 1 0 011 1v2H4V7a1 1 0 011-1h1V5zm0 4h14v8a2 2 0 01-2 2H7a2 2 0 01-2-2V9zm2 2a1 1 0 100 2 1 1 0 000-2zm3 0a1 1 0 100 2 1 1 0 000-2zm7 0a1 1 0 100 2 1 1 0 000-2z" />
          </svg>
          <span class="font-medium">Rooms</span>
        </a>

        <a href="/cottages" class="flex items-center gap-3 px-4 py-3 text-gray-700 hover:bg-teal-50 hover:text-teal-700 rounded-lg transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-3m0 0l7-4 7 4M5 9v10a1 1 0 001 1h12a1 1 0 001-1V9m-9 11l4-2m-9-2l4 2m0-5l7-4m-7 4L5 7m12 0l4-2" />
          </svg>
          <span class="font-medium">Cottages</span>
        </a>

        <a href="/guests" class="flex items-center gap-3 px-4 py-3 text-gray-700 hover:bg-teal-50 hover:text-teal-700 rounded-lg transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 8.048M7 14H5a2 2 0 00-2 2v4h16v-4a2 2 0 00-2-2h-2m-4-6a4 4 0 110-8m0 8H9m0-8a4 4 0 00-4 4v4h8v-4a4 4 0 00-4-4z" />
          </svg>
          <span class="font-medium">Guests</span>
        </a>

        <a href="/dashboard" class="flex items-center gap-3 px-4 py-3 text-gray-700 hover:bg-teal-50 hover:text-teal-700 rounded-lg transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8L6.41 20.41M19 19H5a2 2 0 01-2-2V5a2 2 0 012-2h14a2 2 0 012 2v14a2 2 0 01-2 2z" />
          </svg>
          <span class="font-medium">Analytics</span>
        </a>
      </nav>

      <!-- Divider -->
      <div class="border-t border-gray-200"></div>

      <!-- User Info -->
      <div class="px-4 py-4">
        <div class="bg-gradient-to-br from-teal-50 to-blue-50 rounded-lg p-4 mb-4">
          <p class="text-xs text-gray-600 mb-1">Welcome</p>
          <p class="text-sm font-semibold text-gray-800">Guest User</p>
        </div>
        <a href="/auth/logout" class="flex items-center justify-center gap-2 w-full px-4 py-2 text-sm font-medium text-white bg-red-600 hover:bg-red-700 rounded-lg transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          Logout
        </a>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 overflow-auto flex flex-col">
      <!-- Top Bar -->
      <div class="bg-white border-b border-gray-200 px-8 py-6 shadow-sm">
        <h2 class="text-3xl font-bold text-gray-800">Reservations</h2>
        <p class="text-gray-600 mt-2">Manage and view all your bookings</p>
      </div>

      <!-- Page Content -->
      <div class="flex-1 overflow-auto p-8 bg-gray-50">
        <div class="bg-white rounded-xl shadow-md border border-gray-100 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left">
              <thead class="bg-gray-50 border-b border-gray-200">
              <tr>
                <th class="px-6 py-4 font-semibold text-gray-700 text-sm">ID</th>
                <th class="px-6 py-4 font-semibold text-gray-700 text-sm">Check-in</th>
                <th class="px-6 py-4 font-semibold text-gray-700 text-sm">Check-out</th>
                <th class="px-6 py-4 font-semibold text-gray-700 text-sm">Room</th>
                <th class="px-6 py-4 font-semibold text-gray-700 text-sm">Guest</th>
                <th class="px-6 py-4 font-semibold text-gray-700 text-sm">Status</th>
                <th class="px-6 py-4 font-semibold text-gray-700 text-sm text-center">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              {{#each bookings}}
              <tr class="hover:bg-teal-50/50 transition-colors duration-200">
                <td class="px-6 py-4 text-sm font-medium text-gray-900">#{{this.id}}</td>
                <td class="px-6 py-4 text-sm text-gray-600">{{this.checkIn}}</td>
                <td class="px-6 py-4 text-sm text-gray-600">{{this.checkOut}}</td>
                <td class="px-6 py-4 text-sm">
                  {{#if this.Room}}
                  <span class="font-medium text-gray-900">{{this.Room.roomNumber}}</span>
                  <span class="text-gray-500">({{this.Room.RoomType.name}})</span>
                  {{else}}
                  <span class="text-gray-400">—</span>
                  {{/if}}
                </td>
                <td class="px-6 py-4 text-sm">
                  {{#if this.Guest}}
                  <span class="font-medium text-gray-900">{{this.Guest.firstName}} {{this.Guest.lastName}}</span>
                  {{else}}
                  <span class="text-gray-400">—</span>
                  {{/if}}
                </td>
                <td class="px-6 py-4 text-sm">
                  {{#if this.status}}
                  <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold
                    {{#if (eq this.status 'pending')}}bg-amber-100 text-amber-800{{/if}}
                    {{#if (eq this.status 'confirmed')}}bg-green-100 text-green-800{{/if}}
                    {{#if (eq this.status 'cancelled')}}bg-red-100 text-red-800{{/if}}
                    {{#if (eq this.status 'completed')}}bg-blue-100 text-blue-800{{/if}}
                  ">
                    {{this.status}}
                  </span>
                  {{/if}}
                </td>
                <td class="px-6 py-4 text-sm text-center">
                  <a href="/bookings/{{this.id}}" class="inline-block px-3 py-2 text-teal-700 font-semibold hover:text-teal-900 hover:bg-teal-50 rounded-lg transition-colors">
                    View →
                  </a>
                </td>
              </tr>
              {{else}}
              <tr>
                <td colspan="7" class="px-6 py-12 text-center text-gray-500">
                  <p class="text-lg">No reservations yet.</p>
                  <a href="/bookings/book" class="text-teal-600 font-semibold hover:text-teal-700 mt-2 inline-block">Create your first booking →</a>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
          </div>
        </div>
      </div>
    </main>
  </div>

  {{> footer }}
</body>
