{{> head }}
<body class="font-body">
<div class="flex h-screen overflow-hidden" style="background:#f1f5f9;">

  <!-- ── Sidebar ── -->
  <aside id="admin-sidebar"
         class="flex-shrink-0 w-64 flex flex-col fixed md:relative top-0 left-0 h-screen z-40 transition-transform duration-300"
         style="background: linear-gradient(180deg,#0f172a 0%,#134e4a 100%); box-shadow: 4px 0 24px rgba(0,0,0,.18);">
    <div class="px-6 py-6 border-b" style="border-color: rgba(255,255,255,.08);">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0"
             style="background: linear-gradient(135deg,#0d9488,#0891b2);">
        </div>
        <div>
          <h1 class="text-lg font-bold text-white font-display leading-none">RJMBook</h1>
          <p class="text-xs mt-0.5" style="color: rgba(255,255,255,.4);">Admin Panel</p>
        </div>
      </div>
    </div>
    <nav class="flex-1 px-3 py-5 space-y-0.5 overflow-y-auto">
      <p class="text-xs font-semibold uppercase tracking-widest px-3 mb-3" style="color: rgba(255,255,255,.3);">Management</p>
      <a href="/admin"              class="sidebar-link active"><i class="fa-solid fa-gauge w-4 text-center flex-shrink-0"></i><span>Dashboard</span></a>
      <a href="/admin/reservations" class="sidebar-link"><i class="fa-solid fa-calendar-days w-4 text-center flex-shrink-0"></i><span>Reservations</span></a>
      <a href="/admin/book"         class="sidebar-link"><i class="fa-solid fa-calendar-plus w-4 text-center flex-shrink-0"></i><span>Walk-in Booking</span></a>
      <a href="/admin/reservation-calendar" class="sidebar-link"><i class="fa-solid fa-calendar w-4 text-center flex-shrink-0"></i><span>Reservation Calendar</span></a>
      <a href="/admin/room-availability" class="sidebar-link"><i class="fa-solid fa-door-open w-4 text-center flex-shrink-0"></i><span>Room Availability</span></a>
      <a href="/admin/rooms"        class="sidebar-link"><i class="fa-solid fa-bed w-4 text-center flex-shrink-0"></i><span>Rooms</span></a>
      <a href="/admin/cottages"     class="sidebar-link"><i class="fa-solid fa-umbrella-beach w-4 text-center flex-shrink-0"></i><span>Cottages</span></a>
      <a href="/guests"             class="sidebar-link"><i class="fa-solid fa-users w-4 text-center flex-shrink-0"></i><span>Guests</span></a>
      <div class="my-3 border-t" style="border-color: rgba(255,255,255,.07);"></div>
      <p class="text-xs font-semibold uppercase tracking-widest px-3 mb-3" style="color: rgba(255,255,255,.3);">Analytics</p>
      <a href="/dashboard"                class="sidebar-link"><i class="fa-solid fa-chart-pie w-4 text-center flex-shrink-0"></i><span>Analytics</span></a>
      <a href="/admin/reports"            class="sidebar-link"><i class="fa-solid fa-file-chart-column w-4 text-center flex-shrink-0"></i><span>Reports</span></a>
      <a href="/admin/sentiment-analysis" class="sidebar-link"><i class="fa-solid fa-brain w-4 text-center flex-shrink-0"></i><span>Sentiment Analysis</span></a>
      <div class="my-3 border-t" style="border-color: rgba(255,255,255,.07);"></div>
      <p class="text-xs font-semibold uppercase tracking-widest px-3 mb-3" style="color: rgba(255,255,255,.3);">Account</p>
      <a href="/admin/payment-settings" class="sidebar-link"><i class="fa-solid fa-peso-sign w-4 text-center flex-shrink-0"></i><span>Payment Settings</span></a>
      <a href="/admin/payment-settings" class="sidebar-link"><i class="fa-solid fa-peso-sign w-4 text-center flex-shrink-0"></i><span>Payment Settings</span></a>
      <a href="/admin/staff"        class="sidebar-link"><i class="fa-solid fa-user-tie w-4 text-center flex-shrink-0"></i><span>Manage Staff</span></a>
      <a href="/account" class="sidebar-link"><i class="fa-solid fa-user-gear w-4 text-center flex-shrink-0"></i><span>Account Settings</span></a>
      <div class="my-3 border-t" style="border-color: rgba(255,255,255,.07);"></div>
      <p class="text-xs font-semibold uppercase tracking-widest px-3 mb-3" style="color: rgba(255,255,255,.3);">Security</p>
      <a href="/admin/audit-logs"   class="sidebar-link"><i class="fa-solid fa-scroll w-4 text-center flex-shrink-0"></i><span>Audit Logs</span></a>
      <a href="/admin/session-logs" class="sidebar-link"><i class="fa-solid fa-clock-rotate-left w-4 text-center flex-shrink-0"></i><span>Session Logs</span></a>
    </nav>
    <div class="px-3 py-4 border-t" style="border-color: rgba(255,255,255,.08);">
      <div class="flex items-center gap-3 px-3 py-3 rounded-xl mb-3" style="background: rgba(255,255,255,.06);">
        <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold text-white flex-shrink-0"
             style="background: linear-gradient(135deg,#0d9488,#0891b2);">
          {{#if sessionUserName}}{{sessionUserName.[0]}}{{else}}A{{/if}}
        </div>
        <div class="min-w-0">
          <p class="text-xs text-white font-semibold truncate">{{sessionUserName}}</p>
          <p class="text-xs" style="color: rgba(255,255,255,.4);">Administrator</p>
        </div>
      </div>
      <button id="adminLogoutBtn"
              class="w-full flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl text-sm font-semibold text-white transition-all cursor-pointer border-none"
              style="background: rgba(220,38,38,.2); border: 1px solid rgba(220,38,38,.3);"
>
        <i class="fa-solid fa-right-from-bracket text-red-400"></i>
        <span class="text-red-300">Sign Out</span>
      </button>
    </div>
  </aside>

  <!-- ── Main ── -->
  <main class="flex-1 flex flex-col overflow-hidden">

    <!-- Top bar -->
    <header class="flex-shrink-0 flex items-center justify-between px-6 py-4 bg-white border-b border-gray-200"
            style="box-shadow: 0 1px 8px rgba(0,0,0,.06);">
      <div class="flex items-center gap-4">
        <button id="sidebar-toggle" class="md:hidden p-2 rounded-lg text-gray-500 hover:bg-gray-100 transition-colors">
          <i class="fa-solid fa-bars"></i>
        </button>
        <div>
          <h2 class="text-xl font-bold text-gray-800">Admin Dashboard</h2>
          <p class="text-xs text-gray-500 mt-0.5">
            <i class="fa-regular fa-calendar text-teal-500 mr-1"></i>{{today}}
          </p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <a href="/admin/reservations"
           class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-sm font-semibold text-white transition-all"
           style="background: linear-gradient(135deg,#0d9488,#0891b2); box-shadow: 0 4px 12px rgba(13,148,136,.3);">
          <i class="fa-solid fa-calendar-days text-xs"></i> Reservations
        </a>
        <div class="hidden sm:block text-right">
          <p class="text-xs text-gray-500">Welcome back,</p>
          <p class="text-sm font-semibold text-gray-800">{{sessionUserName}}</p>
        </div>
        <div class="w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold text-white"
             style="background: linear-gradient(135deg,#0d9488,#0891b2);">
          {{#if sessionUserName}}{{sessionUserName.[0]}}{{else}}A{{/if}}
        </div>
      </div>
    </header>

    <!-- Content -->
    <div class="flex-1 overflow-auto p-6" style="background:#f8fafc;">

      <!-- ── Row 1: Core KPIs ── -->
      <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-5 stagger">

        <!-- Occupancy Rate — most important metric -->
        <div class="lg:col-span-1 stat-card animate-fade-in-up" style="border-top-color:#0d9488;">
          <div class="flex items-start justify-between mb-3">
            <div class="icon-box bg-teal-100">
              <i class="fa-solid fa-chart-pie text-teal-600"></i>
            </div>
            <span class="badge badge-teal text-xs">Today</span>
          </div>
          <p class="text-3xl font-bold text-gray-800 mb-1">{{occupancyRate}}<span class="text-base text-gray-400 font-normal">%</span></p>
          <p class="text-sm text-gray-500 font-medium">Occupancy Rate</p>
        </div>

        <!-- Currently Checked In -->
        <div class="stat-card animate-fade-in-up" style="border-top-color:#3b82f6;">
          <div class="flex items-start justify-between mb-3">
            <div class="icon-box bg-blue-100">
              <i class="fa-solid fa-door-open text-blue-600"></i>
            </div>
            <span class="badge badge-info text-xs">Live</span>
          </div>
          <p class="text-3xl font-bold text-gray-800 mb-1">{{checkedInCount}}</p>
          <p class="text-sm text-gray-500 font-medium">Checked In</p>
        </div>

        <!-- Pending Approvals — needs action -->
        <div class="stat-card animate-fade-in-up" style="border-top-color:#f59e0b;">
          <div class="flex items-start justify-between mb-3">
            <div class="icon-box bg-amber-100">
              <i class="fa-solid fa-clock text-amber-600"></i>
            </div>
            <span class="badge badge-warning text-xs">Action</span>
          </div>
          <p class="text-3xl font-bold text-gray-800 mb-1">{{pendingBookings}}</p>
          <p class="text-sm text-gray-500 font-medium">Pending Approvals</p>
        </div>

        <!-- Total Rooms -->
        <div class="stat-card animate-fade-in-up" style="border-top-color:#8b5cf6;">
          <div class="flex items-start justify-between mb-3">
            <div class="icon-box bg-purple-100">
              <i class="fa-solid fa-bed text-purple-600"></i>
            </div>
            <span class="badge badge-neutral text-xs">Total</span>
          </div>
          <p class="text-3xl font-bold text-gray-800 mb-1">{{totalRooms}}</p>
          <p class="text-sm text-gray-500 font-medium">Total Rooms</p>
        </div>

        <!-- Registered Guests -->
        <div class="stat-card animate-fade-in-up" style="border-top-color:#10b981;">
          <div class="flex items-start justify-between mb-3">
            <div class="icon-box bg-green-100">
              <i class="fa-solid fa-users text-green-600"></i>
            </div>
            <span class="badge badge-success text-xs">All Time</span>
          </div>
          <p class="text-3xl font-bold text-gray-800 mb-1">{{totalGuests}}</p>
          <p class="text-sm text-gray-500 font-medium">Registered Guests</p>
        </div>
      </div>

      <!-- ── Row 2: Today's Arrivals & Departures ── -->
      <div class="grid lg:grid-cols-2 gap-5 mb-5">

        <!-- Today's Arrivals -->
        <div class="card overflow-hidden animate-fade-in-up">
          <div class="px-5 py-4 flex items-center justify-between border-b border-gray-100"
               style="background: linear-gradient(135deg,#f0fdf4,#dcfce7);">
            <div class="flex items-center gap-2">
              <i class="fa-solid fa-arrow-right-to-bracket text-green-600"></i>
              <h3 class="font-bold text-gray-800 text-sm">Today's Arrivals</h3>
            </div>
            <span class="badge badge-success text-xs">{{todayArrivals.length}} guest(s)</span>
          </div>
          <div class="divide-y divide-gray-50 max-h-56 overflow-y-auto">
            {{#each todayArrivals}}
            <div class="px-5 py-3 flex items-center justify-between hover:bg-gray-50 transition-colors">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold text-white flex-shrink-0"
                     style="background: linear-gradient(135deg,#0d9488,#0891b2);">
                  {{#if this.Guest}}{{this.Guest.firstName.[0]}}{{else}}?{{/if}}
                </div>
                <div>
                  <p class="text-sm font-semibold text-gray-800">
                    {{#if this.Guest}}{{this.Guest.firstName}} {{this.Guest.lastName}}{{else}}—{{/if}}
                  </p>
                  <p class="text-xs text-gray-400">
                    {{#if this.Room}}{{this.Room.roomNumber}} · {{this.Room.RoomType.name}}{{/if}}
                  </p>
                </div>
              </div>
              <div class="text-right">
                <span class="badge text-xs {{#if (eq this.status 'confirmed')}}badge-success{{else}}badge-warning{{/if}}">
                  {{this.status}}
                </span>
                <p class="text-xs text-gray-400 mt-0.5">#{{this.id}}</p>
              </div>
            </div>
            {{else}}
            <div class="px-5 py-8 text-center text-gray-400 text-sm">
              <i class="fa-regular fa-calendar-check text-2xl mb-2 block text-gray-300"></i>
              No arrivals scheduled today
            </div>
            {{/each}}
          </div>
        </div>

        <!-- Today's Departures -->
        <div class="card overflow-hidden animate-fade-in-up">
          <div class="px-5 py-4 flex items-center justify-between border-b border-gray-100"
               style="background: linear-gradient(135deg,#fffbeb,#fef3c7);">
            <div class="flex items-center gap-2">
              <i class="fa-solid fa-arrow-right-from-bracket text-amber-600"></i>
              <h3 class="font-bold text-gray-800 text-sm">Today's Departures</h3>
            </div>
            <span class="badge badge-warning text-xs">{{todayDepartures.length}} guest(s)</span>
          </div>
          <div class="divide-y divide-gray-50 max-h-56 overflow-y-auto">
            {{#each todayDepartures}}
            <div class="px-5 py-3 flex items-center justify-between hover:bg-gray-50 transition-colors">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold text-white flex-shrink-0"
                     style="background: linear-gradient(135deg,#f59e0b,#d97706);">
                  {{#if this.Guest}}{{this.Guest.firstName.[0]}}{{else}}?{{/if}}
                </div>
                <div>
                  <p class="text-sm font-semibold text-gray-800">
                    {{#if this.Guest}}{{this.Guest.firstName}} {{this.Guest.lastName}}{{else}}—{{/if}}
                  </p>
                  <p class="text-xs text-gray-400">
                    {{#if this.Room}}{{this.Room.roomNumber}} · {{this.Room.RoomType.name}}{{/if}}
                  </p>
                </div>
              </div>
              <div class="text-right">
                <span class="badge badge-info text-xs">checked in</span>
                <p class="text-xs text-gray-400 mt-0.5">#{{this.id}}</p>
              </div>
            </div>
            {{else}}
            <div class="px-5 py-8 text-center text-gray-400 text-sm">
              <i class="fa-regular fa-calendar text-2xl mb-2 block text-gray-300"></i>
              No departures scheduled today
            </div>
            {{/each}}
          </div>
        </div>
      </div>

      <!-- ── Row 3: Recent Bookings + Guest Feedback Summary ── -->
      <div class="grid lg:grid-cols-3 gap-5">

        <!-- Recent Bookings (2/3) -->
        <div class="lg:col-span-2 card overflow-hidden animate-fade-in-up">
          <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
            <h3 class="font-bold text-gray-800 text-sm flex items-center gap-2">
              <i class="fa-solid fa-clock-rotate-left text-teal-500"></i> Recent Bookings
            </h3>
            <a href="/admin/reservations"
               class="text-xs font-semibold text-teal-600 hover:text-teal-700 flex items-center gap-1 transition-colors">
              View all <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>
          </div>
          <div class="overflow-x-auto">
            <table class="nb-table">
              <thead>
                <tr>
                  <th>Guest</th>
                  <th>Room</th>
                  <th>Check-in</th>
                  <th>Amount</th>
                  <th>Status</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {{#each recentBookings}}
                <tr>
                  <td>
                    {{#if this.Guest}}
                    <p class="font-semibold text-gray-800 text-sm">{{this.Guest.firstName}} {{this.Guest.lastName}}</p>
                    {{else}}<span class="text-gray-400 text-sm">—</span>{{/if}}
                  </td>
                  <td>
                    {{#if this.Room}}
                    <p class="text-sm font-medium text-gray-700">{{this.Room.roomNumber}}</p>
                    <p class="text-xs text-gray-400">{{this.Room.RoomType.name}}</p>
                    {{else}}<span class="text-gray-400 text-sm">—</span>{{/if}}
                  </td>
                  <td class="text-sm text-gray-600">{{this.checkIn}}</td>
                  <td class="font-semibold text-teal-700 text-sm">₱{{this.totalAmount}}</td>
                  <td>
                    <span class="badge text-xs
                      {{#if (eq this.status 'pending')}}badge-warning
                      {{else if (eq this.status 'confirmed')}}badge-success
                      {{else if (eq this.status 'checked_in')}}badge-info
                      {{else if (eq this.status 'cancelled')}}badge-danger
                      {{else}}badge-neutral{{/if}}">
                      {{this.status}}
                    </span>
                  </td>
                  <td>
                    <a href="/bookings/{{this.id}}"
                       class="text-xs font-semibold text-teal-600 hover:text-teal-800 transition-colors">
                      View →
                    </a>
                  </td>
                </tr>
                {{else}}
                <tr>
                  <td colspan="6" class="text-center py-8 text-gray-400 text-sm">No bookings yet</td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Guest Feedback Summary (1/3) -->
        <div class="space-y-4 animate-fade-in-up">

          <!-- Feedback overview card -->
          <div class="card p-5">
            <div class="flex items-center justify-between mb-4">
              <h3 class="font-bold text-gray-800 text-sm flex items-center gap-2">
                <i class="fa-solid fa-star text-amber-500"></i> Guest Feedback
              </h3>
              <a href="/admin/sentiment-analysis"
                 class="text-xs font-semibold text-teal-600 hover:text-teal-700 transition-colors">
                Details →
              </a>
            </div>

            {{#if avgRating}}
            <div class="text-center mb-4 py-3 rounded-xl" style="background:#f0fdf4;">
              <p class="text-4xl font-bold text-green-600 font-display">{{avgRating}}</p>
              <p class="text-xs text-gray-500 mt-1">Average Guest Rating / 5</p>
              <div class="flex justify-center gap-0.5 mt-2">
                <i class="fa-solid fa-star text-amber-400 text-sm"></i>
                <i class="fa-solid fa-star text-amber-400 text-sm"></i>
                <i class="fa-solid fa-star text-amber-400 text-sm"></i>
                <i class="fa-solid fa-star text-amber-400 text-sm"></i>
                <i class="fa-solid fa-star text-amber-200 text-sm"></i>
              </div>
            </div>
            {{/if}}

            <div class="space-y-2.5">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-sm text-gray-600">
                  <div class="w-2.5 h-2.5 rounded-full bg-green-500"></div> Positive
                </div>
                <div class="flex items-center gap-2">
                  <div class="w-24 h-2 rounded-full bg-gray-100 overflow-hidden">
                    <div class="h-full rounded-full bg-green-500 transition-all"
                         style="width:{{#if totalFeedback}}{{divide (multiply positiveFeedback 100) totalFeedback}}{{else}}0{{/if}}%"></div>
                  </div>
                  <span class="text-sm font-bold text-green-600 w-6 text-right">{{positiveFeedback}}</span>
                </div>
              </div>
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-sm text-gray-600">
                  <div class="w-2.5 h-2.5 rounded-full bg-gray-400"></div> Neutral
                </div>
                <div class="flex items-center gap-2">
                  <div class="w-24 h-2 rounded-full bg-gray-100 overflow-hidden">
                    <div class="h-full rounded-full bg-gray-400 transition-all"
                         style="width:{{#if totalFeedback}}{{divide (multiply neutralFeedback 100) totalFeedback}}{{else}}0{{/if}}%"></div>
                  </div>
                  <span class="text-sm font-bold text-gray-500 w-6 text-right">{{neutralFeedback}}</span>
                </div>
              </div>
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-sm text-gray-600">
                  <div class="w-2.5 h-2.5 rounded-full bg-red-500"></div> Negative
                </div>
                <div class="flex items-center gap-2">
                  <div class="w-24 h-2 rounded-full bg-gray-100 overflow-hidden">
                    <div class="h-full rounded-full bg-red-500 transition-all"
                         style="width:{{#if totalFeedback}}{{divide (multiply negativeFeedback 100) totalFeedback}}{{else}}0{{/if}}%"></div>
                  </div>
                  <span class="text-sm font-bold text-red-600 w-6 text-right">{{negativeFeedback}}</span>
                </div>
              </div>
            </div>

            <div class="mt-4 pt-4 border-t border-gray-100 flex items-center justify-between">
              <span class="text-xs text-gray-400">Total reviews</span>
              <span class="text-sm font-bold text-gray-700">{{totalFeedback}}</span>
            </div>
          </div>

          <!-- Pending approvals alert -->
          {{#if pendingBookings}}
          <a href="/admin/reservations"
             class="card p-4 flex items-center gap-3 hover:shadow-lg transition-all group"
             style="border-left: 3px solid #f59e0b;">
            <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0 bg-amber-100">
              <i class="fa-solid fa-triangle-exclamation text-amber-600"></i>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-bold text-gray-800">{{pendingBookings}} Pending</p>
              <p class="text-xs text-gray-500">Booking(s) need approval</p>
            </div>
            <i class="fa-solid fa-arrow-right text-gray-300 group-hover:text-amber-500 group-hover:translate-x-1 transition-all text-xs"></i>
          </a>
          {{/if}}

        </div>
      </div>

    </div><!-- /content -->
  </main>
</div>

<!-- Logout Confirmation Modal -->
<div id="logoutConfirmModal"
     class="hidden fixed inset-0 z-[500] flex items-center justify-center p-4"
     style="background: rgba(15,23,42,.65); backdrop-filter: blur(6px);">
  <div class="bg-white rounded-3xl shadow-2xl max-w-sm w-full p-8 animate-fade-in-up">
    <div class="flex items-center gap-4 mb-5">
      <div class="w-12 h-12 rounded-2xl flex items-center justify-center flex-shrink-0"
           style="background: linear-gradient(135deg,#fef3c7,#fde68a);">
        <i class="fa-solid fa-right-from-bracket text-amber-600 text-lg"></i>
      </div>
      <div>
        <h3 class="text-lg font-bold text-gray-900">Sign Out?</h3>
        <p class="text-sm text-gray-500">You'll need to sign in again to access your account.</p>
      </div>
    </div>
    <div class="flex gap-3 mt-6">
      <button id="logoutConfirmNo"
              class="flex-1 px-4 py-2.5 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold text-sm transition-colors">
        Cancel
      </button>
      <button id="logoutConfirmYes"
              class="flex-1 px-4 py-2.5 rounded-xl font-semibold text-sm text-white transition-all"
              style="background: linear-gradient(135deg,#dc2626,#ef4444); box-shadow: 0 4px 12px rgba(220,38,38,.3);">
        Sign Out
      </button>
    </div>
  </div>
</div>

<script>
(function () {
  const toggle  = document.getElementById('sidebar-toggle');
  const sidebar = document.getElementById('admin-sidebar');
  if (toggle && sidebar) {
    toggle.addEventListener('click', () => sidebar.classList.toggle('-translate-x-full'));
    document.addEventListener('click', (e) => {
      if (window.innerWidth < 768 && !sidebar.contains(e.target) && !toggle.contains(e.target))
        sidebar.classList.add('-translate-x-full');
    });
  }

  // Logout functionality
  let _logoutCb = null;

  window.showLogoutConfirmation = function (cb) {
    _logoutCb = cb;
    const m = document.getElementById('logoutConfirmModal');
    if (m) m.classList.remove('hidden');
  };

  window.confirmAdminLogout = function () {
    showLogoutConfirmation(function () {
      window.location.href = '/logout';
    });
  };

  function closeModal() {
    const modal = document.getElementById('logoutConfirmModal');
    if (modal) modal.classList.add('hidden');
    _logoutCb = null;
  }

  // Wire up logout button and modal
  document.addEventListener('DOMContentLoaded', function () {
    const logoutBtn = document.getElementById('adminLogoutBtn');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', window.confirmAdminLogout);
    }

    const yes = document.getElementById('logoutConfirmYes');
    const no = document.getElementById('logoutConfirmNo');
    const modal = document.getElementById('logoutConfirmModal');

    if (yes) yes.addEventListener('click', () => { if (_logoutCb) _logoutCb(); });
    if (no) no.addEventListener('click', closeModal);
    if (modal) modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  });
})();
</script>
</body>
