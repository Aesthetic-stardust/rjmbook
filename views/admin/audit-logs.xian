{{> head }}
<body class="font-body">
{{> adminSidebar }}

    <!-- ── Page Content ── -->
    <div class="flex-1 overflow-auto p-6" style="background:#f8fafc;">

      <!-- ── Stat Cards ── -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">

        <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
          <div class="flex items-center justify-between mb-3">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background:#f0fdf4;">
              <i class="fa-solid fa-scroll text-emerald-600"></i>
            </div>
            <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Total</span>
          </div>
          <p class="text-2xl font-bold text-gray-800">{{stats.totalCount}}</p>
          <p class="text-sm text-gray-500 mt-0.5">All Audit Entries</p>
        </div>

        <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
          <div class="flex items-center justify-between mb-3">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background:#f0fdf4;">
              <i class="fa-solid fa-circle-check text-emerald-500"></i>
            </div>
            <span class="text-xs font-semibold text-emerald-500 uppercase tracking-wider">OK</span>
          </div>
          <p class="text-2xl font-bold text-gray-800">{{stats.successCount}}</p>
          <p class="text-sm text-gray-500 mt-0.5">Successful Actions</p>
        </div>

        <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
          <div class="flex items-center justify-between mb-3">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background:#fef2f2;">
              <i class="fa-solid fa-circle-xmark text-red-500"></i>
            </div>
            <span class="text-xs font-semibold text-red-500 uppercase tracking-wider">Failed</span>
          </div>
          <p class="text-2xl font-bold text-gray-800">{{stats.failureCount}}</p>
          <p class="text-sm text-gray-500 mt-0.5">Failed Actions</p>
        </div>

        <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
          <div class="flex items-center justify-between mb-3">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background:#fffbeb;">
              <i class="fa-solid fa-triangle-exclamation text-amber-500"></i>
            </div>
            <span class="text-xs font-semibold text-amber-500 uppercase tracking-wider">Warn</span>
          </div>
          <p class="text-2xl font-bold text-gray-800">{{stats.warningCount}}</p>
          <p class="text-sm text-gray-500 mt-0.5">Warnings</p>
        </div>
      </div>

      <!-- ── Filters ── -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 mb-6">
        <form method="GET" action="/admin/audit-logs" class="flex flex-wrap gap-3 items-end">

          <div class="flex flex-col gap-1 min-w-[160px]">
            <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Search</label>
            <input type="text" name="search" value="{{filters.search}}"
                   placeholder="User, description, path…"
                   class="border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent" />
          </div>

          <div class="flex flex-col gap-1">
            <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Module</label>
            <select name="module" class="border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-400">
              <option value="">All Modules</option>
              {{#each modules}}
                <option value="{{this}}" {{#if (eq this ../filters.module)}}selected{{/if}}>{{this}}</option>
              {{/each}}
            </select>
          </div>

          <div class="flex flex-col gap-1">
            <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</label>
            <select name="status" class="border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-400">
              <option value="">All Statuses</option>
              <option value="success" {{#if (eq filters.status "success")}}selected{{/if}}>Success</option>
              <option value="failure" {{#if (eq filters.status "failure")}}selected{{/if}}>Failure</option>
              <option value="warning" {{#if (eq filters.status "warning")}}selected{{/if}}>Warning</option>
            </select>
          </div>

          <div class="flex flex-col gap-1">
            <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider">From</label>
            <input type="date" name="from" value="{{filters.from}}"
                   class="border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-400" />
          </div>

          <div class="flex flex-col gap-1">
            <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider">To</label>
            <input type="date" name="to" value="{{filters.to}}"
                   class="border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-400" />
          </div>

          <button type="submit"
                  class="px-5 py-2 rounded-xl text-sm font-semibold text-white transition-all"
                  style="background: linear-gradient(135deg,#0d9488,#0891b2);">
            <i class="fa-solid fa-magnifying-glass mr-1.5"></i>Filter
          </button>

          <a href="/admin/audit-logs"
             class="px-5 py-2 rounded-xl text-sm font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 transition-colors">
            <i class="fa-solid fa-xmark mr-1.5"></i>Clear
          </a>
        </form>
      </div>

      <!-- ── Table ── -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
          <div>
            <h3 class="text-base font-bold text-gray-800">Activity Log</h3>
            <p class="text-xs text-gray-400 mt-0.5">
              Showing {{pagination.totalCount}} entr{{#if (eq pagination.totalCount 1)}}y{{else}}ies{{/if}}
              — page {{pagination.page}} of {{pagination.totalPages}}
            </p>
          </div>
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-shield-halved text-teal-500"></i>
            <span class="text-xs font-semibold text-gray-500">Admin-only view</span>
          </div>
        </div>

        {{#if logs.length}}
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-gray-50 border-b border-gray-100 text-left">
                <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider whitespace-nowrap">When</th>
                <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">User</th>
                <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Action</th>
                <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Module</th>
                <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Description</th>
                <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Target</th>
                <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">IP</th>
                <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
              {{#each logs}}
              <tr class="hover:bg-gray-50 transition-colors">

                <!-- When -->
                <td class="px-4 py-3 whitespace-nowrap">
                  <p class="text-xs font-medium text-gray-700">{{formatDate this.createdAt}}</p>
                </td>

                <!-- User -->
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold text-white flex-shrink-0"
                         style="background: linear-gradient(135deg,#0d9488,#0891b2);">
                      {{#if this.userName}}{{this.userName.[0]}}{{else}}?{{/if}}
                    </div>
                    <div>
                      <p class="font-medium text-gray-800 text-xs">{{#if this.userName}}{{this.userName}}{{else}}<span class="text-gray-400 italic">unknown</span>{{/if}}</p>
                      <span class="inline-block text-[10px] px-1.5 py-0.5 rounded font-semibold
                        {{#if (eq this.role 'admin')}}bg-purple-100 text-purple-700
                        {{else if (eq this.role 'staff')}}bg-blue-100 text-blue-700
                        {{else}}bg-gray-100 text-gray-600{{/if}}">
                        {{#if this.role}}{{this.role}}{{else}}—{{/if}}
                      </span>
                    </div>
                  </div>
                </td>

                <!-- Action -->
                <td class="px-4 py-3">
                  <code class="text-xs font-mono bg-gray-100 text-gray-700 px-2 py-0.5 rounded-md">{{this.action}}</code>
                </td>

                <!-- Module -->
                <td class="px-4 py-3">
                  <span class="text-xs font-medium text-teal-700 bg-teal-50 px-2 py-0.5 rounded-full">{{this.module}}</span>
                </td>

                <!-- Description -->
                <td class="px-4 py-3 max-w-[220px]">
                  <p class="text-xs text-gray-600 truncate" title="{{this.description}}">
                    {{#if this.description}}{{this.description}}{{else}}<span class="text-gray-300 italic">—</span>{{/if}}
                  </p>
                </td>

                <!-- Target -->
                <td class="px-4 py-3 whitespace-nowrap">
                  {{#if this.targetType}}
                    <span class="text-xs text-gray-500">{{this.targetType}}
                      {{#if this.targetId}}<span class="font-semibold text-gray-700">#{{this.targetId}}</span>{{/if}}
                    </span>
                  {{else}}
                    <span class="text-gray-300 text-xs">—</span>
                  {{/if}}
                </td>

                <!-- IP -->
                <td class="px-4 py-3">
                  <span class="text-xs font-mono text-gray-500">{{#if this.ipAddress}}{{this.ipAddress}}{{else}}—{{/if}}</span>
                </td>

                <!-- Status -->
                <td class="px-4 py-3">
                  {{#if (eq this.status "success")}}
                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full">
                      <i class="fa-solid fa-circle-check text-[10px]"></i> Success
                    </span>
                  {{else if (eq this.status "failure")}}
                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-red-700 bg-red-50 px-2.5 py-1 rounded-full">
                      <i class="fa-solid fa-circle-xmark text-[10px]"></i> Failure
                    </span>
                  {{else}}
                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-amber-700 bg-amber-50 px-2.5 py-1 rounded-full">
                      <i class="fa-solid fa-triangle-exclamation text-[10px]"></i> Warning
                    </span>
                  {{/if}}
                </td>

              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        {{#if (gt pagination.totalPages 1)}}
        <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-between">
          <p class="text-xs text-gray-400">
            Page {{pagination.page}} of {{pagination.totalPages}}
          </p>
          <div class="flex items-center gap-2">
            {{#if pagination.hasPrev}}
              <a href="?page={{pagination.prevPage}}&module={{filters.module}}&status={{filters.status}}&from={{filters.from}}&to={{filters.to}}&search={{filters.search}}"
                 class="px-4 py-2 rounded-xl text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 transition-colors">
                <i class="fa-solid fa-chevron-left mr-1"></i>Prev
              </a>
            {{/if}}
            {{#if pagination.hasNext}}
              <a href="?page={{pagination.nextPage}}&module={{filters.module}}&status={{filters.status}}&from={{filters.from}}&to={{filters.to}}&search={{filters.search}}"
                 class="px-4 py-2 rounded-xl text-xs font-semibold text-white transition-all"
                 style="background: linear-gradient(135deg,#0d9488,#0891b2);">
                Next<i class="fa-solid fa-chevron-right ml-1"></i>
              </a>
            {{/if}}
          </div>
        </div>
        {{/if}}

        {{else}}
        <!-- Empty state -->
        <div class="flex flex-col items-center justify-center py-20 text-center px-6">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mb-4"
               style="background: linear-gradient(135deg,#f0fdf4,#dcfce7);">
            <i class="fa-solid fa-scroll text-emerald-400 text-2xl"></i>
          </div>
          <h4 class="text-base font-bold text-gray-700 mb-1">No audit entries found</h4>
          <p class="text-sm text-gray-400 max-w-xs">Actions performed by admins and staff will appear here once activity is recorded.</p>
          {{#if filters.search}}
          <a href="/admin/audit-logs" class="mt-4 text-sm text-teal-600 hover:underline">Clear filters</a>
          {{/if}}
        </div>
        {{/if}}
      </div>

    </div><!-- /content -->
  </main>
</div><!-- /flex wrapper -->

{{> footer }}
