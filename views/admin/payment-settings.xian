{{> head }}
<body class="font-body">
<div class="flex h-screen overflow-hidden" style="background:#f1f5f9;">

  <!-- ── Admin Sidebar ── -->
  <aside id="admin-sidebar"
         class="flex-shrink-0 w-64 flex flex-col fixed md:relative top-0 left-0 h-screen z-40 transition-transform duration-300"
         style="background: linear-gradient(180deg,#0f172a 0%,#134e4a 100%); box-shadow: 4px 0 24px rgba(0,0,0,.18);">
    <div class="px-6 py-6 border-b" style="border-color: rgba(255,255,255,.08);">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0"
             style="background: linear-gradient(135deg,#0d9488,#0891b2);">
        </div>
        <div>
          <h1 class="text-lg font-bold text-white font-display leading-none">RJMBook</h1>
          <p class="text-xs mt-0.5" style="color: rgba(255,255,255,.4);">Admin Panel</p>
        </div>
      </div>
    </div>
    <nav class="flex-1 px-3 py-5 space-y-0.5 overflow-y-auto">
      <p class="text-xs font-semibold uppercase tracking-widest px-3 mb-3" style="color: rgba(255,255,255,.3);">Management</p>
      <a href="/admin"              class="sidebar-link"><i class="fa-solid fa-gauge w-4 text-center flex-shrink-0"></i><span>Dashboard</span></a>
      <a href="/admin/reservations" class="sidebar-link"><i class="fa-solid fa-calendar-days w-4 text-center flex-shrink-0"></i><span>Reservations</span></a>
      <a href="/admin/book"         class="sidebar-link"><i class="fa-solid fa-calendar-plus w-4 text-center flex-shrink-0"></i><span>Walk-in Booking</span></a>
      <a href="/admin/reservation-calendar" class="sidebar-link"><i class="fa-solid fa-calendar w-4 text-center flex-shrink-0"></i><span>Reservation Calendar</span></a>
      <a href="/admin/room-availability" class="sidebar-link"><i class="fa-solid fa-door-open w-4 text-center flex-shrink-0"></i><span>Room Availability</span></a>
      <a href="/admin/rooms"        class="sidebar-link"><i class="fa-solid fa-bed w-4 text-center flex-shrink-0"></i><span>Rooms</span></a>
      <a href="/admin/cottages"     class="sidebar-link"><i class="fa-solid fa-umbrella-beach w-4 text-center flex-shrink-0"></i><span>Cottages</span></a>
      <a href="/guests"             class="sidebar-link"><i class="fa-solid fa-users w-4 text-center flex-shrink-0"></i><span>Guests</span></a>
      <div class="my-3 border-t" style="border-color: rgba(255,255,255,.07);"></div>
      <p class="text-xs font-semibold uppercase tracking-widest px-3 mb-3" style="color: rgba(255,255,255,.3);">Analytics</p>
      <a href="/dashboard"                class="sidebar-link"><i class="fa-solid fa-chart-pie w-4 text-center flex-shrink-0"></i><span>Analytics</span></a>
      <a href="/admin/reports"            class="sidebar-link"><i class="fa-solid fa-file-chart-column w-4 text-center flex-shrink-0"></i><span>Reports</span></a>
      <a href="/admin/sentiment-analysis" class="sidebar-link"><i class="fa-solid fa-brain w-4 text-center flex-shrink-0"></i><span>Sentiment Analysis</span></a>
      <div class="my-3 border-t" style="border-color: rgba(255,255,255,.07);"></div>
      <p class="text-xs font-semibold uppercase tracking-widest px-3 mb-3" style="color: rgba(255,255,255,.3);">Settings</p>
      <a href="/admin/payment-settings" class="sidebar-link active"><i class="fa-solid fa-peso-sign w-4 text-center flex-shrink-0"></i><span>Payment Settings</span></a>
      <a href="/admin/staff"            class="sidebar-link"><i class="fa-solid fa-user-tie w-4 text-center flex-shrink-0"></i><span>Manage Staff</span></a>
      <a href="/account"                class="sidebar-link"><i class="fa-solid fa-user-gear w-4 text-center flex-shrink-0"></i><span>Account Settings</span></a>
    </nav>
    <div class="px-3 py-4 border-t" style="border-color: rgba(255,255,255,.08);">
      <div class="flex items-center gap-3 px-3 py-3 rounded-xl mb-3" style="background: rgba(255,255,255,.06);">
        <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold text-white flex-shrink-0"
             style="background: linear-gradient(135deg,#0d9488,#0891b2);">
          {{#if sessionUserName}}{{sessionUserName.[0]}}{{else}}A{{/if}}
        </div>
        <div class="min-w-0">
          <p class="text-xs text-white font-semibold truncate">{{sessionUserName}}</p>
          <p class="text-xs" style="color: rgba(255,255,255,.4);">Administrator</p>
        </div>
      </div>
      <button id="adminLogoutBtn"
              class="w-full flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl text-sm font-semibold text-white transition-all cursor-pointer border-none"
              style="background: rgba(220,38,38,.2); border: 1px solid rgba(220,38,38,.3);">
        <i class="fa-solid fa-right-from-bracket text-red-400"></i>
        <span class="text-red-300">Sign Out</span>
      </button>
    </div>
  </aside>

  <!-- ── Main ── -->
  <main class="flex-1 flex flex-col overflow-hidden">
    <header class="flex-shrink-0 flex items-center justify-between px-6 py-4 bg-white border-b border-gray-200"
            style="box-shadow: 0 1px 8px rgba(0,0,0,.06);">
      <div class="flex items-center gap-4">
        <button id="sidebar-toggle" class="md:hidden p-2 rounded-lg text-gray-500 hover:bg-gray-100 transition-colors">
          <i class="fa-solid fa-bars"></i>
        </button>
        <div>
          <h2 class="text-xl font-bold text-gray-800">Payment Settings</h2>
          <p class="text-xs text-gray-500 mt-0.5">Control how much online guests pay when booking</p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <div class="hidden sm:block text-right">
          <p class="text-xs text-gray-500">Welcome back,</p>
          <p class="text-sm font-semibold text-gray-800">{{sessionUserName}}</p>
        </div>
        <div class="w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold text-white"
             style="background: linear-gradient(135deg,#0d9488,#0891b2);">
          {{#if sessionUserName}}{{sessionUserName.[0]}}{{else}}A{{/if}}
        </div>
      </div>
    </header>

    <div class="flex-1 overflow-auto p-6" style="background:#f8fafc;">
      <div class="max-w-2xl mx-auto">

        {{#if saved}}
        <div class="alert alert-success mb-6 animate-fade-in-up">
          <i class="fa-solid fa-circle-check flex-shrink-0"></i>
          <span>Payment policy saved successfully. New online bookings will use this setting.</span>
        </div>
        {{/if}}

        <!-- Info card -->
        <div class="alert alert-info mb-6 animate-fade-in-up">
          <i class="fa-solid fa-circle-info flex-shrink-0"></i>
          <div>
            <p class="font-semibold">Online Booking Payment Policy</p>
            <p class="text-sm mt-0.5">This setting applies to all guest online bookings. Walk-in bookings created by staff are not affected.</p>
          </div>
        </div>

        <!-- Policy selector card -->
        <form method="POST" action="/admin/payment-settings" id="payment-settings-form">
          <div class="card p-7 animate-fade-in-up">
            <h3 class="text-sm font-bold text-gray-500 uppercase tracking-widest mb-1 flex items-center gap-2">
              <i class="fa-solid fa-sliders text-teal-500"></i> Down Payment Requirement
            </h3>
            <p class="text-xs text-gray-400 mb-6">Choose how much guests must pay upfront when booking online.</p>

            <div class="grid grid-cols-1 gap-4">

              <!-- 0% option -->
              <label id="tile-0"
                     class="pct-tile flex items-center gap-5 p-5 border-2 rounded-2xl cursor-pointer transition-all
                            {{#if (eq setting.downPaymentPercent 0)}}border-green-400 bg-green-50{{else}}border-gray-200 hover:border-green-300 hover:bg-green-50{{/if}}">
                <input type="radio" name="downPaymentPercent" value="0" class="sr-only pct-radio"
                       {{#if (eq setting.downPaymentPercent 0)}}checked{{/if}} />
                <div class="w-14 h-14 rounded-2xl flex items-center justify-center flex-shrink-0 text-xl font-extrabold
                            {{#if (eq setting.downPaymentPercent 0)}}bg-green-100 text-green-700{{else}}bg-gray-100 text-gray-500{{/if}}">
                  0%
                </div>
                <div class="flex-1">
                  <p class="font-bold text-gray-800 text-base">No Advance Payment</p>
                  <p class="text-sm text-gray-500 mt-0.5">Guests can book without paying anything upfront. Full amount is collected at check-in.</p>
                </div>
                <div class="flex-shrink-0">
                  <div class="w-5 h-5 rounded-full border-2 flex items-center justify-center
                              {{#if (eq setting.downPaymentPercent 0)}}border-green-500 bg-green-500{{else}}border-gray-300{{/if}}">
                    {{#if (eq setting.downPaymentPercent 0)}}<i class="fa-solid fa-check text-white text-xs"></i>{{/if}}
                  </div>
                </div>
              </label>

              <!-- 50% option -->
              <label id="tile-50"
                     class="pct-tile flex items-center gap-5 p-5 border-2 rounded-2xl cursor-pointer transition-all
                            {{#if (eq setting.downPaymentPercent 50)}}border-amber-400 bg-amber-50{{else}}border-gray-200 hover:border-amber-300 hover:bg-amber-50{{/if}}">
                <input type="radio" name="downPaymentPercent" value="50" class="sr-only pct-radio"
                       {{#if (eq setting.downPaymentPercent 50)}}checked{{/if}} />
                <div class="w-14 h-14 rounded-2xl flex items-center justify-center flex-shrink-0 text-xl font-extrabold
                            {{#if (eq setting.downPaymentPercent 50)}}bg-amber-100 text-amber-700{{else}}bg-gray-100 text-gray-500{{/if}}">
                  50%
                </div>
                <div class="flex-1">
                  <p class="font-bold text-gray-800 text-base">50% Down Payment</p>
                  <p class="text-sm text-gray-500 mt-0.5">Guests pay half the total amount via Maya to confirm the booking. Remaining 50% is due at check-in.</p>
                </div>
                <div class="flex-shrink-0">
                  <div class="w-5 h-5 rounded-full border-2 flex items-center justify-center
                              {{#if (eq setting.downPaymentPercent 50)}}border-amber-500 bg-amber-500{{else}}border-gray-300{{/if}}">
                    {{#if (eq setting.downPaymentPercent 50)}}<i class="fa-solid fa-check text-white text-xs"></i>{{/if}}
                  </div>
                </div>
              </label>

              <!-- 100% option -->
              <label id="tile-100"
                     class="pct-tile flex items-center gap-5 p-5 border-2 rounded-2xl cursor-pointer transition-all
                            {{#if (eq setting.downPaymentPercent 100)}}border-teal-400 bg-teal-50{{else}}border-gray-200 hover:border-teal-300 hover:bg-teal-50{{/if}}">
                <input type="radio" name="downPaymentPercent" value="100" class="sr-only pct-radio"
                       {{#if (eq setting.downPaymentPercent 100)}}checked{{/if}} />
                <div class="w-14 h-14 rounded-2xl flex items-center justify-center flex-shrink-0 text-xl font-extrabold
                            {{#if (eq setting.downPaymentPercent 100)}}bg-teal-100 text-teal-700{{else}}bg-gray-100 text-gray-500{{/if}}">
                  100%
                </div>
                <div class="flex-1">
                  <p class="font-bold text-gray-800 text-base">Full Payment Required</p>
                  <p class="text-sm text-gray-500 mt-0.5">Guests must pay the full amount via Maya to confirm the booking. Nothing is due at check-in.</p>
                </div>
                <div class="flex-shrink-0">
                  <div class="w-5 h-5 rounded-full border-2 flex items-center justify-center
                              {{#if (eq setting.downPaymentPercent 100)}}border-teal-500 bg-teal-500{{else}}border-gray-300{{/if}}">
                    {{#if (eq setting.downPaymentPercent 100)}}<i class="fa-solid fa-check text-white text-xs"></i>{{/if}}
                  </div>
                </div>
              </label>

            </div>

            <!-- Current policy summary -->
            <div id="policy-summary" class="mt-6 rounded-xl p-4 text-sm font-medium flex items-center gap-3
              {{#if (eq setting.downPaymentPercent 0)}}bg-green-50 text-green-800 border border-green-200
              {{else if (eq setting.downPaymentPercent 50)}}bg-amber-50 text-amber-800 border border-amber-200
              {{else}}bg-teal-50 text-teal-800 border border-teal-200{{/if}}">
              <i class="fa-solid fa-circle-info flex-shrink-0"></i>
              <span id="policy-summary-text">
                {{#if (eq setting.downPaymentPercent 0)}}Currently: guests book for free — no payment collected online.
                {{else if (eq setting.downPaymentPercent 50)}}Currently: guests pay 50% via Maya to confirm. Balance collected at check-in.
                {{else}}Currently: guests pay the full amount via Maya. No balance at check-in.{{/if}}
              </span>
            </div>

            <button type="submit" class="btn btn-primary w-full btn-lg mt-6">
              <i class="fa-solid fa-floppy-disk"></i> Save Payment Policy
            </button>
          </div>
        </form>

      </div>
    </div>
  </main>
</div>

<!-- Logout Confirmation Modal -->
<div id="logoutConfirmModal"
     class="hidden fixed inset-0 z-[500] flex items-center justify-center p-4"
     style="background: rgba(15,23,42,.65); backdrop-filter: blur(6px);">
  <div class="bg-white rounded-3xl shadow-2xl max-w-sm w-full p-8 animate-fade-in-up">
    <div class="flex items-center gap-4 mb-5">
      <div class="w-12 h-12 rounded-2xl flex items-center justify-center flex-shrink-0"
           style="background: linear-gradient(135deg,#fef3c7,#fde68a);">
        <i class="fa-solid fa-right-from-bracket text-amber-600 text-lg"></i>
      </div>
      <div>
        <h3 class="text-lg font-bold text-gray-900">Sign Out?</h3>
        <p class="text-sm text-gray-500">You'll need to sign in again to access your account.</p>
      </div>
    </div>
    <div class="flex gap-3 mt-6">
      <button id="logoutConfirmNo"
              class="flex-1 px-4 py-2.5 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold text-sm transition-colors">
        Cancel
      </button>
      <button id="logoutConfirmYes"
              class="flex-1 px-4 py-2.5 rounded-xl font-semibold text-sm text-white transition-all"
              style="background: linear-gradient(135deg,#dc2626,#ef4444); box-shadow: 0 4px 12px rgba(220,38,38,.3);">
        Sign Out
      </button>
    </div>
  </div>
</div>

<script>
(function () {
  // Sidebar toggle
  const toggle  = document.getElementById('sidebar-toggle');
  const sidebar = document.getElementById('admin-sidebar');
  if (toggle && sidebar) {
    toggle.addEventListener('click', () => sidebar.classList.toggle('-translate-x-full'));
    document.addEventListener('click', (e) => {
      if (window.innerWidth < 768 && !sidebar.contains(e.target) && !toggle.contains(e.target))
        sidebar.classList.add('-translate-x-full');
    });
  }

  // Logout modal
  let _logoutCb = null;
  window.confirmAdminLogout = function () {
    _logoutCb = () => { window.location.href = '/logout'; };
    document.getElementById('logoutConfirmModal').classList.remove('hidden');
  };
  document.getElementById('logoutConfirmYes').addEventListener('click', () => { if (_logoutCb) _logoutCb(); });
  document.getElementById('logoutConfirmNo').addEventListener('click',  () => document.getElementById('logoutConfirmModal').classList.add('hidden'));
  document.getElementById('logoutConfirmModal').addEventListener('click', (e) => { if (e.target === e.currentTarget) e.currentTarget.classList.add('hidden'); });
  const adminLogoutBtn = document.getElementById('adminLogoutBtn');
  if (adminLogoutBtn) adminLogoutBtn.addEventListener('click', window.confirmAdminLogout);

  // ── Live tile highlight on change ──
  const colors = {
    '0':   { border: '#4ade80', bg: '#f0fdf4', iconBg: '#dcfce7', iconText: '#15803d' },
    '50':  { border: '#fbbf24', bg: '#fffbeb', iconBg: '#fef3c7', iconText: '#b45309' },
    '100': { border: '#2dd4bf', bg: '#f0fdfa', iconBg: '#ccfbf1', iconText: '#0f766e' }
  };

  const summaries = {
    '0':   'Guests book for free — no payment collected online. Full amount due at check-in.',
    '50':  'Guests pay 50% via Maya to confirm. Remaining 50% is collected at check-in.',
    '100': 'Guests pay the full amount via Maya. No balance is due at check-in.'
  };

  const summaryEl = document.getElementById('policy-summary');
  const summaryText = document.getElementById('policy-summary-text');

  document.querySelectorAll('.pct-radio').forEach(radio => {
    radio.addEventListener('change', function () {
      const val = this.value;
      const c   = colors[val];

      // Reset all tiles
      document.querySelectorAll('.pct-tile').forEach(tile => {
        tile.style.borderColor = '';
        tile.style.background  = '';
      });

      // Highlight selected tile
      const tile = this.closest('.pct-tile');
      if (tile) {
        tile.style.borderColor = c.border;
        tile.style.background  = c.bg;
      }

      // Update summary
      if (summaryEl && summaryText) {
        summaryEl.style.background   = c.bg;
        summaryEl.style.borderColor  = c.border;
        summaryText.textContent      = summaries[val];
      }
    });
  });
})();
</script>
</body>
