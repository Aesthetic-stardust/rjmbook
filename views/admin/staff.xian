{{> head }}
<body class="font-body">
<div class="flex h-screen overflow-hidden" style="background:#f1f5f9;">

  <!-- ── Admin Sidebar ── -->
  <aside id="admin-sidebar"
         class="flex-shrink-0 w-64 flex flex-col fixed md:relative top-0 left-0 h-screen z-40 transition-transform duration-300"
         style="background: linear-gradient(180deg,#0f172a 0%,#134e4a 100%); box-shadow: 4px 0 24px rgba(0,0,0,.18);">
    <div class="px-6 py-6 border-b" style="border-color: rgba(255,255,255,.08);">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0"
             style="background: linear-gradient(135deg,#0d9488,#0891b2);">
        </div>
        <div>
          <h1 class="text-lg font-bold text-white font-display leading-none">RJMBook</h1>
          <p class="text-xs mt-0.5" style="color: rgba(255,255,255,.4);">Admin Panel</p>
        </div>
      </div>
    </div>
    <nav class="flex-1 px-3 py-5 space-y-0.5 overflow-y-auto">
      <p class="text-xs font-semibold uppercase tracking-widest px-3 mb-3" style="color: rgba(255,255,255,.3);">Management</p>
      <a href="/admin"              class="sidebar-link "><i class="fa-solid fa-gauge w-4 text-center flex-shrink-0"></i><span>Dashboard</span></a>
      <a href="/admin/reservations" class="sidebar-link "><i class="fa-solid fa-calendar-days w-4 text-center flex-shrink-0"></i><span>Reservations</span></a>
      <a href="/admin/book"         class="sidebar-link"><i class="fa-solid fa-calendar-plus w-4 text-center flex-shrink-0"></i><span>Walk-in Booking</span></a>
      <a href="/admin/reservation-calendar" class="sidebar-link"><i class="fa-solid fa-calendar w-4 text-center flex-shrink-0"></i><span>Reservation Calendar</span></a>
      <a href="/admin/room-availability" class="sidebar-link"><i class="fa-solid fa-door-open w-4 text-center flex-shrink-0"></i><span>Room Availability</span></a>
      <a href="/admin/rooms"        class="sidebar-link "><i class="fa-solid fa-bed w-4 text-center flex-shrink-0"></i><span>Rooms</span></a>
      <a href="/admin/cottages"     class="sidebar-link "><i class="fa-solid fa-umbrella-beach w-4 text-center flex-shrink-0"></i><span>Cottages</span></a>
      <a href="/guests"             class="sidebar-link"><i class="fa-solid fa-users w-4 text-center flex-shrink-0"></i><span>Guests</span></a>
      <div class="my-3 border-t" style="border-color: rgba(255,255,255,.07);"></div>
      <p class="text-xs font-semibold uppercase tracking-widest px-3 mb-3" style="color: rgba(255,255,255,.3);">Analytics</p>
      <a href="/dashboard"                class="sidebar-link"><i class="fa-solid fa-chart-pie w-4 text-center flex-shrink-0"></i><span>Analytics</span></a>
      <a href="/admin/reports"            class="sidebar-link "><i class="fa-solid fa-file-chart-column w-4 text-center flex-shrink-0"></i><span>Reports</span></a>
      <a href="/admin/sentiment-analysis" class="sidebar-link "><i class="fa-solid fa-brain w-4 text-center flex-shrink-0"></i><span>Sentiment Analysis</span></a>
      <div class="my-3 border-t" style="border-color: rgba(255,255,255,.07);"></div>
      <p class="text-xs font-semibold uppercase tracking-widest px-3 mb-3" style="color: rgba(255,255,255,.3);">Account</p>
      <a href="/admin/payment-settings" class="sidebar-link"><i class="fa-solid fa-peso-sign w-4 text-center flex-shrink-0"></i><span>Payment Settings</span></a>
      <a href="/admin/staff"        class="sidebar-link active"><i class="fa-solid fa-user-tie w-4 text-center flex-shrink-0"></i><span>Manage Staff</span></a>
      <a href="/account" class="sidebar-link"><i class="fa-solid fa-user-gear w-4 text-center flex-shrink-0"></i><span>Account Settings</span></a>
    </nav>
    <div class="px-3 py-4 border-t" style="border-color: rgba(255,255,255,.08);">
      <div class="flex items-center gap-3 px-3 py-3 rounded-xl mb-3" style="background: rgba(255,255,255,.06);">
        <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold text-white flex-shrink-0"
             style="background: linear-gradient(135deg,#0d9488,#0891b2);">
          {{#if sessionUserName}}{{sessionUserName.[0]}}{{else}}A{{/if}}
        </div>
        <div class="min-w-0">
          <p class="text-xs text-white font-semibold truncate">{{sessionUserName}}</p>
          <p class="text-xs" style="color: rgba(255,255,255,.4);">Administrator</p>
        </div>
      </div>
      <button id="adminLogoutBtn"
              class="w-full flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl text-sm font-semibold text-white transition-all cursor-pointer border-none"
              style="background: rgba(220,38,38,.2); border: 1px solid rgba(220,38,38,.3);"
>
        <i class="fa-solid fa-right-from-bracket text-red-400"></i>
        <span class="text-red-300">Sign Out</span>
      </button>
    </div>
  </aside>

  <!-- ── Main ── -->
  <main class="flex-1 flex flex-col overflow-hidden">
    <header class="flex-shrink-0 flex items-center justify-between px-6 py-4 bg-white border-b border-gray-200"
            style="box-shadow: 0 1px 8px rgba(0,0,0,.06);">
      <div class="flex items-center gap-4">
        <button id="sidebar-toggle" class="md:hidden p-2 rounded-lg text-gray-500 hover:bg-gray-100 transition-colors">
          <i class="fa-solid fa-bars"></i>
        </button>
        <div>
          <h2 class="text-xl font-bold text-gray-800">Manage Staff</h2>
          <p class="text-xs text-gray-500 mt-0.5">Create, edit, and remove staff accounts</p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <button onclick="openCreateModal()"
                class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-sm font-semibold text-white transition-all"
                style="background: linear-gradient(135deg,#0d9488,#0891b2); box-shadow: 0 4px 12px rgba(13,148,136,.3);">
          <i class="fa-solid fa-plus text-xs"></i> Add Staff
        </button>
        <div class="w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold text-white"
             style="background: linear-gradient(135deg,#0d9488,#0891b2);">
          {{#if sessionUserName}}{{sessionUserName.[0]}}{{else}}A{{/if}}
        </div>
      </div>
    </header>

    <div class="flex-1 overflow-auto p-6" style="background:#f8fafc;">

      <!-- Stats strip -->
      <div class="flex items-center gap-4 mb-5">
        <div class="stat-card p-4 flex items-center gap-3 animate-fade-in-up" style="min-width:160px;">
          <div class="icon-box bg-teal-100">
            <i class="fa-solid fa-user-tie text-teal-600"></i>
          </div>
          <div>
            <p class="text-2xl font-bold text-gray-800">{{staffList.length}}</p>
            <p class="text-xs text-gray-500 font-medium">Staff Members</p>
          </div>
        </div>
        <div class="alert alert-info flex-1 animate-fade-in-up">
          <i class="fa-solid fa-circle-info flex-shrink-0"></i>
          <span>Staff accounts can access the Staff Panel at <strong>/staff</strong>. They can manage reservations, check-ins, and walk-in bookings.</span>
        </div>
      </div>

      <!-- Staff table -->
      <div class="table-wrapper animate-fade-in-up">
        <table class="nb-table">
          <thead>
            <tr>
              <th>Staff Member</th>
              <th>Email</th>
              <th>Role</th>
              <th>Created</th>
              <th class="text-center">Actions</th>
            </tr>
          </thead>
          <tbody>
            {{#each staffList}}
            <tr data-staff-id="{{this.id}}">
              <td>
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold text-white flex-shrink-0"
                       style="background: linear-gradient(135deg,#0d9488,#0891b2);">
                    {{this.name.[0]}}
                  </div>
                  <div>
                    <p class="font-semibold text-gray-800 text-sm staff-name">{{this.name}}</p>
                    <p class="text-xs text-gray-400">#{{this.id}}</p>
                  </div>
                </div>
              </td>
              <td class="text-sm text-gray-600 staff-email">{{this.email}}</td>
              <td><span class="badge badge-teal text-xs">Staff</span></td>
              <td class="text-sm text-gray-500">{{this.createdAt}}</td>
              <td>
                <div class="flex items-center justify-center gap-2">
                  <button class="btn btn-secondary btn-sm edit-btn"
                          data-id="{{this.id}}"
                          data-name="{{this.name}}"
                          data-email="{{this.email}}">
                    <i class="fa-solid fa-pen text-xs"></i> Edit
                  </button>
                  <button class="btn btn-danger btn-sm delete-btn"
                          data-id="{{this.id}}"
                          data-name="{{this.name}}">
                    <i class="fa-solid fa-trash text-xs"></i> Delete
                  </button>
                </div>
              </td>
            </tr>
            {{else}}
            <tr>
              <td colspan="5" class="text-center py-12 text-gray-400">
                <i class="fa-solid fa-user-tie text-3xl mb-3 block text-gray-300"></i>
                No staff accounts yet.
                <button onclick="openCreateModal()" class="block mx-auto mt-3 text-teal-600 font-semibold text-sm hover:text-teal-700 transition-colors">
                  + Create the first staff account
                </button>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

    </div>
  </main>
</div>

<!-- ── Create Staff Modal ── -->
<div id="createModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4"
     style="background: rgba(15,23,42,.6); backdrop-filter: blur(4px);">
  <div class="bg-white rounded-3xl shadow-2xl max-w-md w-full p-8 animate-fade-in-up">
    <div class="flex items-center gap-3 mb-6">
      <div class="w-11 h-11 rounded-2xl flex items-center justify-center flex-shrink-0"
           style="background: linear-gradient(135deg,#0d9488,#0891b2);">
        <i class="fa-solid fa-user-plus text-white"></i>
      </div>
      <div>
        <h3 class="text-lg font-bold text-gray-900">Add Staff Account</h3>
        <p class="text-xs text-gray-500">Create a new staff login</p>
      </div>
    </div>

    <div id="create-error" class="hidden alert alert-error mb-4"></div>

    <form id="createForm" class="space-y-4">
      <div>
        <label class="label">Full Name</label>
        <div class="relative">
          <i class="fa-solid fa-user absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
          <input type="text" id="create-name" placeholder="e.g. Maria Santos" class="input pl-10" required />
        </div>
      </div>
      <div>
        <label class="label">Email Address</label>
        <div class="relative">
          <i class="fa-solid fa-envelope absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
          <input type="email" id="create-email" placeholder="staff@rjmbeach.com" class="input pl-10" required />
        </div>
      </div>
      <div>
        <label class="label">Password</label>
        <div class="relative">
          <i class="fa-solid fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
          <input type="password" id="create-password" placeholder="Min. 6 characters" class="input pl-10" required />
        </div>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="button" onclick="closeCreateModal()"
                class="flex-1 px-4 py-2.5 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold text-sm transition-colors">
          Cancel
        </button>
        <button type="submit" id="create-btn" class="btn btn-primary flex-1">
          <i class="fa-solid fa-user-plus text-xs"></i> Create Account
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ── Edit Staff Modal ── -->
<div id="editModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4"
     style="background: rgba(15,23,42,.6); backdrop-filter: blur(4px);">
  <div class="bg-white rounded-3xl shadow-2xl max-w-md w-full p-8 animate-fade-in-up">
    <div class="flex items-center gap-3 mb-6">
      <div class="w-11 h-11 rounded-2xl flex items-center justify-center flex-shrink-0"
           style="background: linear-gradient(135deg,#0d9488,#0891b2);">
        <i class="fa-solid fa-pen text-white"></i>
      </div>
      <div>
        <h3 class="text-lg font-bold text-gray-900">Edit Staff Account</h3>
        <p class="text-xs text-gray-500">Update name, email, or password</p>
      </div>
    </div>

    <div id="edit-error" class="hidden alert alert-error mb-4"></div>

    <form id="editForm" class="space-y-4">
      <input type="hidden" id="edit-id" />
      <div>
        <label class="label">Full Name</label>
        <div class="relative">
          <i class="fa-solid fa-user absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
          <input type="text" id="edit-name" class="input pl-10" required />
        </div>
      </div>
      <div>
        <label class="label">Email Address</label>
        <div class="relative">
          <i class="fa-solid fa-envelope absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
          <input type="email" id="edit-email" class="input pl-10" required />
        </div>
      </div>
      <div>
        <label class="label">New Password <span class="text-gray-400 font-normal">(leave blank to keep current)</span></label>
        <div class="relative">
          <i class="fa-solid fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
          <input type="password" id="edit-password" placeholder="Leave blank to keep current" class="input pl-10" />
        </div>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="button" onclick="closeEditModal()"
                class="flex-1 px-4 py-2.5 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold text-sm transition-colors">
          Cancel
        </button>
        <button type="submit" id="edit-btn" class="btn btn-primary flex-1">
          <i class="fa-solid fa-floppy-disk text-xs"></i> Save Changes
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ── Delete Confirmation Modal ── -->
<div id="deleteModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4"
     style="background: rgba(15,23,42,.6); backdrop-filter: blur(4px);">
  <div class="bg-white rounded-3xl shadow-2xl max-w-sm w-full p-8 animate-fade-in-up">
    <div class="flex items-center gap-3 mb-4">
      <div class="w-11 h-11 rounded-2xl flex items-center justify-center flex-shrink-0 bg-red-100">
        <i class="fa-solid fa-trash text-red-600"></i>
      </div>
      <div>
        <h3 class="text-lg font-bold text-gray-900">Delete Staff Account</h3>
        <p class="text-xs text-gray-500" id="delete-name-label">This action cannot be undone.</p>
      </div>
    </div>
    <p class="text-sm text-gray-600 mb-6">
      Are you sure you want to delete the account for <strong id="delete-staff-name"></strong>? They will no longer be able to log in.
    </p>
    <div class="flex gap-3">
      <button onclick="closeDeleteModal()"
              class="flex-1 px-4 py-2.5 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold text-sm transition-colors">
        Cancel
      </button>
      <button id="confirm-delete-btn"
              class="flex-1 btn btn-danger">
        <i class="fa-solid fa-trash text-xs"></i> Delete
      </button>
    </div>
  </div>
</div>

<!-- Toast container -->
<div id="toastContainer" class="fixed top-5 right-5 z-[300] space-y-3"></div>

<!-- Logout Confirmation Modal -->
<div id="logoutConfirmModal"
     class="hidden fixed inset-0 z-[500] flex items-center justify-center p-4"
     style="background: rgba(15,23,42,.65); backdrop-filter: blur(6px);">
  <div class="bg-white rounded-3xl shadow-2xl max-w-sm w-full p-8 animate-fade-in-up">
    <div class="flex items-center gap-4 mb-5">
      <div class="w-12 h-12 rounded-2xl flex items-center justify-center flex-shrink-0"
           style="background: linear-gradient(135deg,#fef3c7,#fde68a);">
        <i class="fa-solid fa-right-from-bracket text-amber-600 text-lg"></i>
      </div>
      <div>
        <h3 class="text-lg font-bold text-gray-900">Sign Out?</h3>
        <p class="text-sm text-gray-500">You'll need to sign in again to access your account.</p>
      </div>
    </div>
    <div class="flex gap-3 mt-6">
      <button id="logoutConfirmNo"
              class="flex-1 px-4 py-2.5 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold text-sm transition-colors">
        Cancel
      </button>
      <button id="logoutConfirmYes"
              class="flex-1 px-4 py-2.5 rounded-xl font-semibold text-sm text-white transition-all"
              style="background: linear-gradient(135deg,#dc2626,#ef4444); box-shadow: 0 4px 12px rgba(220,38,38,.3);">
        Sign Out
      </button>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {

  // ── Sidebar ──
  var toggle  = document.getElementById('sidebar-toggle');
  var sidebar = document.getElementById('admin-sidebar');
  if (toggle && sidebar) {
    toggle.addEventListener('click', function() { sidebar.classList.toggle('-translate-x-full'); });
    document.addEventListener('click', function(e) {
      if (window.innerWidth < 768 && !sidebar.contains(e.target) && !toggle.contains(e.target))
        sidebar.classList.add('-translate-x-full');
    });
  }

  // ── Logout functionality ──
  var _logoutCb = null;

  window.showLogoutConfirmation = function (cb) {
    _logoutCb = cb;
    var m = document.getElementById('logoutConfirmModal');
    if (m) m.classList.remove('hidden');
  };

  window.confirmAdminLogout = function () {
    showLogoutConfirmation(function () {
      window.location.href = '/logout';
    });
  };

  function closeLogoutModal() {
    var modal = document.getElementById('logoutConfirmModal');
    if (modal) modal.classList.add('hidden');
    _logoutCb = null;
  }

  // Wire up logout button
  var logoutBtn = document.getElementById('adminLogoutBtn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', window.confirmAdminLogout);
  }
  var logoutYes = document.getElementById('logoutConfirmYes');
  var logoutNo = document.getElementById('logoutConfirmNo');
  var logoutModal = document.getElementById('logoutConfirmModal');
  if (logoutYes) logoutYes.addEventListener('click', function() { if (_logoutCb) _logoutCb(); });
  if (logoutNo) logoutNo.addEventListener('click', closeLogoutModal);
  if (logoutModal) logoutModal.addEventListener('click', function(e) { if (e.target === logoutModal) closeLogoutModal(); });

  // ── Toast ──
  window.showToast = function (msg, type) {
    type = type || 'success';
    var c = document.getElementById('toastContainer');
    var el = document.createElement('div');
    var colors = { success:'#0d9488', error:'#ef4444', info:'#3b82f6' };
    var color = colors[type] || colors.success;
    var icon = type==='success' ? 'fa-circle-check' : type==='error' ? 'fa-circle-xmark' : 'fa-circle-info';
    el.innerHTML = '<div style="background:#fff;border-left:4px solid '+color+';border-radius:14px;padding:12px 16px;box-shadow:0 8px 24px rgba(0,0,0,.12);display:flex;align-items:center;gap:10px;font-size:14px;font-weight:500;min-width:260px;"><i class="fa-solid '+icon+'" style="color:'+color+';"></i><span>'+msg+'</span></div>';
    c.appendChild(el);
    setTimeout(function(){ el.remove(); }, 3500);
  };

  // ── Create Modal ──
  window.openCreateModal = function () {
    document.getElementById('createForm').reset();
    document.getElementById('create-error').classList.add('hidden');
    document.getElementById('create-btn').disabled = false;
    document.getElementById('create-btn').innerHTML = '<i class="fa-solid fa-user-plus text-xs"></i> Create Account';
    document.getElementById('createModal').classList.remove('hidden');
  };
  window.closeCreateModal = function () {
    document.getElementById('createModal').classList.add('hidden');
  };
  document.getElementById('createModal').addEventListener('click', function(e) {
    if (e.target === this) window.closeCreateModal();
  });
  document.getElementById('createForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    var errEl = document.getElementById('create-error');
    var btn   = document.getElementById('create-btn');
    errEl.classList.add('hidden');
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin text-xs"></i> Creating...';
    var body = {
      name:     document.getElementById('create-name').value.trim(),
      email:    document.getElementById('create-email').value.trim(),
      password: document.getElementById('create-password').value
    };
    try {
      var res  = await fetch('/admin/staff', { method:'POST', headers:{'Content-Type':'application/json','Accept':'application/json'}, body: JSON.stringify(body) });
      var data = await res.json();
      if (data.success) {
        window.closeCreateModal();
        window.showToast('Staff account for ' + data.staff.name + ' created.');
        addStaffRow(data.staff);
        updateStaffCount(1);
      } else {
        errEl.innerHTML = '<i class="fa-solid fa-circle-xmark"></i> ' + data.error;
        errEl.classList.remove('hidden');
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-user-plus text-xs"></i> Create Account';
      }
    } catch(err) {
      errEl.innerHTML = '<i class="fa-solid fa-circle-xmark"></i> ' + err.message;
      errEl.classList.remove('hidden');
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-user-plus text-xs"></i> Create Account';
    }
  });

  // ── Edit Modal ──
  window.openEditModal = function (id, name, email) {
    document.getElementById('edit-id').value       = id;
    document.getElementById('edit-name').value     = name;
    document.getElementById('edit-email').value    = email;
    document.getElementById('edit-password').value = '';
    document.getElementById('edit-error').classList.add('hidden');
    document.getElementById('edit-btn').disabled = false;
    document.getElementById('edit-btn').innerHTML = '<i class="fa-solid fa-floppy-disk text-xs"></i> Save Changes';
    document.getElementById('editModal').classList.remove('hidden');
  };
  window.closeEditModal = function () {
    document.getElementById('editModal').classList.add('hidden');
  };
  document.getElementById('editModal').addEventListener('click', function(e) {
    if (e.target === this) window.closeEditModal();
  });
  document.getElementById('editForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    var errEl = document.getElementById('edit-error');
    var btn   = document.getElementById('edit-btn');
    errEl.classList.add('hidden');
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin text-xs"></i> Saving...';
    var id   = document.getElementById('edit-id').value;
    var pw   = document.getElementById('edit-password').value;
    var body = {
      name:  document.getElementById('edit-name').value.trim(),
      email: document.getElementById('edit-email').value.trim()
    };
    if (pw) body.password = pw;
    try {
      var res  = await fetch('/admin/staff/' + id, { method:'PUT', headers:{'Content-Type':'application/json','Accept':'application/json'}, body: JSON.stringify(body) });
      var data = await res.json();
      if (data.success) {
        window.closeEditModal();
        window.showToast('Staff account updated.');
        updateStaffRow(id, body.name, body.email);
      } else {
        errEl.innerHTML = '<i class="fa-solid fa-circle-xmark"></i> ' + data.error;
        errEl.classList.remove('hidden');
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-floppy-disk text-xs"></i> Save Changes';
      }
    } catch(err) {
      errEl.innerHTML = '<i class="fa-solid fa-circle-xmark"></i> ' + err.message;
      errEl.classList.remove('hidden');
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-floppy-disk text-xs"></i> Save Changes';
    }
  });

  // ── Table button delegation (edit/delete) ──
  document.querySelector('.nb-table tbody').addEventListener('click', function(e) {
    var editBtn  = e.target.closest('.edit-btn');
    var deleteBtn = e.target.closest('.delete-btn');
    if (editBtn) {
      window.openEditModal(editBtn.dataset.id, editBtn.dataset.name, editBtn.dataset.email);
    } else if (deleteBtn) {
      window.deleteStaff(deleteBtn.dataset.id, deleteBtn.dataset.name);
    }
  });
  window.deleteStaff = function (id, name) {
    _deleteId = id;
    document.getElementById('delete-staff-name').textContent = name;
    document.getElementById('confirm-delete-btn').disabled = false;
    document.getElementById('confirm-delete-btn').innerHTML = '<i class="fa-solid fa-trash text-xs"></i> Delete';
    document.getElementById('deleteModal').classList.remove('hidden');
  };
  window.closeDeleteModal = function () {
    document.getElementById('deleteModal').classList.add('hidden');
    _deleteId = null;
  };
  document.getElementById('deleteModal').addEventListener('click', function(e) {
    if (e.target === this) window.closeDeleteModal();
  });
  document.getElementById('confirm-delete-btn').addEventListener('click', async function() {
    if (!_deleteId) return;
    var btn = document.getElementById('confirm-delete-btn');
    var idToDelete = _deleteId;
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin text-xs"></i> Deleting...';
    try {
      var res  = await fetch('/admin/staff/' + idToDelete, { method:'DELETE', headers:{'Accept':'application/json'} });
      var data = await res.json();
      if (data.success) {
        window.closeDeleteModal();
        window.showToast('Staff account deleted.', 'info');
        removeStaffRow(idToDelete);
        updateStaffCount(-1);
      } else {
        window.showToast(data.error || 'Delete failed.', 'error');
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-trash text-xs"></i> Delete';
      }
    } catch(err) {
      window.showToast(err.message, 'error');
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-trash text-xs"></i> Delete';
    }
  });

  // ── DOM helpers ──
  function updateStaffCount(delta) {
    var el = document.querySelector('.stat-card .text-2xl');
    if (el) el.textContent = (parseInt(el.textContent) || 0) + delta;
  }

  function addStaffRow(staff) {
    var tbody = document.querySelector('.nb-table tbody');
    var empty = tbody.querySelector('td[colspan]');
    if (empty) empty.closest('tr').remove();
    var initial = (staff.name || '?')[0].toUpperCase();
    var safeN = (staff.name || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'");
    var safeE = (staff.email || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'");
    var tr = document.createElement('tr');
    tr.setAttribute('data-staff-id', staff.id);
    tr.innerHTML =
      '<td><div class="flex items-center gap-3">' +
        '<div class="w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold text-white flex-shrink-0" style="background:linear-gradient(135deg,#0d9488,#0891b2);">' + initial + '</div>' +
        '<div><p class="font-semibold text-gray-800 text-sm staff-name">' + staff.name + '</p><p class="text-xs text-gray-400">#' + staff.id + '</p></div>' +
      '</div></td>' +
      '<td class="text-sm text-gray-600 staff-email">' + staff.email + '</td>' +
      '<td><span class="badge badge-teal text-xs">Staff</span></td>' +
      '<td class="text-sm text-gray-500">' + new Date().toLocaleString() + '</td>' +
      '<td><div class="flex items-center justify-center gap-2">' +
        '<button class="btn btn-secondary btn-sm edit-btn" data-id="' + staff.id + '" data-name="' + staff.name.replace(/"/g, '&quot;') + '" data-email="' + staff.email.replace(/"/g, '&quot;') + '"><i class="fa-solid fa-pen text-xs"></i> Edit</button>' +
        '<button class="btn btn-danger btn-sm delete-btn" data-id="' + staff.id + '" data-name="' + staff.name.replace(/"/g, '&quot;') + '"><i class="fa-solid fa-trash text-xs"></i> Delete</button>' +
      '</div></td>';
    tbody.prepend(tr);
  }

  function updateStaffRow(id, name, email) {
    var tr = document.querySelector('tr[data-staff-id="' + id + '"]');
    if (!tr) return;
    var nameEl   = tr.querySelector('.staff-name');
    var emailEl  = tr.querySelector('.staff-email');
    var avatarEl = tr.querySelector('.w-9.h-9');
    if (nameEl && name)   nameEl.textContent  = name;
    if (emailEl && email) emailEl.textContent = email;
    if (avatarEl && name) avatarEl.textContent = name[0].toUpperCase();
    var editBtn = tr.querySelector('.edit-btn');
    var delBtn  = tr.querySelector('.delete-btn');
    if (editBtn) { editBtn.dataset.name = name; editBtn.dataset.email = email; }
    if (delBtn)  { delBtn.dataset.name = name; }
  }

  function removeStaffRow(id) {
    var tr = document.querySelector('tr[data-staff-id="' + id + '"]');
    if (tr) tr.remove();
    var tbody = document.querySelector('.nb-table tbody');
    if (tbody && tbody.querySelectorAll('tr').length === 0) {
      tbody.innerHTML = '<tr><td colspan="5" class="text-center py-12 text-gray-400"><i class="fa-solid fa-user-tie text-3xl mb-3 block text-gray-300"></i><br>No staff accounts yet.<br><button onclick="openCreateModal()" class="mt-3 text-teal-600 font-semibold text-sm">+ Create the first staff account</button></td></tr>';
    }
  }

}); // end DOMContentLoaded
</script>
