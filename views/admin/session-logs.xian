{{> head }}
<body class="font-body">
{{> adminSidebar }}

    <!-- ── Page Content ── -->
    <div class="flex-1 overflow-auto p-6" style="background:#f8fafc;">

      <!-- ── Stat Cards ── -->
      <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4 mb-6">

        <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
          <div class="flex items-center justify-between mb-3">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background:#f0f9ff;">
              <i class="fa-solid fa-clock-rotate-left text-blue-500"></i>
            </div>
            <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Total</span>
          </div>
          <p class="text-2xl font-bold text-gray-800">{{stats.totalCount}}</p>
          <p class="text-sm text-gray-500 mt-0.5">All Events</p>
        </div>

        <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
          <div class="flex items-center justify-between mb-3">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background:#f0fdf4;">
              <i class="fa-solid fa-right-to-bracket text-emerald-500"></i>
            </div>
            <span class="text-xs font-semibold text-emerald-500 uppercase tracking-wider">Login</span>
          </div>
          <p class="text-2xl font-bold text-gray-800">{{stats.loginCount}}</p>
          <p class="text-sm text-gray-500 mt-0.5">Logins</p>
        </div>

        <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
          <div class="flex items-center justify-between mb-3">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background:#f8fafc;">
              <i class="fa-solid fa-right-from-bracket text-gray-500"></i>
            </div>
            <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Logout</span>
          </div>
          <p class="text-2xl font-bold text-gray-800">{{stats.logoutCount}}</p>
          <p class="text-sm text-gray-500 mt-0.5">Logouts</p>
        </div>

        <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
          <div class="flex items-center justify-between mb-3">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background:#fef2f2;">
              <i class="fa-solid fa-ban text-red-500"></i>
            </div>
            <span class="text-xs font-semibold text-red-500 uppercase tracking-wider">Failed</span>
          </div>
          <p class="text-2xl font-bold text-gray-800">{{stats.failedCount}}</p>
          <p class="text-sm text-gray-500 mt-0.5">Failed Logins</p>
        </div>

        <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
          <div class="flex items-center justify-between mb-3">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background:#fffbeb;">
              <i class="fa-solid fa-hourglass-end text-amber-500"></i>
            </div>
            <span class="text-xs font-semibold text-amber-500 uppercase tracking-wider">Expired</span>
          </div>
          <p class="text-2xl font-bold text-gray-800">{{stats.expiredCount}}</p>
          <p class="text-sm text-gray-500 mt-0.5">Expired Sessions</p>
        </div>

        <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
          <div class="flex items-center justify-between mb-3">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background:#fdf4ff;">
              <i class="fa-solid fa-users text-purple-500"></i>
            </div>
            <span class="text-xs font-semibold text-purple-500 uppercase tracking-wider">Active</span>
          </div>
          <p class="text-2xl font-bold text-gray-800">{{stats.activeUsersCount}}</p>
          <p class="text-sm text-gray-500 mt-0.5">Users (24h)</p>
        </div>

      </div>

      <!-- ── Filters ── -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 mb-6">
        <form method="GET" action="/admin/session-logs" class="flex flex-wrap gap-3 items-end">

          <div class="flex flex-col gap-1 min-w-[160px]">
            <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Search</label>
            <input type="text" name="search" value="{{filters.search}}"
                   placeholder="User, email, IP…"
                   class="border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-transparent" />
          </div>

          <div class="flex flex-col gap-1">
            <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Event</label>
            <select name="event" class="border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-400">
              <option value="">All Events</option>
              <option value="login"          {{#if (eq filters.event "login")}}selected{{/if}}>Login</option>
              <option value="logout"         {{#if (eq filters.event "logout")}}selected{{/if}}>Logout</option>
              <option value="login_failed"   {{#if (eq filters.event "login_failed")}}selected{{/if}}>Login Failed</option>
              <option value="session_expired"{{#if (eq filters.event "session_expired")}}selected{{/if}}>Session Expired</option>
              <option value="forced_logout"  {{#if (eq filters.event "forced_logout")}}selected{{/if}}>Forced Logout</option>
            </select>
          </div>

          <div class="flex flex-col gap-1">
            <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Role</label>
            <select name="role" class="border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-400">
              <option value="">All Roles</option>
              <option value="admin" {{#if (eq filters.role "admin")}}selected{{/if}}>Admin</option>
              <option value="staff" {{#if (eq filters.role "staff")}}selected{{/if}}>Staff</option>
              <option value="user"  {{#if (eq filters.role "user")}}selected{{/if}}>Guest</option>
            </select>
          </div>

          <div class="flex flex-col gap-1">
            <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider">From</label>
            <input type="date" name="from" value="{{filters.from}}"
                   class="border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-400" />
          </div>

          <div class="flex flex-col gap-1">
            <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider">To</label>
            <input type="date" name="to" value="{{filters.to}}"
                   class="border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-400" />
          </div>

          <button type="submit"
                  class="px-5 py-2 rounded-xl text-sm font-semibold text-white transition-all"
                  style="background: linear-gradient(135deg,#0d9488,#0891b2);">
            <i class="fa-solid fa-magnifying-glass mr-1.5"></i>Filter
          </button>

          <a href="/admin/session-logs"
             class="px-5 py-2 rounded-xl text-sm font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 transition-colors">
            <i class="fa-solid fa-xmark mr-1.5"></i>Clear
          </a>
        </form>
      </div>

      <!-- ── Table ── -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
          <div>
            <h3 class="text-base font-bold text-gray-800">Session Events</h3>
            <p class="text-xs text-gray-400 mt-0.5">
              Showing {{pagination.totalCount}} entr{{#if (eq pagination.totalCount 1)}}y{{else}}ies{{/if}}
              — page {{pagination.page}} of {{pagination.totalPages}}
            </p>
          </div>
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-shield-halved text-teal-500"></i>
            <span class="text-xs font-semibold text-gray-500">Admin-only view</span>
          </div>
        </div>

        {{#if logs.length}}
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-gray-50 border-b border-gray-100 text-left">
                <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider whitespace-nowrap">When</th>
                <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">User</th>
                <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Email</th>
                <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Event</th>
                <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">IP Address</th>
                <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Duration</th>
                <th class="px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Result</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
              {{#each logs}}
              <tr class="hover:bg-gray-50 transition-colors">

                <!-- When -->
                <td class="px-4 py-3 whitespace-nowrap">
                  <p class="text-xs font-medium text-gray-700">{{formatDate this.createdAt}}</p>
                </td>

                <!-- User -->
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2">
                    <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold text-white flex-shrink-0"
                         style="background: linear-gradient(135deg,#6366f1,#8b5cf6);">
                      {{#if this.userName}}{{this.userName.[0]}}{{else}}?{{/if}}
                    </div>
                    <div>
                      <p class="font-medium text-gray-800 text-xs">{{#if this.userName}}{{this.userName}}{{else}}<span class="text-gray-400 italic">unknown</span>{{/if}}</p>
                      <span class="inline-block text-[10px] px-1.5 py-0.5 rounded font-semibold
                        {{#if (eq this.role 'admin')}}bg-purple-100 text-purple-700
                        {{else if (eq this.role 'staff')}}bg-blue-100 text-blue-700
                        {{else}}bg-gray-100 text-gray-600{{/if}}">
                        {{#if this.role}}{{this.role}}{{else}}—{{/if}}
                      </span>
                    </div>
                  </div>
                </td>

                <!-- Email -->
                <td class="px-4 py-3">
                  <span class="text-xs text-gray-500 font-mono">
                    {{#if this.email}}{{this.email}}{{else}}<span class="text-gray-300">—</span>{{/if}}
                  </span>
                </td>

                <!-- Event badge -->
                <td class="px-4 py-3 whitespace-nowrap">
                  {{#if (eq this.event "login")}}
                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full">
                      <i class="fa-solid fa-right-to-bracket text-[10px]"></i> Login
                    </span>
                  {{else if (eq this.event "logout")}}
                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-gray-600 bg-gray-100 px-2.5 py-1 rounded-full">
                      <i class="fa-solid fa-right-from-bracket text-[10px]"></i> Logout
                    </span>
                  {{else if (eq this.event "login_failed")}}
                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-red-700 bg-red-50 px-2.5 py-1 rounded-full">
                      <i class="fa-solid fa-ban text-[10px]"></i> Failed
                    </span>
                  {{else if (eq this.event "session_expired")}}
                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-amber-700 bg-amber-50 px-2.5 py-1 rounded-full">
                      <i class="fa-solid fa-hourglass-end text-[10px]"></i> Expired
                    </span>
                  {{else}}
                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-orange-700 bg-orange-50 px-2.5 py-1 rounded-full">
                      <i class="fa-solid fa-bolt text-[10px]"></i> {{this.event}}
                    </span>
                  {{/if}}
                </td>

                <!-- IP -->
                <td class="px-4 py-3">
                  <span class="text-xs font-mono text-gray-500">
                    {{#if this.ipAddress}}{{this.ipAddress}}{{else}}<span class="text-gray-300">—</span>{{/if}}
                  </span>
                </td>

                <!-- Duration -->
                <td class="px-4 py-3 whitespace-nowrap">
                  {{#if this.duration}}
                    <span class="text-xs text-gray-600">
                      {{#if (gt this.duration 3600)}}
                        {{divide this.duration 3600}}h
                      {{else if (gt this.duration 60)}}
                        {{divide this.duration 60}}m
                      {{else}}
                        {{this.duration}}s
                      {{/if}}
                    </span>
                  {{else}}
                    <span class="text-xs text-gray-300">—</span>
                  {{/if}}
                </td>

                <!-- Result -->
                <td class="px-4 py-3">
                  {{#if this.success}}
                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full">
                      <i class="fa-solid fa-circle-check text-[10px]"></i> OK
                    </span>
                  {{else}}
                    <div>
                      <span class="inline-flex items-center gap-1 text-xs font-semibold text-red-700 bg-red-50 px-2.5 py-1 rounded-full">
                        <i class="fa-solid fa-circle-xmark text-[10px]"></i> Failed
                      </span>
                      {{#if this.failureReason}}
                        <p class="text-[10px] text-gray-400 mt-1 max-w-[160px] truncate" title="{{this.failureReason}}">{{this.failureReason}}</p>
                      {{/if}}
                    </div>
                  {{/if}}
                </td>

              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        {{#if (gt pagination.totalPages 1)}}
        <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-between">
          <p class="text-xs text-gray-400">
            Page {{pagination.page}} of {{pagination.totalPages}}
          </p>
          <div class="flex items-center gap-2">
            {{#if pagination.hasPrev}}
              <a href="?page={{pagination.prevPage}}&event={{filters.event}}&role={{filters.role}}&from={{filters.from}}&to={{filters.to}}&search={{filters.search}}"
                 class="px-4 py-2 rounded-xl text-xs font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 transition-colors">
                <i class="fa-solid fa-chevron-left mr-1"></i>Prev
              </a>
            {{/if}}
            {{#if pagination.hasNext}}
              <a href="?page={{pagination.nextPage}}&event={{filters.event}}&role={{filters.role}}&from={{filters.from}}&to={{filters.to}}&search={{filters.search}}"
                 class="px-4 py-2 rounded-xl text-xs font-semibold text-white transition-all"
                 style="background: linear-gradient(135deg,#0d9488,#0891b2);">
                Next<i class="fa-solid fa-chevron-right ml-1"></i>
              </a>
            {{/if}}
          </div>
        </div>
        {{/if}}

        {{else}}
        <!-- Empty state -->
        <div class="flex flex-col items-center justify-center py-20 text-center px-6">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mb-4"
               style="background: linear-gradient(135deg,#f0f9ff,#e0f2fe);">
            <i class="fa-solid fa-clock-rotate-left text-blue-400 text-2xl"></i>
          </div>
          <h4 class="text-base font-bold text-gray-700 mb-1">No session events yet</h4>
          <p class="text-sm text-gray-400 max-w-xs">Login, logout, and authentication events will appear here once users start signing in.</p>
          {{#if filters.search}}
          <a href="/admin/session-logs" class="mt-4 text-sm text-teal-600 hover:underline">Clear filters</a>
          {{/if}}
        </div>
        {{/if}}
      </div>

    </div><!-- /content -->
  </main>
</div><!-- /flex wrapper -->

{{> footer }}
