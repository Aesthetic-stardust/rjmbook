  {{> head }}
<body class="font-body">
<div class="flex h-screen overflow-hidden" style="background:#f1f5f9;">

  <!-- ── Sidebar ── -->
  <aside id="admin-sidebar"
         class="flex-shrink-0 w-64 flex flex-col fixed md:relative top-0 left-0 h-screen z-40 transition-transform duration-300"
         style="background: linear-gradient(180deg,#0f172a 0%,#134e4a 100%); box-shadow: 4px 0 24px rgba(0,0,0,.18);">
    <div class="px-6 py-6 border-b" style="border-color: rgba(255,255,255,.08);">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0"
             style="background: linear-gradient(135deg,#0d9488,#0891b2);">
        </div>
        <div>
          <h1 class="text-lg font-bold text-white font-display leading-none">RJMBook</h1>
          <p class="text-xs mt-0.5" style="color: rgba(255,255,255,.4);">RJM Beach Resort</p>
        </div>
      </div>
    </div>
    <nav class="flex-1 px-3 py-5 space-y-0.5 overflow-y-auto">
      <p class="text-xs font-semibold uppercase tracking-widest px-3 mb-3" style="color: rgba(255,255,255,.3);">Management</p>
      <a href="/admin"              class="sidebar-link"><i class="fa-solid fa-gauge w-4 text-center flex-shrink-0"></i><span>Dashboard</span></a>
      <a href="/admin/reservations" class="sidebar-link"><i class="fa-solid fa-calendar-days w-4 text-center flex-shrink-0"></i><span>Reservations</span></a>
      <a href="/admin/book"         class="sidebar-link"><i class="fa-solid fa-calendar-plus w-4 text-center flex-shrink-0"></i><span>Walk-in Booking</span></a>
      <a href="/admin/reservation-calendar" class="sidebar-link"><i class="fa-solid fa-calendar w-4 text-center flex-shrink-0"></i><span>Reservation Calendar</span></a>
      <a href="/admin/room-availability" class="sidebar-link"><i class="fa-solid fa-door-open w-4 text-center flex-shrink-0"></i><span>Room Availability</span></a>
      <a href="/admin/rooms"        class="sidebar-link"><i class="fa-solid fa-bed w-4 text-center flex-shrink-0"></i><span>Rooms</span></a>
      <a href="/admin/cottages"     class="sidebar-link"><i class="fa-solid fa-umbrella-beach w-4 text-center flex-shrink-0"></i><span>Cottages</span></a>
      <a href="/guests"             class="sidebar-link"><i class="fa-solid fa-users w-4 text-center flex-shrink-0"></i><span>Guests</span></a>
      <div class="my-3 border-t" style="border-color: rgba(255,255,255,.07);"></div>
      <p class="text-xs font-semibold uppercase tracking-widest px-3 mb-3" style="color: rgba(255,255,255,.3);">Analytics</p>
      <a href="/dashboard"                class="sidebar-link active"><i class="fa-solid fa-chart-pie w-4 text-center flex-shrink-0"></i><span>Analytics</span></a>
      <a href="/admin/reports"            class="sidebar-link"><i class="fa-solid fa-file-chart-column w-4 text-center flex-shrink-0"></i><span>Reports</span></a>
      <a href="/admin/sentiment-analysis" class="sidebar-link"><i class="fa-solid fa-brain w-4 text-center flex-shrink-0"></i><span>Sentiment Analysis</span></a>
      <div class="my-3 border-t" style="border-color: rgba(255,255,255,.07);"></div>
      <p class="text-xs font-semibold uppercase tracking-widest px-3 mb-3" style="color: rgba(255,255,255,.3);">Account</p>
      <a href="/admin/payment-settings" class="sidebar-link"><i class="fa-solid fa-peso-sign w-4 text-center flex-shrink-0"></i><span>Payment Settings</span></a>
      <a href="/admin/staff"        class="sidebar-link"><i class="fa-solid fa-user-tie w-4 text-center flex-shrink-0"></i><span>Manage Staff</span></a>
      <a href="/account"            class="sidebar-link"><i class="fa-solid fa-user-gear w-4 text-center flex-shrink-0"></i><span>Account Settings</span></a>
    </nav>
    <div class="px-3 py-4 border-t" style="border-color: rgba(255,255,255,.08);">
      <div class="flex items-center gap-3 px-3 py-3 rounded-xl mb-3" style="background: rgba(255,255,255,.06);">
        <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold text-white flex-shrink-0"
             style="background: linear-gradient(135deg,#0d9488,#0891b2);">
          {{#if sessionUserName}}{{sessionUserName.[0]}}{{else}}A{{/if}}
        </div>
        <div class="min-w-0">
          <p class="text-xs text-white font-semibold truncate">{{sessionUserName}}</p>
          <p class="text-xs" style="color: rgba(255,255,255,.4);">Administrator</p>
        </div>
      </div>
      <button id="adminLogoutBtn"
              class="w-full flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl text-sm font-semibold text-white transition-all cursor-pointer border-none"
              style="background: rgba(220,38,38,.2); border: 1px solid rgba(220,38,38,.3);"
>
        <i class="fa-solid fa-right-from-bracket text-red-400"></i>
        <span class="text-red-300">Sign Out</span>
      </button>
    </div>
  </aside>

  <!-- ── Main ── -->
  <main class="flex-1 flex flex-col overflow-hidden">

    <!-- Top Header -->
    <header class="flex-shrink-0 flex items-center justify-between px-6 py-4 bg-white border-b border-gray-200" style="box-shadow: 0 1px 8px rgba(0,0,0,.06);">
      <div class="flex items-center gap-4">
        <button id="sidebar-toggle" class="md:hidden p-2 rounded-lg text-gray-500 hover:bg-gray-100 transition-colors">
          <i class="fa-solid fa-bars"></i>
        </button>
        <div>
          <h2 class="text-xl font-bold text-gray-800">ML Analytics Dashboard</h2>
          <p class="text-xs text-gray-500 mt-0.5">Occupancy forecasting and AI recommendations</p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <div class="hidden sm:block text-right">
          <p class="text-xs text-gray-500">Welcome back,</p>
          <p class="text-sm font-semibold text-gray-800">{{sessionUserName}}</p>
        </div>
        <div class="w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold text-white"
             style="background: linear-gradient(135deg,#0d9488,#0891b2);">
          {{#if sessionUserName}}{{sessionUserName.[0]}}{{else}}A{{/if}}
        </div>
      </div>
    </header>

    <!-- Page Content -->
    <div class="flex-1 overflow-auto p-6" style="background:#f8fafc;">

      <!-- Filter Section -->
      <div class="card p-6 mb-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="icon-box bg-teal-100"><i class="fa-solid fa-sliders text-teal-600"></i></div>
          <h3 class="text-base font-bold text-gray-800">Filters</h3>
        </div>
        <div class="grid md:grid-cols-3 gap-4">
          <div>
            <label class="label">Date Range</label>
            <select id="dateRange" class="input w-full">
              <option value="7"  {{#if (eq selectedRange "7")}}selected{{/if}}>Last 7 days</option>
              <option value="14" {{#if (eq selectedRange "14")}}selected{{/if}}>Last 14 days</option>
              <option value="30" {{#if (eq selectedRange "30")}}selected{{/if}}>Last 30 days</option>
              <option value="all" {{#if (eq selectedRange "all")}}selected{{/if}}>All time</option>
            </select>
          </div>
          <div>
            <label class="label">Room Type</label>
            <select id="roomTypeFilter" class="input w-full">
              <option value="">All Types</option>
              {{#each roomTypes}}
              <option value="{{this.id}}">{{this.name}}</option>
              {{/each}}
            </select>
          </div>
          <div>
            <label class="label">Status</label>
            <select id="statusFilter" class="input w-full">
              <option value="">All Statuses</option>
              <option value="pending">Pending</option>
              <option value="confirmed">Confirmed</option>
              <option value="checked_in">Checked In</option>
              <option value="checked_out">Checked Out</option>
              <option value="cancelled">Cancelled</option>
            </select>
          </div>
        </div>
      </div>

      <!-- KPI Cards -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 mb-6 stagger">
        <div class="stat-card animate-fade-in-up" style="border-top-color:#0d9488;">
          <div class="flex items-start justify-between mb-3">
            <div class="icon-box bg-teal-100"><i class="fa-solid fa-bed text-teal-600"></i></div>
            <span class="badge badge-teal text-xs">Total</span>
          </div>
          <p class="text-3xl font-bold text-gray-800 mb-1">{{totalRooms}}</p>
          <p class="text-sm text-gray-500 font-medium">Total Rooms</p>
        </div>

        <div class="stat-card animate-fade-in-up" style="border-top-color:#22c55e;">
          <div class="flex items-start justify-between mb-3">
            <div class="icon-box bg-green-100"><i class="fa-solid fa-chart-pie text-green-600"></i></div>
            <span class="badge badge-success text-xs">Today</span>
          </div>
          <p class="text-3xl font-bold text-gray-800 mb-1">{{occupancyRate}}<span class="text-lg text-gray-400">%</span></p>
          <p class="text-sm text-gray-500 font-medium">Occupancy Today</p>
          <p class="text-xs text-gray-400 mt-1">{{occupiedToday}}/{{totalRooms}} occupied</p>
        </div>

        <div class="stat-card animate-fade-in-up" style="border-top-color:#f59e0b;">
          <div class="flex items-start justify-between mb-3">
            <div class="icon-box bg-amber-100"><i class="fa-solid fa-clock text-amber-600"></i></div>
            <span class="badge badge-warning text-xs">Pending</span>
          </div>
          <p class="text-3xl font-bold text-gray-800 mb-1">{{pendingBookings}}</p>
          <p class="text-sm text-gray-500 font-medium">Pending</p>
        </div>

        <div class="stat-card animate-fade-in-up" style="border-top-color:#0d9488;">
          <div class="flex items-start justify-between mb-3">
            <div class="icon-box bg-teal-100"><i class="fa-solid fa-circle-check text-teal-600"></i></div>
            <span class="badge badge-teal text-xs">Active</span>
          </div>
          <p class="text-3xl font-bold text-gray-800 mb-1">{{confirmedBookings}}</p>
          <p class="text-sm text-gray-500 font-medium">Confirmed</p>
        </div>

        <div class="stat-card animate-fade-in-up" style="border-top-color:#ef4444;">
          <div class="flex items-start justify-between mb-3">
            <div class="icon-box bg-red-100"><i class="fa-solid fa-ban text-red-600"></i></div>
            <span class="badge badge-danger text-xs">Void</span>
          </div>
          <p class="text-3xl font-bold text-gray-800 mb-1">{{cancelledBookings}}</p>
          <p class="text-sm text-gray-500 font-medium">Cancelled</p>
        </div>
      </div>

      <!-- Charts Section -->
      <div class="grid md:grid-cols-2 gap-6 mb-6">
        <!-- Booking Status Pie Chart -->
        <div class="card p-6">
          <h2 class="text-base font-bold text-gray-800 mb-4 flex items-center gap-2">
            <i class="fa-solid fa-chart-pie text-teal-600"></i> Booking Status Distribution
          </h2>
          <div style="position:relative; height:280px;">
            <canvas id="bookingStatusChart"></canvas>
          </div>
        </div>

        <!-- Room Occupancy Pie Chart -->
        <div class="card p-6">
          <h2 class="text-base font-bold text-gray-800 mb-4 flex items-center gap-2">
            <i class="fa-solid fa-bed text-blue-600"></i> Room Occupancy
          </h2>
          <div style="position:relative; height:280px;">
            <canvas id="occupancyChart"></canvas>
          </div>
        </div>
      </div>

      <!-- Occupancy Forecast Line Chart -->
      <div class="card p-6 mb-6">
        <h2 class="text-base font-bold text-gray-800 mb-1 flex items-center gap-2">
          <i class="fa-solid fa-chart-line text-teal-600"></i> Occupancy Forecast
        </h2>
        <p class="text-xs text-gray-500 mb-5">Next 14 days prediction</p>

        {{#if forecast.length}}
        <div style="position:relative; height:300px;">
          <canvas id="forecastChart"></canvas>
        </div>
        <p class="text-xs text-gray-400 mt-4 pt-4 border-t border-gray-100">
          Trend: <span class="font-semibold text-gray-600">{{trend}}</span>
        </p>
        {{else}}
        <div class="rounded-xl p-5 text-center" style="background:#eff6ff; border: 1px solid #bfdbfe;">
          <i class="fa-solid fa-circle-info text-blue-500 text-2xl mb-2 block"></i>
          <p class="text-blue-800 font-semibold text-sm">Not enough historical data yet</p>
          <p class="text-xs text-blue-600 mt-1">Add bookings and use "Record snapshot" to build prediction history.</p>
        </div>
        {{/if}}
      </div>

      <!-- Room Types Chart -->
      <div class="grid md:grid-cols-2 gap-6">
        <div class="card p-6">
          <h2 class="text-base font-bold text-gray-800 mb-4 flex items-center gap-2">
            <i class="fa-solid fa-chart-bar text-green-600"></i> Room Type Performance
          </h2>
          <div style="position:relative; height:280px;">
            <canvas id="roomTypesChart"></canvas>
          </div>
        </div>

        <div class="card p-6">
          <h2 class="text-base font-bold text-gray-800 mb-4 flex items-center gap-2">
            <i class="fa-solid fa-umbrella-beach text-orange-600"></i> Cottage Type Performance
          </h2>
          <div style="position:relative; height:280px;">
            <canvas id="cottageTypesChart"></canvas>
          </div>
        </div>
      </div>

    </div><!-- /content -->
  </main>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<script>
  // Chart data from server
  const bookingData = {
    pending:     {{pendingBookings}},
    confirmed:   {{confirmedBookings}},
    checked_in:  {{#if checkedInBookings}}{{checkedInBookings}}{{else}}0{{/if}},
    checked_out: {{#if checkedOutBookings}}{{checkedOutBookings}}{{else}}0{{/if}},
    cancelled:   {{#if cancelledBookings}}{{cancelledBookings}}{{else}}0{{/if}}
  };

  const occupancyData = {
    occupied:  {{occupiedToday}},
    available: Math.max(0, {{totalRooms}} - {{occupiedToday}})
  };

  const forecastData = {
    dates: [{{#each forecast}}'{{this.date}}'{{#unless @last}},{{/unless}}{{/each}}],
    rates: [{{#each forecast}}{{this.predictedOccupancyRate}}{{#unless @last}},{{/unless}}{{/each}}]
  };

  const roomTypesData = {
    labels: [{{#each topRoomRecommendations}}'{{this.name}}'{{#unless @last}},{{/unless}}{{/each}}],
    data:   [{{#each topRoomRecommendations}}{{this.bookingCount}}{{#unless @last}},{{/unless}}{{/each}}]
  };

  const cottageTypesData = {
    labels: [{{#each topCottageRecommendations}}'{{this.name}}'{{#unless @last}},{{/unless}}{{/each}}],
    data:   [{{#each topCottageRecommendations}}{{this.bookingCount}}{{#unless @last}},{{/unless}}{{/each}}]
  };

  // ── Booking Status Doughnut ──
  const totalBookings = bookingData.pending + bookingData.confirmed + bookingData.checked_in + bookingData.checked_out + bookingData.cancelled;
  if (totalBookings > 0) {
    new Chart(document.getElementById('bookingStatusChart'), {
      type: 'doughnut',
      data: {
        labels: ['Pending', 'Confirmed', 'Checked In', 'Checked Out', 'Cancelled'],
        datasets: [{
          data: [bookingData.pending, bookingData.confirmed, bookingData.checked_in, bookingData.checked_out, bookingData.cancelled],
          backgroundColor: ['#f59e0b', '#10b981', '#3b82f6', '#8b5cf6', '#ef4444'],
          borderColor: '#fff',
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'bottom' },
          tooltip: {
            callbacks: {
              label: function(ctx) {
                const pct = ((ctx.parsed / totalBookings) * 100).toFixed(1);
                return ` ${ctx.label}: ${ctx.parsed} (${pct}%)`;
              }
            }
          }
        }
      }
    });
  } else {
    document.getElementById('bookingStatusChart').insertAdjacentHTML('afterend',
      '<p class="text-center text-gray-400 text-sm mt-4">No booking data for this period.</p>');
    document.getElementById('bookingStatusChart').style.display = 'none';
  }

  // ── Room Occupancy Doughnut ──
  const totalRoomsVal = {{totalRooms}};
  if (totalRoomsVal > 0) {
    new Chart(document.getElementById('occupancyChart'), {
      type: 'doughnut',
      data: {
        labels: ['Occupied', 'Available'],
        datasets: [{
          data: [occupancyData.occupied, occupancyData.available],
          backgroundColor: ['#14b8a6', '#e5e7eb'],
          borderColor: '#fff',
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'bottom' },
          tooltip: {
            callbacks: {
              label: function(ctx) {
                const pct = ((ctx.parsed / totalRoomsVal) * 100).toFixed(1);
                return ` ${ctx.label}: ${ctx.parsed} rooms (${pct}%)`;
              }
            }
          }
        }
      }
    });
  }

  // ── Forecast Line Chart ──
  {{#if forecast.length}}
  new Chart(document.getElementById('forecastChart'), {
    type: 'line',
    data: {
      labels: forecastData.dates,
      datasets: [{
        label: 'Predicted Occupancy Rate (%)',
        data: forecastData.rates,
        borderColor: '#14b8a6',
        backgroundColor: 'rgba(20, 184, 166, 0.1)',
        tension: 0.4,
        fill: true,
        pointBackgroundColor: '#14b8a6',
        pointBorderColor: '#fff',
        pointBorderWidth: 2,
        pointRadius: 4
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: true } },
      scales: {
        y: {
          beginAtZero: true,
          max: 100,
          ticks: { callback: v => v + '%' }
        }
      }
    }
  });
  {{/if}}

  // ── Room Type Performance Bar Chart ──
  {{#if topRoomRecommendations.length}}
  new Chart(document.getElementById('roomTypesChart'), {
    type: 'bar',
    data: {
      labels: roomTypesData.labels,
      datasets: [{
        label: 'Bookings (last 180 days)',
        data: roomTypesData.data,
        backgroundColor: [
          '#14b8a6','#0891b2','#8b5cf6','#f59e0b',
          '#10b981','#ef4444','#3b82f6','#ec4899'
        ],
        borderColor: '#fff',
        borderWidth: 1,
        borderRadius: 6
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        y: {
          beginAtZero: true,
          ticks: { stepSize: 1 },
          title: { display: true, text: 'Number of Bookings' }
        },
        x: {
          ticks: {
            maxRotation: 30,
            callback: function(val, idx) {
              const label = this.getLabelForValue(idx);
              return label.length > 14 ? label.slice(0, 13) + '…' : label;
            }
          }
        }
      }
    }
  });
  {{else}}
  document.getElementById('roomTypesChart').insertAdjacentHTML('afterend',
    '<p class="text-center text-gray-400 text-sm mt-4">No booking data available yet.</p>');
  document.getElementById('roomTypesChart').style.display = 'none';
  {{/if}}

  // ── Cottage Type Performance Bar Chart ──
  {{#if topCottageRecommendations.length}}
  new Chart(document.getElementById('cottageTypesChart'), {
    type: 'bar',
    data: {
      labels: cottageTypesData.labels,
      datasets: [{
        label: 'Bookings (last 180 days)',
        data: cottageTypesData.data,
        backgroundColor: [
          '#f97316','#fb923c','#fdba74','#fed7aa',
          '#ea580c','#c2410c','#9a3412','#7c2d12'
        ],
        borderColor: '#fff',
        borderWidth: 1,
        borderRadius: 6
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        y: {
          beginAtZero: true,
          ticks: { stepSize: 1 },
          title: { display: true, text: 'Number of Bookings' }
        },
        x: {
          ticks: {
            maxRotation: 30,
            callback: function(val, idx) {
              const label = this.getLabelForValue(idx);
              return label.length > 14 ? label.slice(0, 13) + '…' : label;
            }
          }
        }
      }
    }
  });
  {{else}}
  document.getElementById('cottageTypesChart').insertAdjacentHTML('afterend',
    '<p class="text-center text-gray-400 text-sm mt-4">No booking data available yet.</p>');
  document.getElementById('cottageTypesChart').style.display = 'none';
  {{/if}}

  // Filter Event Listeners
  document.getElementById('dateRange').addEventListener('change', function() {
    const range = this.value;
    const roomType = document.getElementById('roomTypeFilter').value;
    const status = document.getElementById('statusFilter').value;
    updateDashboard(range, roomType, status);
  });

  document.getElementById('roomTypeFilter').addEventListener('change', function() {
    const roomType = this.value;
    const range = document.getElementById('dateRange').value;
    const status = document.getElementById('statusFilter').value;
    updateDashboard(range, roomType, status);
  });

  document.getElementById('statusFilter').addEventListener('change', function() {
    const status = this.value;
    const range = document.getElementById('dateRange').value;
    const roomType = document.getElementById('roomTypeFilter').value;
    updateDashboard(range, roomType, status);
  });

  function updateDashboard(range, roomType, status) {
    const params = new URLSearchParams({
      range: range,
      roomType: roomType,
      status: status
    });
    window.location.href = '/dashboard?' + params.toString();
  }
</script>
<script>
(function () {
  const toggle  = document.getElementById('sidebar-toggle');
  const sidebar = document.getElementById('admin-sidebar');
  if (toggle && sidebar) {
    toggle.addEventListener('click', () => sidebar.classList.toggle('-translate-x-full'));
    document.addEventListener('click', (e) => {
      if (window.innerWidth < 768 && !sidebar.contains(e.target) && !toggle.contains(e.target))
        sidebar.classList.add('-translate-x-full');
    });
  }
  // confirmAdminLogout is defined in footer.xian
})();
</script>
