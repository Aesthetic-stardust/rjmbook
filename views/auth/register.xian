{{> head }}
<body class="min-h-screen font-body flex items-center justify-center p-4 relative overflow-hidden"
      style="background: linear-gradient(160deg,#1a1032 0%,#2d1b4e 50%,#1a1032 100%);">

  <!-- Animated canvas background -->
  <canvas id="waterCanvas" class="fixed inset-0 w-full h-full" style="z-index:0;"></canvas>

  <!-- Dot grid -->
  <div class="absolute inset-0 pointer-events-none opacity-[.03]"
       style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 36px 36px; z-index:1;"></div>

  <div class="w-full max-w-md relative animate-fade-in-up" style="z-index:10;">

    <!-- Back link -->
    <div class="mb-6 text-center">
      <a href="/login"
         class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 hover:text-purple-400 transition-colors">
        <i class="fa-solid fa-arrow-left text-[10px]"></i> Back to portal selection
      </a>
    </div>

    <!-- Brand header -->
    <div class="text-center mb-8">
      <div class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-4 transition-transform duration-300 hover:scale-105"
           style="background: linear-gradient(135deg,#7c3aed,#a855f7);
                  box-shadow: 0 8px 32px rgba(124,58,237,.44), 0 2px 8px rgba(0,0,0,.2);
                  border: 1px solid rgba(255,255,255,.1);">
        <i class="fa-solid fa-water text-white text-2xl"></i>
      </div>
      <h1 class="text-3xl font-bold font-display text-white mb-1" style="letter-spacing:-.02em;">Join RJMBook</h1>
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold mt-1"
           style="background: rgba(124,58,237,.2); color:#c4b5fd; border: 1px solid rgba(196,181,253,.25);">
        <i class="fa-solid fa-user-plus text-[10px]"></i> Create a Guest Account
      </div>
    </div>

    <!-- Card -->
    <div class="rounded-3xl p-8 shadow-2xl"
         style="background: rgba(255,255,255,.97); backdrop-filter: blur(24px);
                border: 1px solid rgba(255,255,255,.55);
                box-shadow: 0 32px 80px rgba(0,0,0,.3), 0 4px 16px rgba(0,0,0,.12);">

      <p class="text-sm text-gray-500 mb-6">Create your account to start booking at RJM Beach Resort</p>

      <div id="error-message"   class="hidden alert alert-error mb-5"></div>
      <div id="success-message" class="hidden alert alert-success mb-5"></div>

      <form id="register-form" class="space-y-5" novalidate>

        <!-- Full Name -->
        <div>
          <label class="label" for="reg-name">Full Name</label>
          <div class="relative">
            <i class="fa-solid fa-user absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm pointer-events-none"></i>
            <input id="reg-name" type="text" name="name"
                   placeholder="Juan dela Cruz" required
                   class="input pl-10"
                   autocomplete="name" />
          </div>
        </div>

        <!-- Email -->
        <div>
          <label class="label" for="reg-email">Email Address</label>
          <div class="relative">
            <i class="fa-solid fa-envelope absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm pointer-events-none"></i>
            <input id="reg-email" type="email" name="email"
                   placeholder="your@email.com" required
                   class="input pl-10"
                   autocomplete="email" />
          </div>
        </div>

        <!-- Password -->
        <div>
          <label class="label" for="password-input">Password</label>
          <div class="relative">
            <i class="fa-solid fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm pointer-events-none"></i>
            <input id="password-input" type="password" name="password"
                   placeholder="At least 8 characters" required
                   class="input pl-10 pr-11"
                   autocomplete="new-password" />
            <button type="button" id="toggle-password"
                    class="absolute right-3.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 transition-colors"
                    aria-label="Toggle password visibility">
              <i class="fa-solid fa-eye text-sm"></i>
            </button>
          </div>
        </div>

        <!-- Confirm Password -->
        <div>
          <label class="label" for="reg-confirm">Confirm Password</label>
          <div class="relative">
            <i class="fa-solid fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm pointer-events-none"></i>
            <input id="reg-confirm" type="password" name="passwordConfirm"
                   placeholder="Confirm your password" required
                   class="input pl-10"
                   autocomplete="new-password" />
          </div>
        </div>

        <!-- Password strength hint -->
        <p class="text-xs text-gray-400 flex items-center gap-1.5 -mt-2">
          <i class="fa-solid fa-circle-info text-purple-400 text-[10px]"></i>
          Use at least 8 characters with a mix of letters and numbers.
        </p>

        <!-- Submit -->
        <button type="submit" id="submit-btn"
                class="btn btn-pill w-full btn-lg font-bold text-white mt-1"
                style="background: linear-gradient(135deg,#7c3aed,#a855f7);
                       box-shadow: 0 4px 16px rgba(124,58,237,.38);"
                onmouseover="this.style.boxShadow='0 8px 26px rgba(124,58,237,.52)'"
                onmouseout="this.style.boxShadow='0 4px 16px rgba(124,58,237,.38)'">
          <i class="fa-solid fa-user-plus"></i> Create Account
        </button>
      </form>

      <!-- Divider -->
      <div class="flex items-center gap-3 my-6">
        <div class="flex-1 h-px bg-gray-200"></div>
        <span class="text-xs text-gray-400 font-medium px-1">OR</span>
        <div class="flex-1 h-px bg-gray-200"></div>
      </div>

      <p class="text-center text-sm text-gray-500">
        Already have an account?
        <a href="/login/user" class="text-purple-600 font-semibold hover:text-purple-700 transition-colors ml-1">
          Sign In <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
      </p>
    </div>

    <p class="text-center text-white/20 text-xs mt-8">
      &copy; 2026 RJMBook — RJM Beach Resort Management System
    </p>
  </div>

  <script>
  // ── Water canvas ──
  (function () {
    const canvas = document.getElementById('waterCanvas');
    const ctx    = canvas.getContext('2d');
    let W = canvas.width  = window.innerWidth;
    let H = canvas.height = window.innerHeight;
    let waves = [];

    window.addEventListener('resize', () => {
      W = canvas.width  = window.innerWidth;
      H = canvas.height = window.innerHeight;
    });

    class Wave {
      constructor(x, y) { this.x = x; this.y = y; this.r = 0; this.o = .45; }
      update() { this.r += 2.4; this.o -= .006; }
      draw() {
        ctx.strokeStyle = `rgba(167,139,250,${this.o})`;
        ctx.lineWidth   = 1.2;
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.r, 0, Math.PI * 2);
        ctx.stroke();
      }
      dead() { return this.o <= 0 || this.r >= 130; }
    }

    (function loop() {
      const g = ctx.createLinearGradient(0, 0, W, H);
      g.addColorStop(0,   '#1a1032');
      g.addColorStop(.5,  '#2d1b4e');
      g.addColorStop(1,   '#1a1032');
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, W, H);
      waves = waves.filter(w => !w.dead());
      waves.forEach(w => { w.update(); w.draw(); });
      requestAnimationFrame(loop);
    })();

    document.addEventListener('mousemove', e => {
      if (waves.length < 7) waves.push(new Wave(e.clientX, e.clientY));
    });
  })();

  // ── Toggle password ──
  document.getElementById('toggle-password').addEventListener('click', function () {
    const inp  = document.getElementById('password-input');
    const icon = this.querySelector('i');
    if (inp.type === 'password') { inp.type = 'text';     icon.className = 'fa-solid fa-eye-slash text-sm'; }
    else                         { inp.type = 'password'; icon.className = 'fa-solid fa-eye text-sm'; }
  });

  // ── Register form ──
  document.getElementById('register-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const errEl = document.getElementById('error-message');
    const okEl  = document.getElementById('success-message');
    const btn   = document.getElementById('submit-btn');
    errEl.classList.add('hidden');
    okEl.classList.add('hidden');

    const { name, email, password, passwordConfirm } = Object.fromEntries(new FormData(e.target));

    if (password.length < 8) {
      errEl.innerHTML = '<i class="fa-solid fa-circle-xmark mr-1"></i> Password must be at least 8 characters.';
      errEl.classList.remove('hidden'); return;
    }
    if (password !== passwordConfirm) {
      errEl.innerHTML = '<i class="fa-solid fa-circle-xmark mr-1"></i> Passwords do not match.';
      errEl.classList.remove('hidden'); return;
    }

    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Creating account…';

    try {
      const res  = await fetch('/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, password, passwordConfirm })
      });
      const data = await res.json();
      if (!res.ok) {
        errEl.innerHTML = '<i class="fa-solid fa-circle-xmark mr-1"></i>' + (data.error || 'Registration failed');
        errEl.classList.remove('hidden');
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-user-plus"></i> Create Account';
      } else {
        okEl.innerHTML = '<i class="fa-solid fa-circle-check mr-1"></i> Account created! Redirecting to login…';
        okEl.classList.remove('hidden');
        setTimeout(() => window.location.href = data.redirect || '/login', 1500);
      }
    } catch {
      errEl.innerHTML = '<i class="fa-solid fa-circle-xmark mr-1"></i> An error occurred. Please try again.';
      errEl.classList.remove('hidden');
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-user-plus"></i> Create Account';
    }
  });
  </script>
</body>
</html>
