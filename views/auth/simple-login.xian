{{> head }}
<body class="min-h-screen font-body flex flex-col p-4 py-8 relative overflow-x-hidden overflow-y-auto">
  <!-- Animated canvas background -->
  <canvas id="waterCanvas" class="fixed inset-0 w-full h-full" style="z-index:0;"></canvas>

  <div class="w-full max-w-md mx-auto my-auto relative" style="z-index:10;">

    <!-- Logo -->
    <div class="text-center mb-8 animate-fade-in-up">
      <h1 class="text-4xl font-bold font-display text-white mb-1">RJMBook</h1>
      <p class="text-teal-200 font-medium">RJM Beach Resort</p>
    </div>

    <!-- Card -->
    <div class="rounded-3xl p-8 animate-fade-in-up"
         style="background: rgba(255,255,255,.95); backdrop-filter: blur(20px); box-shadow: 0 24px 64px rgba(0,0,0,.25); border: 1px solid rgba(255,255,255,.6);">

      <h2 class="text-2xl font-bold text-gray-800 mb-1 font-display">Welcome back</h2>
      <p class="text-sm text-gray-500 mb-6">Sign in to your account to continue</p>

      <div id="error-message"   class="hidden alert alert-error mb-4"></div>
      <div id="success-message" class="hidden alert alert-success mb-4"></div>

      <form id="login-form" class="space-y-4">
        <div>
          <label class="label">Email Address</label>
          <div class="relative">
            <i class="fa-solid fa-envelope absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
            <input type="email" name="email" placeholder="your@email.com" required
                   class="input pl-10" />
          </div>
        </div>

        <div>
          <label class="label">Password</label>
          <div class="relative">
            <i class="fa-solid fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
            <input type="password" name="password" placeholder="••••••••" required
                   class="input pl-10" id="password-input" />
            <button type="button" id="toggle-password"
                    class="absolute right-3.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 transition-colors">
              <i class="fa-solid fa-eye text-sm"></i>
            </button>
          </div>
        </div>

        <button type="submit" id="submit-btn"
                class="btn btn-primary w-full btn-lg mt-2">
          <i class="fa-solid fa-right-to-bracket"></i>
          Sign In
        </button>
      </form>

      <div class="flex items-center gap-3 my-5">
        <div class="flex-1 h-px bg-gray-200"></div>
        <span class="text-xs text-gray-400 font-medium">OR</span>
        <div class="flex-1 h-px bg-gray-200"></div>
      </div>

      <!-- Google Sign-In -->
      <a href="/auth/google"
         class="flex items-center justify-center gap-3 w-full rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 hover:border-gray-300 transition-all duration-150 mb-4">
        <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        Continue with Google
      </a>

      <p class="text-center text-sm text-gray-600">
        Don't have an account?
        <a href="/register" class="text-teal-600 font-semibold hover:text-teal-700 transition-colors">Create one</a>
      </p>
      <p class="text-center text-xs text-gray-400 mt-3">
        <a href="/" class="hover:text-gray-600 transition-colors">← Back to Home</a>
      </p>
    </div>

    <p class="text-center text-white/30 text-xs mt-6">
      © 2026 RJMBook — RJM Beach Resort Management System
    </p>
  </div>

  <script>
  // ── Water canvas ──
  (function () {
    const canvas = document.getElementById('waterCanvas');
    const ctx    = canvas.getContext('2d');
    let W = canvas.width  = window.innerWidth;
    let H = canvas.height = window.innerHeight;
    let mx = W / 2, my = H / 2, waves = [];

    window.addEventListener('resize', () => {
      W = canvas.width  = window.innerWidth;
      H = canvas.height = window.innerHeight;
    });

    class Wave {
      constructor(x, y) { this.x=x; this.y=y; this.r=0; this.o=.55; }
      update() { this.r += 2.2; this.o -= .006; }
      draw()   {
        ctx.strokeStyle = `rgba(94,234,212,${this.o})`;
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.r, 0, Math.PI*2);
        ctx.stroke();
      }
      dead() { return this.o <= 0 || this.r >= 120; }
    }

    function loop() {
      const g = ctx.createLinearGradient(0,0,W,H);
      g.addColorStop(0,   '#0f172a');
      g.addColorStop(.45, '#134e4a');
      g.addColorStop(1,   '#0c1a2e');
      ctx.fillStyle = g;
      ctx.fillRect(0,0,W,H);

      waves = waves.filter(w => !w.dead());
      waves.forEach(w => { w.update(); w.draw(); });

      const cg = ctx.createRadialGradient(mx,my,0,mx,my,180);
      cg.addColorStop(0, 'rgba(20,184,166,.12)');
      cg.addColorStop(1, 'rgba(20,184,166,0)');
      ctx.fillStyle = cg;
      ctx.fillRect(mx-180, my-180, 360, 360);

      requestAnimationFrame(loop);
    }

    document.addEventListener('mousemove', e => {
      mx = e.clientX; my = e.clientY;
      if (waves.length < 6) waves.push(new Wave(mx, my));
    });

    loop();
  })();

  // ── Toggle password ──
  document.getElementById('toggle-password').addEventListener('click', function () {
    const inp = document.getElementById('password-input');
    const icon = this.querySelector('i');
    if (inp.type === 'password') {
      inp.type = 'text';
      icon.className = 'fa-solid fa-eye-slash text-sm';
    } else {
      inp.type = 'password';
      icon.className = 'fa-solid fa-eye text-sm';
    }
  });

  // ── Login form ──
  document.getElementById('login-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const errEl = document.getElementById('error-message');
    const okEl  = document.getElementById('success-message');
    const btn   = document.getElementById('submit-btn');
    errEl.classList.add('hidden');
    okEl.classList.add('hidden');

    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Signing in…';

    const { email, password } = Object.fromEntries(new FormData(e.target));
    try {
      const res  = await fetch('/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password })
      });
      const data = await res.json();
      if (!res.ok) {
        errEl.innerHTML = '<i class="fa-solid fa-circle-xmark"></i> ' + (data.error || 'Login failed');
        errEl.classList.remove('hidden');
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-right-to-bracket"></i> Sign In';
      } else {
        okEl.innerHTML = '<i class="fa-solid fa-circle-check"></i> ' + (data.message || 'Login successful!');
        okEl.classList.remove('hidden');
        setTimeout(() => window.location.href = data.redirect || '/', 600);
      }
    } catch {
      errEl.innerHTML = '<i class="fa-solid fa-circle-xmark"></i> Network error. Please try again.';
      errEl.classList.remove('hidden');
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-right-to-bracket"></i> Sign In';
    }
  });
  // ── Show error from query string (e.g. ?error=google_failed) ──
  (function () {
    const params = new URLSearchParams(window.location.search);
    const err = params.get('error');
    if (err) {
      const msgs = {
        google_failed: 'Google sign-in failed. Please try again.',
        oauth_failed:  'Authentication error. Please try again.',
      };
      const errEl = document.getElementById('error-message');
      errEl.innerHTML = '<i class="fa-solid fa-circle-xmark"></i> ' + (msgs[err] || 'Sign-in failed.');
      errEl.classList.remove('hidden');
    }
  })();

  </script>
</body>
</html>
