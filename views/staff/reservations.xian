{{> head }}
<body class="font-body">
<div class="flex h-screen overflow-hidden" style="background:#f1f5f9;">

  <!-- ── Staff Sidebar ── -->
  <aside id="staff-sidebar"
         class="flex-shrink-0 w-64 flex flex-col fixed md:relative top-0 left-0 h-screen z-40 transition-transform duration-300"
         style="background: linear-gradient(180deg,#1e1b4b 0%,#312e81 50%,#1e3a5f 100%); box-shadow: 4px 0 24px rgba(0,0,0,.2);">
    <div class="px-6 py-6 border-b" style="border-color: rgba(255,255,255,.1);">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0"
             style="background: linear-gradient(135deg,#6366f1,#8b5cf6);">
          <i class="fa-solid fa-user-tie text-white text-sm"></i>
        </div>
        <div>
          <h1 class="text-lg font-bold text-white font-display leading-none">RJMBook</h1>
          <p class="text-xs mt-0.5" style="color: rgba(255,255,255,.45);">Staff Panel</p>
        </div>
      </div>
    </div>
    <nav class="flex-1 px-3 py-5 space-y-0.5 overflow-y-auto">
      <p class="text-xs font-semibold uppercase tracking-widest px-3 mb-3" style="color: rgba(255,255,255,.35);">Operations</p>
      <a href="/staff" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-white/75 hover:text-white hover:bg-white/10 transition-all">
        <i class="fa-solid fa-gauge w-4 text-center flex-shrink-0"></i><span>Dashboard</span>
      </a>
      <a href="/staff/reservations" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all"
         style="background: linear-gradient(135deg,#6366f1,#8b5cf6); color:#fff; box-shadow: 0 4px 12px rgba(99,102,241,.35);">
        <i class="fa-solid fa-calendar-days w-4 text-center flex-shrink-0"></i><span>Reservations</span>
      </a>
      <a href="/staff/reservation-calendar" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-white/75 hover:text-white hover:bg-white/10 transition-all">
        <i class="fa-solid fa-calendar w-4 text-center flex-shrink-0"></i><span>Reservation Calendar</span>
      </a>
      <a href="/staff/room-status" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-white/75 hover:text-white hover:bg-white/10 transition-all">
        <i class="fa-solid fa-bed w-4 text-center flex-shrink-0"></i><span>Room Status</span>
      </a>
      <a href="/staff/guests" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-white/75 hover:text-white hover:bg-white/10 transition-all">
        <i class="fa-solid fa-users w-4 text-center flex-shrink-0"></i><span>Guests</span>
      </a>
      <a href="/staff/book" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-white/75 hover:text-white hover:bg-white/10 transition-all">
        <i class="fa-solid fa-calendar-plus w-4 text-center flex-shrink-0"></i><span>Walk-in Booking</span>
      </a>
    </nav>
    <div class="px-3 py-4 border-t" style="border-color: rgba(255,255,255,.08);">
      <div class="flex items-center gap-3 px-3 py-3 rounded-xl mb-3" style="background: rgba(255,255,255,.07);">
        <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold text-white flex-shrink-0"
             style="background: linear-gradient(135deg,#6366f1,#8b5cf6);">
          {{#if sessionUserName}}{{sessionUserName.[0]}}{{else}}S{{/if}}
        </div>
        <div class="min-w-0">
          <p class="text-xs text-white font-semibold truncate">{{sessionUserName}}</p>
          <p class="text-xs" style="color: rgba(255,255,255,.4);">Staff Member</p>
        </div>
      </div>
      <button id="staffLogoutBtn"
              class="w-full flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl text-sm font-semibold text-white transition-all cursor-pointer border-none"
              style="background: rgba(220,38,38,.2); border: 1px solid rgba(220,38,38,.3);"
>
        <i class="fa-solid fa-right-from-bracket text-red-400"></i>
        <span class="text-red-300">Sign Out</span>
      </button>
    </div>
  </aside>

  <!-- ── Main ── -->
  <main class="flex-1 flex flex-col overflow-hidden">
    <header class="flex-shrink-0 flex items-center justify-between px-6 py-4 bg-white border-b border-gray-200"
            style="box-shadow: 0 1px 8px rgba(0,0,0,.06);">
      <div class="flex items-center gap-4">
        <button id="sidebar-toggle" class="md:hidden p-2 rounded-lg text-gray-500 hover:bg-gray-100 transition-colors">
          <i class="fa-solid fa-bars"></i>
        </button>
        <div>
          <h2 class="text-xl font-bold text-gray-800">Reservations</h2>
          <p class="text-xs text-gray-500 mt-0.5">Manage all guest bookings</p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <a href="/staff/book"
           class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-sm font-semibold text-white"
           style="background: linear-gradient(135deg,#6366f1,#8b5cf6);">
          <i class="fa-solid fa-plus text-xs"></i> Walk-in
        </a>
        <div class="w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold text-white"
             style="background: linear-gradient(135deg,#6366f1,#8b5cf6);">
          {{#if sessionUserName}}{{sessionUserName.[0]}}{{else}}S{{/if}}
        </div>
      </div>
    </header>

    <div class="flex-1 overflow-auto p-6" style="background:#f8fafc;">

      <!-- Stats -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 mb-5 stagger">

        <div class="stat-card animate-fade-in-up">
          <div class="flex items-start justify-between mb-2">
            <div class="icon-box bg-gray-100">
              <i class="fa-solid fa-list text-gray-500"></i>
            </div>
          </div>
          <p class="text-3xl font-bold text-gray-800 mb-0.5">{{totalBookings}}</p>
          <p class="text-xs text-gray-500 font-medium">Total</p>
        </div>

        <div class="stat-card animate-fade-in-up" style="border-top-color:#22c55e;">
          <div class="flex items-start justify-between mb-2">
            <div class="icon-box bg-green-100">
              <i class="fa-solid fa-circle-check text-green-600"></i>
            </div>
          </div>
          <p class="text-3xl font-bold text-green-700 mb-0.5">{{confirmedCount}}</p>
          <p class="text-xs text-gray-500 font-medium">Confirmed</p>
        </div>

        <div class="stat-card animate-fade-in-up" style="border-top-color:#f59e0b;">
          <div class="flex items-start justify-between mb-2">
            <div class="icon-box bg-amber-100">
              <i class="fa-solid fa-clock text-amber-600"></i>
            </div>
          </div>
          <p class="text-3xl font-bold text-amber-700 mb-0.5">{{pendingCount}}</p>
          <p class="text-xs text-gray-500 font-medium">Pending</p>
        </div>

        <div class="stat-card animate-fade-in-up" style="border-top-color:#3b82f6;">
          <div class="flex items-start justify-between mb-2">
            <div class="icon-box bg-blue-100">
              <i class="fa-solid fa-door-open text-blue-600"></i>
            </div>
          </div>
          <p class="text-3xl font-bold text-blue-700 mb-0.5">{{checkedInCount}}</p>
          <p class="text-xs text-gray-500 font-medium">Checked In</p>
        </div>

        <div class="stat-card animate-fade-in-up" style="border-top-color:#ef4444;">
          <div class="flex items-start justify-between mb-2">
            <div class="icon-box bg-red-100">
              <i class="fa-solid fa-circle-xmark text-red-600"></i>
            </div>
          </div>
          <p class="text-3xl font-bold text-red-700 mb-0.5">{{cancelledCount}}</p>
          <p class="text-xs text-gray-500 font-medium">Cancelled</p>
        </div>

        <div class="stat-card animate-fade-in-up" style="border-top-color:#6b7280;">
          <div class="flex items-start justify-between mb-2">
            <div class="icon-box bg-gray-100">
              <i class="fa-solid fa-door-closed text-gray-500"></i>
            </div>
          </div>
          <p class="text-3xl font-bold text-gray-700 mb-0.5">{{completedCount}}</p>
          <p class="text-xs text-gray-500 font-medium">Completed</p>
        </div>
      </div>

      <!-- Filter buttons -->
      <div class="flex flex-wrap gap-2 mb-4">
        <button onclick="filterRows('all')" data-filter="all"
                class="filter-btn px-4 py-2 rounded-xl text-sm font-semibold transition-all text-white"
                style="background: linear-gradient(135deg,#6366f1,#8b5cf6);">
          <i class="fa-solid fa-list text-xs mr-1"></i>All
        </button>
        <button onclick="filterRows('pending')" data-filter="pending"
                class="filter-btn px-4 py-2 rounded-xl text-sm font-semibold bg-amber-100 text-amber-800 hover:bg-amber-200 transition-all">
          <i class="fa-solid fa-clock text-xs mr-1"></i>Pending
        </button>
        <button onclick="filterRows('confirmed')" data-filter="confirmed"
                class="filter-btn px-4 py-2 rounded-xl text-sm font-semibold bg-green-100 text-green-800 hover:bg-green-200 transition-all">
          <i class="fa-solid fa-circle-check text-xs mr-1"></i>Confirmed
        </button>
        <button onclick="filterRows('checked_in')" data-filter="checked_in"
                class="filter-btn px-4 py-2 rounded-xl text-sm font-semibold bg-blue-100 text-blue-800 hover:bg-blue-200 transition-all">
          <i class="fa-solid fa-door-open text-xs mr-1"></i>Checked In
        </button>
        <button onclick="filterRows('cancelled')" data-filter="cancelled"
                class="filter-btn px-4 py-2 rounded-xl text-sm font-semibold bg-red-100 text-red-800 hover:bg-red-200 transition-all">
          <i class="fa-solid fa-circle-xmark text-xs mr-1"></i>Cancelled
        </button>
        <button onclick="filterRows('completed')" data-filter="completed"
                class="filter-btn px-4 py-2 rounded-xl text-sm font-semibold bg-gray-100 text-gray-700 hover:bg-gray-200 transition-all">
          <i class="fa-solid fa-door-closed text-xs mr-1"></i>Completed
        </button>
      </div>

      <!-- Table -->
      <div class="table-wrapper">
        <table class="nb-table">
          <thead>
            <tr>
              <th style="cursor:pointer; user-select: none;" onclick="sortTable('id')" class="sort-header" data-sort="id">
                ID
                {{#if (eq currentSort.sortBy 'id')}}
                <i class="fa-solid fa-arrow-{{#if (eq currentSort.sortOrder 'ASC')}}up{{else}}down{{/if}} text-xs ml-1"></i>
                {{/if}}
              </th>
              <th style="cursor:pointer; user-select: none;" onclick="sortTable('guestName')" class="sort-header" data-sort="guestName">
                Guest
                {{#if (eq currentSort.sortBy 'guestName')}}
                <i class="fa-solid fa-arrow-{{#if (eq currentSort.sortOrder 'ASC')}}up{{else}}down{{/if}} text-xs ml-1"></i>
                {{/if}}
              </th>
              <th style="cursor:pointer; user-select: none;" onclick="sortTable('checkIn')" class="sort-header" data-sort="checkIn">
                Check-in
                {{#if (eq currentSort.sortBy 'checkIn')}}
                <i class="fa-solid fa-arrow-{{#if (eq currentSort.sortOrder 'ASC')}}up{{else}}down{{/if}} text-xs ml-1"></i>
                {{/if}}
              </th>
              <th style="cursor:pointer; user-select: none;" onclick="sortTable('checkOut')" class="sort-header" data-sort="checkOut">
                Check-out
                {{#if (eq currentSort.sortBy 'checkOut')}}
                <i class="fa-solid fa-arrow-{{#if (eq currentSort.sortOrder 'ASC')}}up{{else}}down{{/if}} text-xs ml-1"></i>
                {{/if}}
              </th>
              <th>Room</th>
              <th>Guests</th>
              <th>Amount</th>
              <th>Status</th>
              <th class="text-center">Actions</th>
            </tr>
          </thead>
          <tbody>
            {{#each bookings}}
            <tr class="booking-row" data-status="{{this.status}}">
              <td class="font-medium text-gray-700">#{{this.id}}</td>
              <td>
                {{#if this.Guest}}
                <p class="font-medium text-gray-800 text-sm">{{this.Guest.firstName}} {{this.Guest.lastName}}</p>
                <p class="text-xs text-gray-400">{{this.Guest.email}}</p>
                {{else}}<span class="text-gray-400">—</span>{{/if}}
              </td>
              <td class="text-sm text-gray-600">{{this.checkIn}}</td>
              <td class="text-sm text-gray-600">{{this.checkOut}}</td>
              <td>
                {{#if this.Room}}
                <p class="font-medium text-sm">{{this.Room.roomNumber}}</p>
                <p class="text-xs text-gray-400">{{this.Room.RoomType.name}}</p>
                {{else}}<span class="text-gray-400">—</span>{{/if}}
              </td>
              <td class="text-sm text-gray-600">
                <span class="badge badge-info text-xs">{{this.adults}} Adult(s)</span>
                {{#if this.children}}
                <span class="badge badge-neutral text-xs ml-1">{{this.children}} Child</span>
                {{/if}}
              </td>
              <td class="font-semibold text-teal-700 text-sm">₱{{this.totalAmount}}</td>
              <td>
                <span class="badge text-xs
                  {{#if (eq this.status 'pending')}}badge-warning
                  {{else if (eq this.status 'confirmed')}}badge-success
                  {{else if (eq this.status 'checked_in')}}badge-info
                  {{else if (eq this.status 'cancelled')}}badge-danger
                  {{else}}badge-neutral{{/if}}">
                  {{this.status}}
                </span>
              </td>
              <td>
                <div class="flex gap-1 justify-center items-center flex-nowrap overflow-x-auto">
                  <a href="/bookings/{{this.id}}"
                     class="px-2 py-1 rounded-lg text-xs font-semibold text-indigo-600 hover:bg-indigo-50 border border-indigo-200 transition-colors whitespace-nowrap"
                     title="View details">
                    View
                  </a>
                  {{#if (eq this.status 'pending')}}
                  <button onclick="updateStatus({{this.id}}, 'confirmed')"
                          class="px-2 py-1 rounded-lg text-xs font-semibold text-white transition-colors whitespace-nowrap"
                          style="background:#22c55e;"
                          title="Confirm reservation">
                    Confirm
                  </button>
                  <button onclick="openCancelModal({{this.id}})"
                          class="px-2 py-1 rounded-lg text-xs font-semibold text-white transition-colors whitespace-nowrap"
                          style="background:#ef4444;"
                          title="Cancel reservation">
                    Cancel
                  </button>
                  {{/if}}
                  {{#if (eq this.status 'confirmed')}}
                  <button onclick="updateStatus({{this.id}}, 'checked_in')"
                          class="px-2 py-1 rounded-lg text-xs font-semibold text-white transition-colors whitespace-nowrap"
                          style="background:#3b82f6;"
                          title="Check in guest">
                    Check-in
                  </button>
                  <button onclick="openCancelModal({{this.id}})"
                          class="px-2 py-1 rounded-lg text-xs font-semibold text-white transition-colors whitespace-nowrap"
                          style="background:#ef4444;"
                          title="Cancel reservation">
                    Cancel
                  </button>
                  {{/if}}
                  {{#if (eq this.status 'checked_in')}}
                  <button onclick="earlyCheckout({{this.id}})"
                          class="px-2 py-1 rounded-lg text-xs font-semibold text-white transition-colors whitespace-nowrap"
                          style="background:#f97316;"
                          title="Process early checkout">
                    Check-out
                  </button>
                  {{/if}}
                </div>
              </td>
            </tr>
            {{else}}
            <tr><td colspan="9" class="text-center py-10 text-gray-400">No reservations found.</td></tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<!-- Cancel Modal -->
<div id="cancelModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4"
     style="background: rgba(15,23,42,.6); backdrop-filter: blur(4px);">
  <div class="bg-white rounded-3xl shadow-2xl max-w-sm w-full p-8 animate-fade-in-up">
    <h3 class="text-lg font-bold text-gray-900 mb-2">Cancel Reservation</h3>
    <p class="text-sm text-gray-500 mb-4">Please provide a reason for cancellation:</p>
    <textarea id="cancelReason" rows="3" placeholder="Enter reason..."
              class="input resize-none mb-4"></textarea>
    <div class="flex gap-3">
      <button onclick="closeCancelModal()"
              class="flex-1 px-4 py-2.5 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold text-sm transition-colors">
        Back
      </button>
      <button onclick="confirmCancel()"
              class="flex-1 px-4 py-2.5 rounded-xl font-semibold text-sm text-white transition-all"
              style="background: linear-gradient(135deg,#dc2626,#ef4444);">
        Cancel Booking
      </button>
    </div>
  </div>
</div>

<!-- Toast -->
<div id="notificationContainer" class="fixed top-5 right-5 z-[300] space-y-3"></div>

<script>
(function () {
  // Sidebar toggle
  const toggle  = document.getElementById('sidebar-toggle');
  const sidebar = document.getElementById('staff-sidebar');
  if (toggle && sidebar) {
    toggle.addEventListener('click', () => sidebar.classList.toggle('-translate-x-full'));
    document.addEventListener('click', (e) => {
      if (window.innerWidth < 768 && !sidebar.contains(e.target) && !toggle.contains(e.target))
        sidebar.classList.add('-translate-x-full');
    });
  }

  // Logout functionality
  let _logoutCb = null;

  window.showLogoutConfirmation = function (cb) {
    _logoutCb = cb;
    const m = document.getElementById('logoutConfirmModal');
    if (m) m.classList.remove('hidden');
  };

  window.confirmStaffLogout = function () {
    showLogoutConfirmation(function () {
      window.location.href = '/logout';
    });
  };

  function closeModal() {
    const modal = document.getElementById('logoutConfirmModal');
    if (modal) modal.classList.add('hidden');
    _logoutCb = null;
  }

  document.addEventListener('DOMContentLoaded', function () {
    const logoutBtn = document.getElementById('staffLogoutBtn');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', window.confirmStaffLogout);
    }

    const yes = document.getElementById('logoutConfirmYes');
    const no = document.getElementById('logoutConfirmNo');
    const modal = document.getElementById('logoutConfirmModal');

    if (yes) yes.addEventListener('click', () => { if (_logoutCb) _logoutCb(); });
    if (no) no.addEventListener('click', closeModal);
    if (modal) modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  });

  // Filter rows
  window.filterRows = function (status) {
    document.querySelectorAll('.filter-btn').forEach(b => {
      b.style.background = '';
      b.style.color = '';
    });
    const active = document.querySelector(`.filter-btn[data-filter="${status}"]`);
    if (active) { active.style.background = 'linear-gradient(135deg,#6366f1,#8b5cf6)'; active.style.color = '#fff'; }

    document.querySelectorAll('.booking-row').forEach(row => {
      const s = row.dataset.status;
      if (status === 'all') { row.style.display = ''; return; }
      if (status === 'completed') { row.style.display = (s === 'checked_out' || s === 'early_checkout') ? '' : 'none'; return; }
      row.style.display = s === status ? '' : 'none';
    });
  };

  // Sort table by column
  window.sortTable = function (sortBy) {
    const currentSort = new URLSearchParams(window.location.search).get('sortBy') || 'checkIn';
    const currentOrder = new URLSearchParams(window.location.search).get('sortOrder') || 'DESC';
    
    let newOrder = 'DESC'; // Default to descending
    if (sortBy === currentSort && currentOrder === 'DESC') {
      newOrder = 'ASC'; // Toggle to ascending if clicking same column
    }
    
    // Navigate with new sort parameters
    window.location.href = `?sortBy=${sortBy}&sortOrder=${newOrder}`;
  };

  // Status update
  window.updateStatus = async function (id, status) {
    try {
      showToast('Processing…', 'info');
      const res  = await fetch(`/bookings/${id}`, { method:'PATCH', headers:{'Content-Type':'application/json'}, body: JSON.stringify({status}) });
      const data = await res.json();
      if (data.success) { showToast('Updated successfully!', 'success'); setTimeout(() => location.reload(), 1200); }
      else showToast('Error: ' + (data.error || 'Failed'), 'error');
    } catch (e) { showToast('Error: ' + e.message, 'error'); }
  };

  // Early checkout
  window.earlyCheckout = async function (id) {
    const today = new Date().toISOString().split('T')[0];
    try {
      showToast('Processing checkout…', 'info');
      const res  = await fetch(`/bookings/${id}`, { method:'PATCH', headers:{'Content-Type':'application/json'}, body: JSON.stringify({status:'checked_out', earlyCheckoutDate: today}) });
      const data = await res.json();
      if (data.success) { showToast('Checked out!', 'success'); setTimeout(() => location.reload(), 1200); }
      else showToast('Error: ' + (data.error || 'Failed'), 'error');
    } catch (e) { showToast('Error: ' + e.message, 'error'); }
  };

  // Cancel modal
  let _cancelId = null;
  window.openCancelModal = function (id) {
    _cancelId = id;
    document.getElementById('cancelReason').value = '';
    document.getElementById('cancelModal').classList.remove('hidden');
  };
  window.closeCancelModal = function () {
    document.getElementById('cancelModal').classList.add('hidden');
    _cancelId = null;
  };
  window.confirmCancel = async function () {
    const reason = document.getElementById('cancelReason').value.trim();
    if (!reason) { showToast('Please enter a cancellation reason.', 'error'); return; }
    closeCancelModal();
    try {
      showToast('Cancelling…', 'info');
      const res  = await fetch(`/bookings/${_cancelId}`, { method:'PATCH', headers:{'Content-Type':'application/json'}, body: JSON.stringify({status:'cancelled', cancellationReason: reason}) });
      const data = await res.json();
      if (data.success) { showToast('Booking cancelled.', 'success'); setTimeout(() => location.reload(), 1200); }
      else showToast('Error: ' + (data.error || 'Failed'), 'error');
    } catch (e) { showToast('Error: ' + e.message, 'error'); }
  };

  // Close cancel modal on backdrop click
  document.getElementById('cancelModal').addEventListener('click', function(e) {
    if (e.target === this) closeCancelModal();
  });

  // Toast helper
  window.showToast = function (msg, type) {
    const c = document.getElementById('notificationContainer');
    const el = document.createElement('div');
    const colors = { success:'#22c55e', error:'#ef4444', info:'#6366f1' };
    el.innerHTML = `<div style="background:#fff; border-left:4px solid ${colors[type]||'#6366f1'}; border-radius:12px; padding:12px 16px; box-shadow:0 8px 24px rgba(0,0,0,.12); display:flex; align-items:center; gap:10px; font-size:14px; font-weight:500; min-width:240px; animation: fadeInUp .3s ease;">
      <i class="fa-solid ${type==='success'?'fa-circle-check':type==='error'?'fa-circle-xmark':'fa-circle-info'}" style="color:${colors[type]||'#6366f1'};"></i>
      <span>${msg}</span></div>`;
    c.appendChild(el);
    setTimeout(() => el.remove(), 3500);
  };
})();
</script>

<!-- Logout Confirmation Modal -->
<div id="logoutConfirmModal"
     class="hidden fixed inset-0 z-[500] flex items-center justify-center p-4"
     style="background: rgba(15,23,42,.65); backdrop-filter: blur(6px);">
  <div class="bg-white rounded-3xl shadow-2xl max-w-sm w-full p-8 animate-fade-in-up">
    <div class="flex items-center gap-4 mb-5">
      <div class="w-12 h-12 rounded-2xl flex items-center justify-center flex-shrink-0"
           style="background: linear-gradient(135deg,#fef3c7,#fde68a);">
        <i class="fa-solid fa-right-from-bracket text-amber-600 text-lg"></i>
      </div>
      <div>
        <h3 class="text-lg font-bold text-gray-900">Sign Out?</h3>
        <p class="text-sm text-gray-500">You'll need to sign in again to access your account.</p>
      </div>
    </div>
    <div class="flex gap-3 mt-6">
      <button id="logoutConfirmNo"
              class="flex-1 px-4 py-2.5 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold text-sm transition-colors">
        Cancel
      </button>
      <button id="logoutConfirmYes"
              class="flex-1 px-4 py-2.5 rounded-xl font-semibold text-sm text-white transition-all"
              style="background: linear-gradient(135deg,#dc2626,#ef4444); box-shadow: 0 4px 12px rgba(220,38,38,.3);">
        Sign Out
      </button>
    </div>
  </div>
</div>
</body>
