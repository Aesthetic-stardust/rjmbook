<!-- ══════════════════════════════════════════════
     RJMBook — Admin Sidebar Layout
     RJM Beach Resort
     ══════════════════════════════════════════════ -->
<div class="flex h-screen overflow-hidden" style="background:#f1f5f9;">

  <!-- ── Sidebar ── -->
  <aside id="admin-sidebar"
         class="flex-shrink-0 w-64 flex flex-col fixed md:relative top-0 left-0 h-screen z-40 transition-transform duration-300"
         style="background: linear-gradient(180deg,#0f172a 0%,#134e4a 100%); box-shadow: 4px 0 24px rgba(0,0,0,.18);">

    <!-- Brand -->
    <div class="px-6 py-6 border-b" style="border-color: rgba(255,255,255,.08);">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl overflow-hidden flex-shrink-0"
             style="box-shadow: 0 2px 10px rgba(0,0,0,.3);">
          <img src="/rjmlogo.jpg" alt="RJM Beach Resort Logo"
               class="w-full h-full object-cover" />
        </div>
        <div>
          <h1 class="text-lg font-bold text-white font-display leading-none">RJMBook</h1>
          <p class="text-xs mt-0.5" style="color: rgba(255,255,255,.4);">RJM Beach Resort</p>
        </div>
      </div>
    </div>

    <!-- Nav -->
    <nav class="flex-1 px-3 py-5 space-y-0.5 overflow-y-auto">
      <p class="text-xs font-semibold uppercase tracking-widest px-3 mb-3" style="color: rgba(255,255,255,.3);">Management</p>

      <a href="/admin"
         class="sidebar-link {{#if (eq currentPage 'dashboard')}}active{{/if}}">
        <i class="fa-solid fa-gauge w-4 text-center flex-shrink-0"></i>
        <span>Dashboard</span>
      </a>

      <a href="/admin/reservations"
         class="sidebar-link {{#if (eq currentPage 'reservations')}}active{{/if}}">
        <i class="fa-solid fa-calendar-days w-4 text-center flex-shrink-0"></i>
        <span>Reservations</span>
      </a>

      <a href="/admin/book"
         class="sidebar-link {{#if (eq currentPage 'walkin')}}active{{/if}}">
        <i class="fa-solid fa-calendar-plus w-4 text-center flex-shrink-0"></i>
        <span>Walk-in Booking</span>
      </a>

      <a href="/admin/reservation-calendar"
         class="sidebar-link {{#if (eq currentPage 'reservation-calendar')}}active{{/if}}">
        <i class="fa-solid fa-calendar w-4 text-center flex-shrink-0"></i>
        <span>Reservation Calendar</span>
      </a>

      <a href="/admin/room-availability"
         class="sidebar-link {{#if (eq currentPage 'room-availability')}}active{{/if}}">
        <i class="fa-solid fa-door-open w-4 text-center flex-shrink-0"></i>
        <span>Room Availability</span>
      </a>

      <a href="/admin/rooms"
         class="sidebar-link {{#if (eq currentPage 'rooms')}}active{{/if}}">
        <i class="fa-solid fa-bed w-4 text-center flex-shrink-0"></i>
        <span>Rooms</span>
      </a>

      <a href="/admin/cottages"
         class="sidebar-link {{#if (eq currentPage 'cottages')}}active{{/if}}">
        <i class="fa-solid fa-umbrella-beach w-4 text-center flex-shrink-0"></i>
        <span>Cottages</span>
      </a>

      <a href="/guests"
         class="sidebar-link {{#if (eq currentPage 'guests')}}active{{/if}}">
        <i class="fa-solid fa-users w-4 text-center flex-shrink-0"></i>
        <span>Guests</span>
      </a>

      <div class="my-3 border-t" style="border-color: rgba(255,255,255,.07);"></div>
      <p class="text-xs font-semibold uppercase tracking-widest px-3 mb-3" style="color: rgba(255,255,255,.3);">Analytics</p>

      <a href="/dashboard"
         class="sidebar-link {{#if (eq currentPage 'analytics')}}active{{/if}}">
        <i class="fa-solid fa-chart-pie w-4 text-center flex-shrink-0"></i>
        <span>Analytics</span>
      </a>

      <a href="/admin/reports"
         class="sidebar-link {{#if (eq currentPage 'reports')}}active{{/if}}">
        <i class="fa-solid fa-file-chart-column w-4 text-center flex-shrink-0"></i>
        <span>Reports</span>
      </a>

      <a href="/admin/sentiment-analysis"
         class="sidebar-link {{#if (eq currentPage 'sentiment')}}active{{/if}}">
        <i class="fa-solid fa-brain w-4 text-center flex-shrink-0"></i>
        <span>Sentiment Analysis</span>
      </a>

      <div class="my-3 border-t" style="border-color: rgba(255,255,255,.07);"></div>
      <p class="text-xs font-semibold uppercase tracking-widest px-3 mb-3" style="color: rgba(255,255,255,.3);">Account</p>

      <a href="/admin/staff"
         class="sidebar-link {{#if (eq currentPage 'staff')}}active{{/if}}">
        <i class="fa-solid fa-user-tie w-4 text-center flex-shrink-0"></i>
        <span>Manage Staff</span>
      </a>

      <a href="/account"
         class="sidebar-link {{#if (eq currentPage 'account')}}active{{/if}}">
        <i class="fa-solid fa-user-gear w-4 text-center flex-shrink-0"></i>
        <span>Account Settings</span>
      </a>

      <div class="my-3 border-t" style="border-color: rgba(255,255,255,.07);"></div>
      <p class="text-xs font-semibold uppercase tracking-widest px-3 mb-3" style="color: rgba(255,255,255,.3);">Security</p>

      <a href="/admin/audit-logs"
         class="sidebar-link {{#if (eq currentPage 'audit-logs')}}active{{/if}}">
        <i class="fa-solid fa-scroll w-4 text-center flex-shrink-0"></i>
        <span>Audit Logs</span>
      </a>

      <a href="/admin/session-logs"
         class="sidebar-link {{#if (eq currentPage 'session-logs')}}active{{/if}}">
        <i class="fa-solid fa-clock-rotate-left w-4 text-center flex-shrink-0"></i>
        <span>Session Logs</span>
      </a>
    </nav>

    <!-- User + Logout -->
    <div class="px-3 py-4 border-t" style="border-color: rgba(255,255,255,.08);">
      <div class="flex items-center gap-3 px-3 py-3 rounded-xl mb-3"
           style="background: rgba(255,255,255,.06);">
        <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold text-white flex-shrink-0"
             style="background: linear-gradient(135deg,#0d9488,#0891b2);">
          {{#if sessionUserName}}{{sessionUserName.[0]}}{{else}}A{{/if}}
        </div>
        <div class="min-w-0">
          <p class="text-xs text-white font-semibold truncate">{{sessionUserName}}</p>
          <p class="text-xs" style="color: rgba(255,255,255,.4);">Administrator</p>
        </div>
      </div>
      <button id="adminLogoutBtn"
              class="w-full flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl text-sm font-semibold text-white transition-all cursor-pointer border-none"
              style="background: rgba(220,38,38,.2); border: 1px solid rgba(220,38,38,.3);"
>
        <i class="fa-solid fa-right-from-bracket text-red-400"></i>
        <span class="text-red-300">Sign Out</span>
      </button>
    </div>
  </aside>

  <!-- ── Main Content ── -->
  <main class="flex-1 flex flex-col overflow-hidden">

    <!-- Top bar -->
    <header class="flex-shrink-0 flex items-center justify-between px-6 py-4 bg-white border-b border-gray-200"
            style="box-shadow: 0 1px 8px rgba(0,0,0,.06);">
      <div class="flex items-center gap-4">
        <!-- Mobile sidebar toggle -->
        <button id="sidebar-toggle"
                class="md:hidden p-2 rounded-lg text-gray-500 hover:bg-gray-100 transition-colors">
          <i class="fa-solid fa-bars"></i>
        </button>
        <div>
          <h2 class="text-xl font-bold text-gray-800">{{pageTitle}}</h2>
          {{#if pageDescription}}
          <p class="text-xs text-gray-500 mt-0.5">{{pageDescription}}</p>
          {{/if}}
        </div>
      </div>
      <div class="flex items-center gap-3">
        <div class="hidden sm:block text-right">
          <p class="text-xs text-gray-500">Welcome back,</p>
          <p class="text-sm font-semibold text-gray-800">{{sessionUserName}}</p>
        </div>
        <div class="w-9 h-9 rounded-full flex items-center justify-center text-sm font-bold text-white"
             style="background: linear-gradient(135deg,#0d9488,#0891b2);">
          {{#if sessionUserName}}{{sessionUserName.[0]}}{{else}}A{{/if}}
        </div>
      </div>
    </header>

    <!-- Page content -->
    <div class="flex-1 overflow-auto p-6" style="background:#f8fafc;">
      {{{content}}}
    </div>
  </main>
</div>

<script>
(function () {
  const toggle  = document.getElementById('sidebar-toggle');
  const sidebar = document.getElementById('admin-sidebar');

  if (toggle && sidebar) {
    toggle.addEventListener('click', () => {
      sidebar.classList.toggle('-translate-x-full');
    });
    document.addEventListener('click', (e) => {
      if (window.innerWidth < 768 && !sidebar.contains(e.target) && !toggle.contains(e.target)) {
        sidebar.classList.add('-translate-x-full');
      }
    });
  }

  // confirmAdminLogout is defined in footer.xian
})();
</script>
