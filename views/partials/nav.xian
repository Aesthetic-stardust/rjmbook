<!-- ══════════════════════════════════════════════
     RJMBook — Top Navigation Bar v3
     Professional Edition · 2026
     ══════════════════════════════════════════════ -->
<nav id="main-nav" class="fixed w-full top-0 z-50 transition-all duration-300" data-scrolled="false"
     style="background: linear-gradient(135deg,#0f766e 0%,#0d9488 55%,#0891b2 100%); box-shadow: 0 2px 20px rgba(0,0,0,.15);">

  <!-- Top shimmer line -->
  <div class="absolute top-0 left-0 right-0 h-[2px] pointer-events-none"
       style="background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,.45) 40%, rgba(94,234,212,.7) 60%, transparent 100%);"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-[66px]">

      <!-- ── Logo ── -->
      <a href="/" class="flex items-center gap-2 group flex-shrink-0" aria-label="RJMBook Home">
        <!-- Logo image -->
        <div class="w-10 h-10 rounded-xl overflow-hidden flex-shrink-0 transition-transform duration-300 group-hover:scale-105"
             style="box-shadow: 0 2px 10px rgba(0,0,0,.2);">
          <img src="/rjmlogo.jpg" alt="RJM Beach Resort Logo"
               class="w-full h-full object-cover object-center" />
        </div>
        <!-- Wordmark -->
        <div class="flex flex-col justify-center gap-0">
          <span class="font-bold text-white tracking-wide group-hover:opacity-90 transition-opacity"
                style="font-family:'Inter',sans-serif; font-size:1.05rem; line-height:1;">RJMBook</span>
          <span class="font-semibold tracking-[.14em] uppercase"
                style="font-family:'Inter',sans-serif; font-size:.6rem; line-height:1; margin-top:1px; color:rgba(255,255,255,.5);">RJM Beach Resort</span>
        </div>
      </a>

      <!-- ── Desktop Nav Links ── -->
      <div class="hidden md:flex items-center gap-0.5">
        {{#if (eq sessionRole "admin")}}
          <a href="/admin"              class="nav-link {{#if (eq currentPage 'admin')}}active{{/if}}"><i class="fa-solid fa-gauge-high text-[11px]"></i> Dashboard</a>
          <a href="/dashboard"          class="nav-link {{#if (eq currentPage 'analytics')}}active{{/if}}"><i class="fa-solid fa-chart-line text-[11px]"></i> Analytics</a>
          <a href="/admin/rooms"        class="nav-link {{#if (eq currentPage 'admin-rooms')}}active{{/if}}"><i class="fa-solid fa-bed text-[11px]"></i> Rooms</a>
          <a href="/admin/cottages"     class="nav-link {{#if (eq currentPage 'admin-cottages')}}active{{/if}}"><i class="fa-solid fa-umbrella-beach text-[11px]"></i> Cottages</a>
          <a href="/admin/reservations" class="nav-link {{#if (eq currentPage 'admin-reservations')}}active{{/if}}"><i class="fa-solid fa-calendar-days text-[11px]"></i> Reservations</a>
          <a href="/guests"             class="nav-link {{#if (eq currentPage 'guests')}}active{{/if}}"><i class="fa-solid fa-users text-[11px]"></i> Guests</a>
        {{else}}
          <a href="/"         class="nav-link {{#if (eq currentPage 'home')}}active{{/if}}"><i class="fa-solid fa-house text-[11px]"></i> Home</a>
          <a href="/rooms"    class="nav-link {{#if (eq currentPage 'rooms')}}active{{/if}}"><i class="fa-solid fa-bed text-[11px]"></i> Rooms</a>
          <a href="/cottages" class="nav-link {{#if (eq currentPage 'cottages')}}active{{/if}}"><i class="fa-solid fa-umbrella-beach text-[11px]"></i> Cottages</a>
          <a href="/#about"   class="nav-link"><i class="fa-solid fa-circle-info text-[11px]"></i> About</a>
        {{/if}}
      </div>

      <!-- ── Right: Auth + Mobile Toggle ── -->
      <div class="flex items-center gap-2">

        {{#if sessionUserId}}
          <!-- Book Now pill (guest only) -->
          {{#unless (eq sessionRole "admin")}}
          {{#unless (eq sessionRole "staff")}}
          <a href="/bookings/book"
             class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-semibold text-white transition-all duration-300"
             style="background: linear-gradient(135deg,#d97706,#f59e0b); box-shadow: 0 3px 12px rgba(217,119,6,.45);"
             onmouseover="this.style.transform='translateY(-1px)'; this.style.boxShadow='0 6px 18px rgba(217,119,6,.55)'"
             onmouseout="this.style.transform=''; this.style.boxShadow='0 3px 12px rgba(217,119,6,.45)'">
            <i class="fa-solid fa-calendar-plus text-[11px]"></i> Book Now
          </a>
          {{/unless}}
          {{/unless}}

          <!-- User dropdown -->
          <div class="relative" id="user-dropdown-wrapper">
            <button id="user-dropdown-btn"
                    class="flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium text-white transition-all duration-200"
                    style="background: rgba(255,255,255,.14); border: 1.5px solid rgba(255,255,255,.22);"
                    onmouseover="this.style.background='rgba(255,255,255,.24)'; this.style.borderColor='rgba(255,255,255,.38)'"
                    onmouseout="this.style.background='rgba(255,255,255,.14)'; this.style.borderColor='rgba(255,255,255,.22)'"
                    aria-haspopup="true" aria-expanded="false">
              <!-- Avatar -->
              <div class="relative w-7 h-7 flex-shrink-0">
                <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold text-white"
                     style="background: linear-gradient(135deg,rgba(255,255,255,.28),rgba(255,255,255,.12));">
                  {{#if sessionUserName}}{{sessionUserName.[0]}}{{else}}<i class="fa-solid fa-user text-xs"></i>{{/if}}
                </div>
                {{#if hasBookingUpdates}}
                <span class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 bg-red-500 rounded-full border-2 border-teal-700 block"></span>
                {{/if}}
              </div>
              <span class="hidden sm:inline max-w-[100px] truncate text-sm">{{sessionUserName}}</span>
              <i class="fa-solid fa-chevron-down text-[10px] opacity-55 transition-transform duration-200" id="dropdown-chevron"></i>
            </button>

            <!-- Dropdown panel -->
            <div id="user-dropdown-menu"
                 class="absolute right-0 mt-2.5 w-58 rounded-2xl shadow-2xl overflow-hidden hidden"
                 style="background:#fff; border: 1px solid rgba(226,232,240,.9); z-index:200; min-width:230px;
                        box-shadow: 0 20px 60px rgba(0,0,0,.16), 0 4px 14px rgba(0,0,0,.08);">
              <!-- Header -->
              <div class="px-4 py-3.5"
                   style="background: linear-gradient(135deg,#f0fdfa,#ecfeff); border-bottom: 1px solid rgba(153,246,228,.35);">
                <p class="text-[11px] text-gray-400 font-semibold uppercase tracking-widest flex items-center gap-1.5 mb-1">
                  <i class="fa-solid fa-circle-user text-teal-500"></i> Signed in as
                </p>
                <p class="text-sm font-bold text-gray-800 truncate">{{sessionUserName}}</p>
              </div>

              <div class="py-1.5">
                {{#unless (eq sessionRole "admin")}}
                <a href="/bookings/reservations"
                   class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-teal-50 hover:text-teal-700 transition-colors">
                  <span class="w-7 h-7 rounded-lg flex items-center justify-center flex-shrink-0 bg-teal-50">
                    <i class="fa-regular fa-calendar text-teal-600 text-xs"></i>
                  </span>
                  <span class="flex-1 font-medium">My Reservations</span>
                  {{#if hasBookingUpdates}}<span class="w-2 h-2 bg-red-500 rounded-full flex-shrink-0"></span>{{/if}}
                </a>
                {{/unless}}

                <a href="/account"
                   class="flex items-center gap-3 px-4 py-2.5 text-sm text-gray-700 hover:bg-teal-50 hover:text-teal-700 transition-colors">
                  <span class="w-7 h-7 rounded-lg flex items-center justify-center flex-shrink-0 bg-teal-50">
                    <i class="fa-solid fa-user-gear text-teal-600 text-xs"></i>
                  </span>
                  <span class="font-medium">Account Settings</span>
                </a>
              </div>

              <div class="border-t border-gray-100 mx-3 my-1"></div>

              <div class="pb-1.5">
                <button id="logout-btn"
                        class="w-full flex items-center gap-3 px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 transition-colors">
                  <span class="w-7 h-7 rounded-lg flex items-center justify-center flex-shrink-0 bg-red-50">
                    <i class="fa-solid fa-right-from-bracket text-red-500 text-xs"></i>
                  </span>
                  <span class="font-medium">Sign Out</span>
                </button>
              </div>
            </div>
          </div>

        {{else}}
          <a href="/login"
             class="hidden sm:inline-flex items-center gap-1.5 px-5 py-2 rounded-full text-sm font-semibold bg-white text-teal-700 hover:bg-teal-50 transition-all duration-200 shadow-md hover:shadow-lg"
             style="border: 1px solid rgba(255,255,255,.7);">
            <i class="fa-solid fa-right-to-bracket text-xs"></i> Sign In
          </a>
        {{/if}}

        <!-- Mobile hamburger -->
        <button id="mobile-menu-btn"
                class="md:hidden p-2 rounded-lg text-white hover:bg-white/10 transition-colors"
                aria-label="Toggle menu" aria-expanded="false">
          <i id="hamburger-icon" class="fa-solid fa-bars w-5 h-5 block text-base"></i>
          <i id="close-icon" class="fa-solid fa-xmark w-5 h-5 hidden text-base"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- ── Mobile Menu ── -->
  <div id="mobile-menu"
       class="hidden md:hidden border-t"
       style="background: rgba(10,95,84,.97); backdrop-filter: blur(18px); border-color: rgba(255,255,255,.08);">
    <div class="px-4 py-4 space-y-1">
      {{#if (eq sessionRole "admin")}}
        <a href="/admin"              class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-white/90 hover:bg-white/10 text-sm font-medium transition-colors {{#if (eq currentPage 'admin')}}bg-white/15 font-semibold text-white{{/if}}"><i class="fa-solid fa-gauge-high w-4 text-center text-teal-300 text-[11px]"></i> Dashboard</a>
        <a href="/dashboard"          class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-white/90 hover:bg-white/10 text-sm font-medium transition-colors {{#if (eq currentPage 'analytics')}}bg-white/15 font-semibold text-white{{/if}}"><i class="fa-solid fa-chart-line w-4 text-center text-teal-300 text-[11px]"></i> Analytics</a>
        <a href="/admin/rooms"        class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-white/90 hover:bg-white/10 text-sm font-medium transition-colors {{#if (eq currentPage 'admin-rooms')}}bg-white/15 font-semibold text-white{{/if}}"><i class="fa-solid fa-bed w-4 text-center text-teal-300 text-[11px]"></i> Rooms</a>
        <a href="/admin/cottages"     class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-white/90 hover:bg-white/10 text-sm font-medium transition-colors {{#if (eq currentPage 'admin-cottages')}}bg-white/15 font-semibold text-white{{/if}}"><i class="fa-solid fa-umbrella-beach w-4 text-center text-teal-300 text-[11px]"></i> Cottages</a>
        <a href="/admin/reservations" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-white/90 hover:bg-white/10 text-sm font-medium transition-colors {{#if (eq currentPage 'admin-reservations')}}bg-white/15 font-semibold text-white{{/if}}"><i class="fa-solid fa-calendar-days w-4 text-center text-teal-300 text-[11px]"></i> Reservations</a>
        <a href="/guests"             class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-white/90 hover:bg-white/10 text-sm font-medium transition-colors {{#if (eq currentPage 'guests')}}bg-white/15 font-semibold text-white{{/if}}"><i class="fa-solid fa-users w-4 text-center text-teal-300 text-[11px]"></i> Guests</a>
      {{else}}
        <a href="/"         class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-white/90 hover:bg-white/10 text-sm font-medium transition-colors {{#if (eq currentPage 'home')}}bg-white/15 font-semibold text-white{{/if}}"><i class="fa-solid fa-house w-4 text-center text-teal-300 text-[11px]"></i> Home</a>
        <a href="/rooms"    class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-white/90 hover:bg-white/10 text-sm font-medium transition-colors {{#if (eq currentPage 'rooms')}}bg-white/15 font-semibold text-white{{/if}}"><i class="fa-solid fa-bed w-4 text-center text-teal-300 text-[11px]"></i> Rooms</a>
        <a href="/cottages" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-white/90 hover:bg-white/10 text-sm font-medium transition-colors {{#if (eq currentPage 'cottages')}}bg-white/15 font-semibold text-white{{/if}}"><i class="fa-solid fa-umbrella-beach w-4 text-center text-teal-300 text-[11px]"></i> Cottages</a>
        <a href="/#about"   class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-white/90 hover:bg-white/10 text-sm font-medium transition-colors"><i class="fa-solid fa-circle-info w-4 text-center text-teal-300 text-[11px]"></i> About</a>

        {{#if sessionUserId}}
        <div class="border-t border-white/8 pt-3 mt-2 space-y-1">
          <a href="/bookings/reservations"
             class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-white/90 hover:bg-white/10 text-sm font-medium transition-colors {{#if (eq currentPage 'bookings')}}bg-white/15 font-semibold text-white{{/if}}">
            <i class="fa-regular fa-calendar w-4 text-center text-teal-300 text-[11px]"></i>
            <span class="flex-1">My Reservations</span>
            {{#if hasBookingUpdates}}<span class="w-2 h-2 bg-red-400 rounded-full"></span>{{/if}}
          </a>
          <a href="/bookings/book"
             class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-white font-semibold text-sm"
             style="background: linear-gradient(135deg,#d97706,#f59e0b);">
            <i class="fa-solid fa-calendar-plus w-4 text-center text-[11px]"></i> Book Now
          </a>
          <a href="/account" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-white/90 hover:bg-white/10 text-sm font-medium transition-colors">
            <i class="fa-solid fa-user-gear w-4 text-center text-teal-300 text-[11px]"></i> Account Settings
          </a>
        </div>
        {{/if}}
      {{/if}}

      {{#unless sessionUserId}}
      <div class="pt-3 border-t border-white/8">
        <a href="/login"
           class="flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-white text-teal-700 font-semibold text-sm shadow-sm">
          <i class="fa-solid fa-right-to-bracket"></i> Sign In
        </a>
      </div>
      {{/unless}}
    </div>
  </div>
</nav>

<!-- Spacer for fixed nav -->
<div class="h-[66px]"></div>

<!-- ── Toast container ── -->
<div id="notification"
     class="fixed top-5 right-5 z-[300] flex items-center gap-3 px-5 py-3.5 rounded-2xl shadow-xl text-white text-sm font-medium pointer-events-none opacity-0 transition-all duration-300"
     style="background: linear-gradient(135deg,#0d9488,#0891b2); min-width:240px; transform: translateY(-8px);">
  <i class="fa-solid fa-circle-check text-base"></i>
  <span id="notification-message">Done</span>
</div>

<script>
(function () {
  // ── Mobile menu toggle ──
  const mobileBtn  = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamIcon    = document.getElementById('hamburger-icon');
  const closeIcon  = document.getElementById('close-icon');

  if (mobileBtn) {
    mobileBtn.addEventListener('click', () => {
      const open = !mobileMenu.classList.contains('hidden');
      mobileMenu.classList.toggle('hidden', open);
      hamIcon.classList.toggle('hidden', !open);
      closeIcon.classList.toggle('hidden', open);
      mobileBtn.setAttribute('aria-expanded', String(!open));
    });
  }

  // ── User dropdown ──
  const dropBtn  = document.getElementById('user-dropdown-btn');
  const dropMenu = document.getElementById('user-dropdown-menu');
  const chevron  = document.getElementById('dropdown-chevron');

  if (dropBtn && dropMenu) {
    dropBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = !dropMenu.classList.contains('hidden');
      dropMenu.classList.toggle('hidden');
      if (chevron) chevron.style.transform = open ? '' : 'rotate(180deg)';
      dropBtn.setAttribute('aria-expanded', String(!open));
    });
    document.addEventListener('click', () => {
      dropMenu.classList.add('hidden');
      if (chevron) chevron.style.transform = '';
      if (dropBtn) dropBtn.setAttribute('aria-expanded', 'false');
    });
    dropMenu.addEventListener('click', (e) => e.stopPropagation());
  }

  // ── Scroll: glass nav on scroll ──
  const nav = document.getElementById('main-nav');
  let ticking = false;

  function updateNav() {
    if (!nav) return;
    const scrolled = window.scrollY > 18;
    if (scrolled) {
      nav.style.background = 'rgba(10,84,75,.94)';
      nav.style.backdropFilter = 'blur(20px) saturate(180%)';
      nav.style.webkitBackdropFilter = 'blur(20px) saturate(180%)';
      nav.style.boxShadow = '0 4px 32px rgba(0,0,0,.28), 0 1px 0 rgba(255,255,255,.06)';
    } else {
      nav.style.background = 'linear-gradient(135deg,#0f766e 0%,#0d9488 55%,#0891b2 100%)';
      nav.style.backdropFilter = '';
      nav.style.webkitBackdropFilter = '';
      nav.style.boxShadow = '0 2px 20px rgba(0,0,0,.15)';
    }
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) { requestAnimationFrame(updateNav); ticking = true; }
  }, { passive: true });

  // ── Toast helper (legacy compat) ──
  window.showNotification = function (message = 'Done', duration = 2500) {
    const el  = document.getElementById('notification');
    const msg = document.getElementById('notification-message');
    msg.textContent = message;
    el.style.opacity = '1';
    el.style.transform = 'translateY(0)';
    el.style.pointerEvents = 'auto';
    return new Promise(resolve => {
      setTimeout(() => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(-8px)';
        el.style.pointerEvents = 'none';
        resolve();
      }, duration);
    });
  };

  // ── Logout ──
  const logoutBtn = document.getElementById('logout-btn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', async (e) => {
      e.preventDefault();
      showLogoutConfirmation(async () => {
        try {
          const res  = await fetch('/logout', { method: 'GET' });
          const data = await res.json();
          if (data.success && data.redirect) {
            await showNotification('Signed out successfully', 1500);
            window.location.href = data.redirect;
          }
        } catch {
          window.location.href = '/';
        }
      });
    });
  }

  // Wire admin logout buttons
  document.addEventListener('DOMContentLoaded', function () {
    ['adminLogoutBtn','admin-logout-btn'].forEach(function (id) {
      var btn = document.getElementById(id);
      if (btn) btn.addEventListener('click', window.confirmAdminLogout);
    });
  });
})();
</script>
