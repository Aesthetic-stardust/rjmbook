        <ul class="space-y-2.5">
          <li><a href="/"              class="footer-link group flex items-center gap-1.5 text-sm text-gray-400 hover:text-teal-400 transition-colors"><i class="fa-solid fa-chevron-right text-[9px] text-teal-800 group-hover:text-teal-400 transition-colors"></i> Home</a></li>
          <li><a href="/rooms"         class="footer-link group flex items-center gap-1.5 text-sm text-gray-400 hover:text-teal-400 transition-colors"><i class="fa-solid fa-chevron-right text-[9px] text-teal-800 group-hover:text-teal-400 transition-colors"></i> Rooms</a></li>
          <li><a href="/cottages"      class="footer-link group flex items-center gap-1.5 text-sm text-gray-400 hover:text-teal-400 transition-colors"><i class="fa-solid fa-chevron-right text-[9px] text-teal-800 group-hover:text-teal-400 transition-colors"></i> Cottages</a></li>
          <li><a href="/bookings/book" class="footer-link group flex items-center gap-1.5 text-sm text-gray-400 hover:text-teal-400 transition-colors"><i class="fa-solid fa-chevron-right text-[9px] text-teal-800 group-hover:text-teal-400 transition-colors"></i> Book Now</a></li>
          <li><a href="/#about"        class="footer-link group flex items-center gap-1.5 text-sm text-gray-400 hover:text-teal-400 transition-colors"><i class="fa-solid fa-chevron-right text-[9px] text-teal-800 group-hover:text-teal-400 transition-colors"></i> About Us</a></li>
        </ul>
      </div>

      <!-- Services col -->
      <div class="md:col-span-3">
        <h4 class="text-[.6875rem] font-bold text-white uppercase tracking-[.12em] mb-5 flex items-center gap-2">
          <i class="fa-solid fa-concierge-bell text-teal-600 text-[10px]"></i> Services
        </h4>
        <ul class="space-y-2.5">
          <li class="flex items-center gap-2 text-sm text-gray-400">
            <i class="fa-solid fa-bed text-teal-800 text-[10px] flex-shrink-0"></i> Room Accommodations
          </li>
          <li class="flex items-center gap-2 text-sm text-gray-400">
            <i class="fa-solid fa-umbrella-beach text-teal-800 text-[10px] flex-shrink-0"></i> Cottage Rentals
          </li>
          <li class="flex items-center gap-2 text-sm text-gray-400">
            <i class="fa-solid fa-calendar-star text-teal-800 text-[10px] flex-shrink-0"></i> Event Spaces
          </li>
          <li class="flex items-center gap-2 text-sm text-gray-400">
            <i class="fa-solid fa-water-ladder text-teal-800 text-[10px] flex-shrink-0"></i> Swimming Pool
          </li>
          <li class="flex items-center gap-2 text-sm text-gray-400">
            <i class="fa-solid fa-robot text-teal-800 text-[10px] flex-shrink-0"></i> AI Chatbot Concierge
          </li>
        </ul>
      </div>

      <!-- Hours + Book CTA col -->
      <div class="md:col-span-3">
        <h4 class="text-[.6875rem] font-bold text-white uppercase tracking-[.12em] mb-5 flex items-center gap-2">
          <i class="fa-solid fa-clock text-teal-600 text-[10px]"></i> Hours
        </h4>

        <ul class="space-y-3 mb-6">
          <li class="flex items-start gap-3">
            <span class="w-6 h-6 rounded-md flex items-center justify-center flex-shrink-0 mt-0.5"
                  style="background: rgba(13,148,136,.15);">
              <i class="fa-solid fa-star text-teal-400 text-[10px]"></i>
            </span>
            <div>
