           onmouseout="this.style.boxShadow='0 4px 16px rgba(13,148,136,.3)'; this.style.transform=''">
          <i class="fa-solid fa-calendar-check text-xs"></i> Reserve Your Stay
        </a>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="pt-8 relative" style="border-top: 1px solid rgba(255,255,255,.06);">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-xs text-gray-600 text-center sm:text-left">
          &copy; 2026 <span class="text-gray-400 font-medium">RJMBook</span> — RJM Beach Resort. All rights reserved.
        </p>
        <div class="flex items-center gap-4 text-xs text-gray-600">
          <span class="flex items-center gap-1.5">
            <i class="fa-solid fa-code text-teal-900"></i>
            Built with <span class="text-teal-700 font-semibold mx-1">XianFire</span>
          </span>
          <span class="w-px h-3 bg-white/10"></span>
          <span class="text-gray-600">Mindoro State University</span>
        </div>
      </div>
    </div>
  </div>
</footer>

<!-- ══ Logout Confirmation Modal ══ -->
<div id="logoutConfirmModal"
     class="hidden fixed inset-0 z-[500] flex items-center justify-center p-4"
     style="background: rgba(10,15,30,.72); backdrop-filter: blur(8px);">
  <div class="bg-white rounded-3xl shadow-2xl max-w-sm w-full p-8 animate-fade-in-up"
       style="box-shadow: 0 32px 80px rgba(0,0,0,.24), 0 4px 16px rgba(0,0,0,.1);">
    <div class="flex items-center gap-4 mb-5">
      <div class="w-12 h-12 rounded-2xl flex items-center justify-center flex-shrink-0"
           style="background: linear-gradient(135deg,#fef3c7,#fde68a);">
        <i class="fa-solid fa-right-from-bracket text-amber-600 text-lg"></i>
      </div>
      <div>
        <h3 class="text-lg font-bold text-gray-900">Sign Out?</h3>
        <p class="text-sm text-gray-500 mt-0.5">You'll need to sign in again to access your account.</p>
      </div>
    </div>
    <div class="flex gap-3 mt-6">
      <button id="logoutConfirmNo"
              class="flex-1 px-4 py-2.5 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold text-sm transition-colors">
        <i class="fa-solid fa-xmark mr-1"></i> Cancel
      </button>
      <button id="logoutConfirmYes"
              class="flex-1 px-4 py-2.5 rounded-xl font-semibold text-sm text-white transition-all"
              style="background: linear-gradient(135deg,#dc2626,#ef4444); box-shadow: 0 4px 14px rgba(220,38,38,.28);"
              onmouseover="this.style.boxShadow='0 6px 20px rgba(220,38,38,.42)'"
              onmouseout="this.style.boxShadow='0 4px 14px rgba(220,38,38,.28)'">
        <i class="fa-solid fa-right-from-bracket mr-1"></i> Sign Out
      </button>
    </div>
  </div>
</div>

{{> feedback-widget }}

</body>
</html>

<script>
(function () {
  let _logoutCb = null;

  window.showLogoutConfirmation = function (cb) {
    _logoutCb = cb;
    document.getElementById('logoutConfirmModal').classList.remove('hidden');
  };

  window.confirmAdminLogout = function () {
    showLogoutConfirmation(function () { window.location.href = '/logout'; });
  };

  function closeModal () {
    document.getElementById('logoutConfirmModal').classList.add('hidden');
    _logoutCb = null;
  }

  document.addEventListener('DOMContentLoaded', function () {
    const yes   = document.getElementById('logoutConfirmYes');
    const no    = document.getElementById('logoutConfirmNo');
    const modal = document.getElementById('logoutConfirmModal');
    if (yes)   yes.addEventListener('click',  () => { if (_logoutCb) _logoutCb(); });
    if (no)    no.addEventListener('click',   closeModal);
    if (modal) modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

    ['adminLogoutBtn','admin-logout-btn'].forEach(function (id) {
      var btn = document.getElementById(id);
      if (btn) btn.addEventListener('click', window.confirmAdminLogout);
    });
  });
})();
</script>
