        </a>

        <p class="text-sm text-gray-400 leading-relaxed mb-6 max-w-xs">
          AI-powered resort booking &amp; management for RJM Beach Resort in beautiful Bansud, Oriental Mindoro.
        </p>

        <!-- Contact quick-links -->
        <ul class="space-y-2.5 mb-6">
          <li>
            <a href="tel:+639193789570"
               class="flex items-center gap-2.5 text-sm text-gray-400 hover:text-teal-400 transition-colors group w-fit">
              <span class="w-6 h-6 rounded-md flex items-center justify-center flex-shrink-0 group-hover:bg-teal-900/50 transition-colors"
                    style="background: rgba(13,148,136,.15);">
                <i class="fa-solid fa-phone text-teal-500 text-[10px]"></i>
              </span>
              +63 919 378 9570
            </a>
          </li>
          <li>
            <a href="mailto:rjm.beachresortph@gmail.com"
               class="flex items-center gap-2.5 text-sm text-gray-400 hover:text-teal-400 transition-colors group w-fit">
              <span class="w-6 h-6 rounded-md flex items-center justify-center flex-shrink-0 group-hover:bg-teal-900/50 transition-colors"
                    style="background: rgba(13,148,136,.15);">
                <i class="fa-solid fa-envelope text-teal-500 text-[10px]"></i>
              </span>
              rjm.beachresortph@gmail.com
            </a>
          </li>
          <li>
            <span class="flex items-center gap-2.5 text-sm text-gray-400">
              <span class="w-6 h-6 rounded-md flex items-center justify-center flex-shrink-0"
                    style="background: rgba(13,148,136,.15);">
                <i class="fa-solid fa-location-dot text-teal-500 text-[10px]"></i>
              </span>
              Tambong, Barangay Proper Bansud, Bansud 5210
            </span>
          </li>
        </ul>

        <!-- Social row -->
        <div class="flex gap-2">
          <a href="#" aria-label="Facebook"
             class="w-9 h-9 rounded-xl flex items-center justify-center text-gray-500 hover:text-white transition-all duration-200"
             style="background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.06);"
             onmouseover="this.style.background='rgba(59,130,246,.22)'; this.style.borderColor='rgba(59,130,246,.4)'"
             onmouseout="this.style.background='rgba(255,255,255,.06)'; this.style.borderColor='rgba(255,255,255,.06)'">
            <i class="fa-brands fa-facebook-f text-xs"></i>
          </a>
          <a href="#" aria-label="Instagram"
