# ─── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=production

# ─── Server ─────────────────────────────────────────────────────────────────────
PORT=3000

# ─── Session ────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your_long_random_secret_here

# ─── Database (MySQL) ───────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=narubook
DB_USER=root
DB_PASS=your_db_password_here

# ─── Seed Passwords (used by seed-production.js, not read at runtime) ──────────
# Remove these after the initial seed is complete
ADMIN_SEED_PASSWORD=your_strong_admin_password
STAFF_SEED_PASSWORD=your_strong_staff_password

# ─── Seed Passwords (used by seed-production.js, not read at runtime) ──────────
# Remove these after the initial seed is complete
ADMIN_SEED_PASSWORD=your_strong_admin_password
STAFF_SEED_PASSWORD=your_strong_staff_password

# ─── Maya Payment Gateway ───────────────────────────────────────────────────────
# Live URL:    https://pg.maya.ph/checkout/v1/checkouts
# Sandbox URL: https://pg-sandbox.paymaya.com/checkout/v1/checkouts
MAYA_PUBLIC_KEY=your_maya_public_key
MAYA_SECRET_KEY=your_maya_secret_key
MAYA_API_URL=https://pg-sandbox.paymaya.com/checkout/v1/checkouts

# ─── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/auth/google/callback (dev)
#                          https://yourdomain.com/auth/google/callback (prod)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback


EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# ─── Chatbot AI (Google Gemini) ────────────────────────────────────────────────
# Get an API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest
