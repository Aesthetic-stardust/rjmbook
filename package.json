{
  "name": "RJMBook",
  "version": "1.0.0",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "migrate": "node migrate.js",
    "seed": "node seed.js",
    "seed:production": "node seed-production.js",
    "reset": "node reset-and-seed.js",
    "create:model": "node create.js model",
    "create:controller": "node create.js controller",
    "xianca": "electron .",
    "xian-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "xian-build": "electron-builder",
    "build": "npm run electron-build",
    "dist": "npm run electron-build -- --publish=never"
  },
  "dependencies": {
    "@emailjs/nodejs": "^5.0.2",
    "@tensorflow-models/universal-sentence-encoder": "^1.3.3",
    "@tensorflow/tfjs": "^4.22.0",
    "bcrypt": "^5.1.0",
    "connect-session-sequelize": "^7.1.7",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.17.3",
    "express-validator": "^7.2.1",
    "hbs": "^4.2.0",
    "helmet": "^8.0.0",
    "inquirer": "^9.2.15",
    "multer": "^2.1.1",
    "mysql2": "^3.9.2",
    "node-cron": "^4.6.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.18.0",
    "puppeteer": "^24.42.0",
    "sequelize": "^6.37.3",
    "simple-statistics": "^7.8.8"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.xianfire.app",
    "productName": "RJMBook",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ]
  }
}
